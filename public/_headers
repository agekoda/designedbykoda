# How long browsers may keep the site's files before asking again.
# Without this every file is "ask the server again" on every page, which costs a round trip each,
# and that is slowest on Safari (especially with iCloud Private Relay on).

# Built scripts and styles: their names change whenever they change, so they can be kept for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts for the website
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# The calendar's screen fonts, used by every preview: keep a day, quietly refresh after that
/eink/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Shared scripts and styles without a hash in the name: keep briefly, refresh in the background
/scripts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/styles/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Pictures
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/favicon.ico
  Cache-Control: public, max-age=604800
