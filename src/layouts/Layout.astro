---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackgroundFX from '../components/BackgroundFX.astro';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean; // keep the page out of search engines (private pages such as message links)
	previews?: boolean; // the page draws screen previews: start fetching the screen fonts straight away
	bodyClass?: string; // a page-wide look, e.g. 'paper-theme' on /e-ink
}

const { title, description, image, noindex, bodyClass, previews } = Astro.props;

// Project list for the command palette (title + url), ordered like the site.
const paletteProjects = (await getCollection('projects'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((p) => [p.data.title, `/projects/${p.id}/`]);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<link rel="stylesheet" href="/styles/extras.css" />
		<script is:inline>/* ?timing on any page: a readout of what it waited on (scripts/timing.js) */ if (/[?&]timing\b/.test(location.search)) { var t = document.createElement('script'); t.src = '/scripts/timing.js'; t.defer = true; document.head.appendChild(t); }</script>
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{previews && <link rel="preload" href="/eink/fonts.json" as="fetch" crossorigin="anonymous" />}
	</head>
	<body class={bodyClass}>
		<a class="x-skip" href="#main">Skip to content</a>
		<BackgroundFX />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script type="application/json" id="x-projects" set:html={JSON.stringify(paletteProjects)} />
		<script src="/scripts/interactions.js" defer is:inline></script>
		<script src="/scripts/extras.js" defer is:inline></script>
	</body>
</html>
