---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackgroundFX from '../components/BackgroundFX.astro';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;

// Project list for the command palette (title + url), ordered like the site.
const paletteProjects = (await getCollection('projects'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((p) => [p.data.title, `/projects/${p.id}/`]);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<link rel="stylesheet" href="/styles/extras.css" />
	</head>
	<body>
		<a class="x-skip" href="#main">Skip to content</a>
		<BackgroundFX />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script type="application/json" id="x-projects" set:html={JSON.stringify(paletteProjects)} />
		<script src="/scripts/interactions.js" defer is:inline></script>
		<script src="/scripts/extras.js" defer is:inline></script>
	</body>
</html>
