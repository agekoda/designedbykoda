---
import Layout from './Layout.astro';
import ProjectImage from '../components/ProjectImage.astro';
import ProjectModel from '../components/ProjectModel.astro';

interface Props {
	title: string;
	tagline: string;
	description: string;
	category: string;
	status: 'Complete' | 'Upcoming';
	heroImage?: string;
	model?: string;
	cameraOrbit?: string;
	gallery?: string[];
	galleryRatio?: string;
}

const {
	title,
	tagline,
	description,
	category,
	status,
	heroImage,
	model,
	cameraOrbit,
	gallery = [],
	galleryRatio = '4 / 3',
} = Astro.props;
---

<Layout title={`${title} — designedbykoda`} description={description} image={heroImage}>
	<a class="back" href="/projects">&larr; All projects</a>

	<div class="project-header">
		<div class="tags">
			<span class="tag">{category}</span>
			{status === 'Upcoming' && <span class="tag status-upcoming">Upcoming</span>}
		</div>
		<h1>{title}</h1>
		<p class="tagline">{tagline}</p>
	</div>

	<div class="hero-row">
		{
			model && (
				<div class="hero-row-model">
					<ProjectModel src={model} alt={title} cameraOrbit={cameraOrbit} />
				</div>
			)
		}
		<ProjectImage src={heroImage} alt={title} ratio="16 / 9" />
	</div>

	<article class="prose">
		<slot />
	</article>

	{
		gallery.length > 0 && (
			<div class="gallery">
				{gallery.map((src) => (
					<ProjectImage
						src={src}
						alt={`${title} photo`}
						ratio={galleryRatio}
						label="Photo coming soon"
					/>
				))}
			</div>
		)
	}
</Layout>

<style>
	.back {
		display: inline-block;
		color: var(--muted);
		font-size: 0.9em;
		margin-bottom: 1.5em;
	}
	.back:hover {
		color: var(--fg);
	}
	.project-header {
		margin-bottom: 1.5em;
	}
	.tags {
		display: flex;
		gap: 0.5em;
		margin-bottom: 0.8em;
	}
	.tagline {
		color: var(--muted);
		font-size: 1.15em;
		margin-top: 0.3em;
	}
	.prose {
		margin-top: 2em;
	}
	.prose :global(h2) {
		margin-top: 1.8em;
		font-size: 1.3em;
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.gallery {
		margin-top: 2.5em;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1em;
	}

	/* ---------- Hero + 3D model ---------- */
	/* The hero image is completely untouched — full column width, natural
	   16:9 shape, same as every other project. The 3D model (when present)
	   floats as an extra square box in the left margin/gutter next to it,
	   sized to match the hero's rendered height, bleeding toward the
	   screen edge on that side only. Below ~1100px there usually isn't
	   enough gutter space for this to look right, so it stacks above the
	   hero instead. */
	.hero-row {
		position: relative;
	}
	.hero-row-model {
		position: absolute;
		top: 0;
		bottom: 0;
		right: calc(100% + 1em);
		aspect-ratio: 1 / 1;
	}
	.hero-row-model :global(.model-slot) {
		width: auto;
		height: 100%;
		max-width: none;
		margin: 0;
		aspect-ratio: 1 / 1;
	}
	@media (max-width: 1100px) {
		.hero-row-model {
			position: static;
			width: 100%;
			aspect-ratio: 1 / 1;
			margin-bottom: 1em;
		}
		.hero-row-model :global(.model-slot) {
			width: 100%;
			height: auto;
		}
	}
</style>