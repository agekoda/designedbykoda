---
import Layout from './Layout.astro';
import ProjectImage from '../components/ProjectImage.astro';
import ProjectModel from '../components/ProjectModel.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { getCollection } from 'astro:content';

interface Props {
	slug: string;
	title: string;
	tagline: string;
	description: string;
	category: string;
	status: 'Complete' | 'Upcoming';
	heroImage?: string;
	model?: string;
	cameraOrbit?: string;
	rotationSpeed?: string;
	modelCaption?: string;
	model2?: string;
	cameraOrbit2?: string;
	rotationSpeed2?: string;
	model2Caption?: string;
	gallery?: string[];
	galleryRatio?: string;
	waitlist?: boolean;
	waitlistLabel?: string;
}

const {
	slug,
	title,
	tagline,
	description,
	category,
	status,
	heroImage,
	model,
	cameraOrbit,
	rotationSpeed,
	modelCaption,
	model2,
	cameraOrbit2,
	rotationSpeed2,
	model2Caption,
	gallery = [],
	galleryRatio = '4 / 3',
	waitlist = false,
	waitlistLabel,
} = Astro.props;

// Previous / next project (wraps around) for the footer navigation.
const ordered = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const at = ordered.findIndex((p) => p.id === slug);
const prev = at >= 0 ? ordered[(at - 1 + ordered.length) % ordered.length] : null;
const next = at >= 0 ? ordered[(at + 1) % ordered.length] : null;
---

<Layout title={`${title} — designedbykoda`} description={description} image={`/og/${slug}.png`}>
	<div class="top-row">
		<a class="back" href="/projects">&larr; All projects</a>
		<button
			type="button"
			class="share-btn"
			data-title={`${title} — designedbykoda`}
			data-text={tagline}
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
				<path d="M16 6l-4-4-4 4" />
				<path d="M12 2v13" />
			</svg>
			<span class="share-label">Share</span>
		</button>
	</div>

	<div class="project-header">
		<div class="tags">
			<span class="tag">{category}</span>
			{status === 'Upcoming' && <span class="tag status-upcoming">Upcoming</span>}
		</div>
		<h1>{title}</h1>
		<p class="tagline">{tagline}</p>
	</div>

	{waitlist && <WaitlistForm label={waitlistLabel} listKey={slug} />}

	<div class="hero-row">
		{
			model && (
				<div class="hero-row-model hero-row-model-left">
					<div class="hero-row-model-box">
						<ProjectModel
							src={model}
							alt={title}
							cameraOrbit={cameraOrbit}
							rotationSpeed={rotationSpeed}
						/>
					</div>
					{modelCaption && <p class="hero-row-model-caption">{modelCaption}</p>}
				</div>
			)
		}
		<ProjectImage src={heroImage} alt={title} ratio="16 / 9" />
		{
			model2 && (
				<div class="hero-row-model hero-row-model-right">
					<div class="hero-row-model-box">
						<ProjectModel
							src={model2}
							alt={title}
							cameraOrbit={cameraOrbit2}
							rotationSpeed={rotationSpeed2}
						/>
					</div>
					{model2Caption && <p class="hero-row-model-caption">{model2Caption}</p>}
				</div>
			)
		}
	</div>

	<article class="prose">
		<slot />
	</article>

	{
		gallery.length > 0 && (
			<div class="gallery">
				{gallery.map((src) => (
					<ProjectImage
						src={src}
						alt={`${title} photo`}
						ratio={galleryRatio}
						label="Photo coming soon"
					/>
				))}
			</div>
		)
	}

	{
		prev && next && prev.id !== slug && (
			<nav class="pn" aria-label="More projects">
				<a class="pn-a card" href={`/projects/${prev.id}/`}>
					<span class="pn-dir">&larr; Previous project</span>
					<strong>{prev.data.title}</strong>
					<span class="pn-tag">{prev.data.tagline}</span>
				</a>
				<a class="pn-a pn-next card" href={`/projects/${next.id}/`}>
					<span class="pn-dir">Next project &rarr;</span>
					<strong>{next.data.title}</strong>
					<span class="pn-tag">{next.data.tagline}</span>
				</a>
			</nav>
		)
	}
</Layout>

<script>
	// Share: use the phone/OS share sheet where there is one, otherwise copy
	// the link and say so on the button.
	document.querySelectorAll<HTMLButtonElement>('.share-btn').forEach((btn) => {
		const label = btn.querySelector<HTMLElement>('.share-label')!;
		let timer: number | undefined;
		const flash = (text: string) => {
			label.textContent = text;
			btn.classList.add('done');
			clearTimeout(timer);
			timer = window.setTimeout(() => {
				label.textContent = 'Share';
				btn.classList.remove('done');
			}, 2000);
		};
		btn.addEventListener('click', async () => {
			const url = window.location.href.split('#')[0];
			if (navigator.share) {
				try {
					await navigator.share({ title: btn.dataset.title, text: btn.dataset.text, url });
					return;
				} catch (err) {
					if ((err as Error).name === 'AbortError') return;
				}
			}
			try {
				await navigator.clipboard.writeText(url);
				flash('Link copied');
			} catch {
				window.prompt('Copy this link:', url);
			}
		});
	});
</script>

<style>
	.top-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
	}
	.share-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding: 0.4em 0.9em;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
		color: var(--muted);
		font: inherit;
		font-size: 0.85em;
		font-weight: 600;
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.share-btn svg {
		width: 1.1em;
		height: 1.1em;
	}
	.share-btn:hover,
	.share-btn:focus-visible {
		color: var(--fg);
		border-color: var(--accent-dark);
	}
	.share-btn.done {
		color: var(--accent);
		border-color: var(--accent);
	}

	.pn {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1em;
		margin-top: 3.5em;
		padding-top: 2em;
		border-top: 1px solid var(--border);
	}
	.pn-a {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		padding: 1.1em 1.3em;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--bg-raised);
		transition: border-color 0.2s ease;
	}
	.pn-a:hover {
		border-color: var(--accent-dark);
	}
	.pn-next {
		text-align: right;
	}
	.pn-dir {
		font-size: 0.75em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-dim);
	}
	.pn-a strong {
		color: var(--fg);
		font-size: 1.1em;
	}
	.pn-tag {
		color: var(--muted);
		font-size: 0.85em;
		line-height: 1.4;
	}
	@media (max-width: 560px) {
		.pn {
			grid-template-columns: 1fr;
		}
		.pn-next {
			text-align: left;
		}
	}
	.back {
		display: inline-block;
		color: var(--muted);
		font-size: 0.9em;
		margin-bottom: 1.5em;
	}
	.back:hover {
		color: var(--fg);
	}
	.project-header {
		margin-bottom: 1.5em;
	}
	.tags {
		display: flex;
		gap: 0.5em;
		margin-bottom: 0.8em;
	}
	.tagline {
		color: var(--muted);
		font-size: 1.15em;
		margin-top: 0.3em;
	}
	.prose {
		margin-top: 2em;
	}
	.prose :global(h2) {
		margin-top: 1.8em;
		font-size: 1.3em;
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.gallery {
		margin-top: 2.5em;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1em;
	}

	/* ---------- Hero + 3D model(s) ---------- */
	/* The hero photo is completely untouched — same fixed column width,
	   same natural 16:9 shape, whether a model is present or not. Models
	   (up to one on each side) are purely decorative extras, positioned
	   with position:absolute anchored to the hero's own box, extending
	   out into the page margin — they never affect the hero's own size
	   or position in any way.
	   Below MODEL_BREAKPOINT there usually isn't enough margin space for
	   this to look right (or not clip), so models stack above/below the
	   hero instead — verified against real rendered widths, not guessed. */
	.hero-row {
		position: relative;
	}
	.hero-row-model {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		max-width: 480px;
		display: flex;
		flex-direction: column;
		gap: 0.6em;
	}
	.hero-row-model-left {
		right: calc(100% + 1em);
		/* Pulls the left edge out to the true viewport edge — same trick
		   as the full-bleed hero row used elsewhere. The +12px nudge is a
		   safety margin: the vw-based math can land a couple of pixels
		   into negative territory depending on the browser's actual
		   scrollbar width, which barely matters for the model itself but
		   was clipping the first pixel or two of left-aligned caption
		   text. Combined with the right anchor above and no explicit
		   width, the browser still sizes this box to fill essentially the
		   entire gap, just with a small buffer against that edge case. */
		left: calc(-50vw + 50% + 12px);
	}
	.hero-row-model-right {
		left: calc(100% + 1em);
		right: calc(-50vw + 50% + 12px);
	}
	.hero-row-model-box {
		width: 100%;
		aspect-ratio: 1 / 1;
	}
	.hero-row-model-box :global(.model-slot) {
		width: 100%;
		height: 100%;
		max-width: none;
		margin: 0;
		aspect-ratio: unset;
	}
	.hero-row-model-caption {
		margin: 0;
		font-size: 0.85em;
		color: var(--muted);
	}
	.hero-row-model-left .hero-row-model-caption {
		text-align: left;
		margin-left: 1.2em;
	}
	.hero-row-model-right .hero-row-model-caption {
		text-align: right;
	}
	@media (max-width: 1500px) {
		.hero-row {
			display: flex;
			flex-direction: column;
			gap: 1em;
		}
		.hero-row-model {
			position: static;
			top: auto;
			transform: none;
			width: 100%;
			max-width: 400px;
			margin: 0 auto;
		}
		.hero-row-model-box {
			width: 100%;
		}
		.hero-row-model-box :global(.model-slot) {
			width: 100%;
			height: auto;
			aspect-ratio: 1 / 1;
		}
		.hero-row-model-left {
			order: -1;
		}
	}
</style>