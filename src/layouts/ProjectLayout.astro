---
import Layout from './Layout.astro';
import ProjectImage from '../components/ProjectImage.astro';
import ProjectModel from '../components/ProjectModel.astro';

interface Props {
	title: string;
	tagline: string;
	description: string;
	category: string;
	status: 'Complete' | 'Upcoming';
	heroImage?: string;
	model?: string;
	cameraOrbit?: string;
	gallery?: string[];
	galleryRatio?: string;
}

const {
	title,
	tagline,
	description,
	category,
	status,
	heroImage,
	model,
	cameraOrbit,
	gallery = [],
	galleryRatio = '4 / 3',
} = Astro.props;
---

<Layout title={`${title} — designedbykoda`} description={description} image={heroImage}>
	<a class="back" href="/projects">&larr; All projects</a>

	<div class="project-header">
		<div class="tags">
			<span class="tag">{category}</span>
			{status === 'Upcoming' && <span class="tag status-upcoming">Upcoming</span>}
		</div>
		<h1>{title}</h1>
		<p class="tagline">{tagline}</p>
	</div>

	<div class="hero-row">
		{
			model && (
				<div class="hero-row-model">
					<ProjectModel src={model} alt={title} cameraOrbit={cameraOrbit} />
				</div>
			)
		}
		<ProjectImage src={heroImage} alt={title} ratio="16 / 9" />
	</div>

	<article class="prose">
		<slot />
	</article>

	{
		gallery.length > 0 && (
			<div class="gallery">
				{gallery.map((src) => (
					<ProjectImage
						src={src}
						alt={`${title} photo`}
						ratio={galleryRatio}
						label="Photo coming soon"
					/>
				))}
			</div>
		)
	}
</Layout>

<style>
	.back {
		display: inline-block;
		color: var(--muted);
		font-size: 0.9em;
		margin-bottom: 1.5em;
	}
	.back:hover {
		color: var(--fg);
	}
	.project-header {
		margin-bottom: 1.5em;
	}
	.tags {
		display: flex;
		gap: 0.5em;
		margin-bottom: 0.8em;
	}
	.tagline {
		color: var(--muted);
		font-size: 1.15em;
		margin-top: 0.3em;
	}
	.prose {
		margin-top: 2em;
	}
	.prose :global(h2) {
		margin-top: 1.8em;
		font-size: 1.3em;
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.gallery {
		margin-top: 2.5em;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1em;
	}

	/* ---------- Hero + 3D model ---------- */
	/* Model sits inside the normal content column, directly beside the hero
	   photo — not floated into the outer page margin. That margin-based
	   approach looked fine on a wide monitor but broke (clipped/pushed
	   off-screen) on narrower laptop screens, since it depended on how much
	   space happened to exist outside the centered column. Keeping both
	   elements in normal flex flow means the layout is identical on every
	   screen size — the model just scales down proportionally along with
	   the hero on a narrower screen, rather than ever clipping. */
	.hero-row {
		display: flex;
		align-items: stretch;
		gap: 1em;
	}
	.hero-row-model {
		flex: 0 0 auto;
	}
	.hero-row-model :global(.model-slot) {
		width: auto;
		height: 100%;
		max-width: none;
		margin: 0;
		aspect-ratio: 1 / 1;
	}
	.hero-row-image {
		flex: 1 1 auto;
		min-width: 0;
	}
	@media (max-width: 640px) {
		.hero-row {
			flex-direction: column;
		}
		.hero-row-model {
			width: 100%;
		}
		.hero-row-model :global(.model-slot) {
			width: 100%;
			height: auto;
		}
	}
</style>
