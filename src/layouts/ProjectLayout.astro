---
import Layout from './Layout.astro';
import ProjectImage from '../components/ProjectImage.astro';
import ProjectModel from '../components/ProjectModel.astro';

interface Props {
	title: string;
	tagline: string;
	description: string;
	category: string;
	status: 'Complete' | 'Upcoming';
	heroImage?: string;
	model?: string;
	cameraOrbit?: string;
	gallery?: string[];
	galleryRatio?: string;
}

const {
	title,
	tagline,
	description,
	category,
	status,
	heroImage,
	model,
	cameraOrbit,
	gallery = [],
	galleryRatio = '4 / 3',
} = Astro.props;
---

<Layout title={`${title} — designedbykoda`} description={description} image={heroImage}>
	<a class="back" href="/projects">&larr; All projects</a>

	<div class="project-header">
		<div class="tags">
			<span class="tag">{category}</span>
			{status === 'Upcoming' && <span class="tag status-upcoming">Upcoming</span>}
		</div>
		<h1>{title}</h1>
		<p class="tagline">{tagline}</p>
	</div>

	<div class="hero-row">
		{
			model && (
				<div class="hero-row-model">
					<ProjectModel src={model} alt={title} cameraOrbit={cameraOrbit} />
				</div>
			)
		}
		<div class="hero-row-image">
			<ProjectImage src={heroImage} alt={title} ratio="16 / 9" />
		</div>
	</div>

	<article class="prose">
		<slot />
	</article>

	{
		gallery.length > 0 && (
			<div class="gallery">
				{gallery.map((src) => (
					<ProjectImage
						src={src}
						alt={`${title} photo`}
						ratio={galleryRatio}
						label="Photo coming soon"
					/>
				))}
			</div>
		)
	}
</Layout>

<style>
	.back {
		display: inline-block;
		color: var(--muted);
		font-size: 0.9em;
		margin-bottom: 1.5em;
	}
	.back:hover {
		color: var(--fg);
	}
	.project-header {
		margin-bottom: 1.5em;
	}
	.tags {
		display: flex;
		gap: 0.5em;
		margin-bottom: 0.8em;
	}
	.tagline {
		color: var(--muted);
		font-size: 1.15em;
		margin-top: 0.3em;
	}
	.prose {
		margin-top: 2em;
	}
	.prose :global(h2) {
		margin-top: 1.8em;
		font-size: 1.3em;
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.gallery {
		margin-top: 2.5em;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1em;
	}

	/* ---------- Hero + 3D model ---------- */
	/* Both the row height and the model's width use the same clamp()
	   expression — a definite, self-contained value that scales with the
	   viewport but never depends on the other element to resolve. The
	   previous version relied on the model stretching to "100% of its
	   flex container's height", but that container's own height was only
	   defined by stretching to fit its children — a circular dependency
	   some browsers fail to resolve, collapsing the model to zero size.
	   Definite values on both sides sidesteps that entirely, and stays
	   consistent across any screen width without ever clipping. */
	.hero-row {
		display: flex;
		gap: 1em;
		height: clamp(180px, 22vw, 320px);
	}
	.hero-row-model {
		flex: 0 0 clamp(180px, 22vw, 320px);
	}
	.hero-row-model :global(.model-slot) {
		width: 100%;
		height: 100%;
		max-width: none;
		margin: 0;
		aspect-ratio: unset;
	}
	.hero-row-image {
		flex: 1 1 auto;
		min-width: 0;
	}
	.hero-row-image :global(.img-slot) {
		height: 100%;
		aspect-ratio: unset;
	}
	@media (max-width: 640px) {
		.hero-row {
			flex-direction: column;
			height: auto;
		}
		.hero-row-model {
			flex: none;
			width: 100%;
		}
		.hero-row-model :global(.model-slot) {
			width: 100%;
			height: auto;
			aspect-ratio: 1 / 1;
		}
		.hero-row-image {
			width: 100%;
		}
		.hero-row-image :global(.img-slot) {
			height: auto;
			aspect-ratio: 16 / 9;
		}
	}
</style>
