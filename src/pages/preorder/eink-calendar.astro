---
import Layout from '../../layouts/Layout.astro';
import { BASE_PRICE_USD, CURRENCIES } from '../../data/preorderPricing';

const IMAGES = [
	'/images/projects/eink-calendar/preorder-hero.jpg',
	'/images/projects/eink-calendar/7.jpg',
	'/images/projects/eink-calendar/4.jpg',
	'/images/projects/eink-calendar/6.jpg',
	'/images/projects/eink-calendar/8.jpg',
	'/images/projects/eink-calendar/2.jpg',
];

const included = [
	'E-Ink Calendar in its frame',
	'Built-in 500 mAh rechargeable battery',
	'Quick-start card with the setup QR code',
];

const specs = [
	{ label: 'Display', value: '4.2″ e-ink, 400 × 300, black and white' },
	{ label: 'Power', value: 'USB-C charging, 500 mAh battery' },
	{ label: 'Wi-Fi', value: '2.4 GHz' },
	{ label: 'Syncs with', value: 'Google Calendar' },
	{ label: 'Setup', value: 'In your browser, no app required' },
	{ label: 'Mounting', value: 'On a desk or on the wall' },
];

const shipping = [
	'Estimated to ship by the end of January 2027.',
	'Your order is paid securely through Stripe when you check out.',
	"I'll email you when your calendar is on its way.",
];
---
<Layout
	title="Preorder - E-Ink Calendar - designedbykoda"
	description="Preorder the E-Ink Calendar, a low-power e-ink display that syncs with Google Calendar."
>
	<div class="preorder-page">
		<div class="top-bar">
			<a class="back" href="/projects/eink-calendar/">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				About the project
			</a>

			<div class="cur" id="cur">
				<button
					type="button"
					class="cur-btn"
					id="cur-btn"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-label="Currency"
				>
					<span class="cur-code" id="cur-code">USD</span>
					<svg class="chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>
				<div class="cur-menu" id="cur-menu" role="listbox" aria-label="Currency" hidden>
					{CURRENCIES.map((c, i) => (
						<button
							type="button"
							role="option"
							class="cur-opt"
							aria-selected={i === 0 ? 'true' : 'false'}
							data-code={c.code}
							data-symbol={c.symbol}
							data-rate={c.rate}
						>
							<span class="opt-code">{c.code}</span>
							<span class="opt-name">{c.name}</span>
							<span class="opt-sym">{c.symbol}</span>
						</button>
					))}
				</div>
			</div>
		</div>

		<div class="hero-grid">
			<div class="gallery">
				<div class="stage" id="stage">
					<div class="track" id="track">
						{IMAGES.map((src, i) => (
							<img
								src={src}
								alt={`E-Ink Calendar product photo ${i + 1}`}
								class="shot"
								draggable="false"
								loading="eager"
								decoding="async"
							/>
						))}
					</div>
				</div>
				<div class="thumbs" role="group" aria-label="Choose image" style={`--n:${IMAGES.length}`}>
					{IMAGES.map((src, i) => (
						<button
							type="button"
							class:list={['thumb', { active: i === 0 }]}
							data-index={i}
							aria-label={`Show image ${i + 1}`}
							aria-pressed={i === 0 ? 'true' : 'false'}
							style={`background-image:url('${src}')`}
						></button>
					))}
					<span class="thumb-ring" id="thumb-ring" aria-hidden="true"></span>
				</div>
			</div>

			<div class="hero-info">
				<div class="eyebrow-row">
					<p class="eyebrow">Preorder</p>
					<span class="badge">Ships end of Jan 2027</span>
				</div>
				<h1>E-Ink Calendar</h1>
				<p class="tagline">
					A low-power e-ink display that syncs with your Google Calendar. Mount it on the
					wall or leave it on a desk, and see your upcoming events at a glance, no phone
					required.
				</p>

				<div class="price-block">
					<span class="price" id="price-display">${BASE_PRICE_USD}</span>
				</div>

				<button class="preorder-btn" data-magnetic id="preorder-btn">Preorder Now</button>

				<ul class="assure">
					<li>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
						Secure checkout with Stripe
					</li>
					<li>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3.5 10h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
						Estimated to ship by end of January 2027
					</li>
				</ul>

				<div class="acc" id="acc">
					<div class="acc-item">
						<button type="button" class="acc-head" aria-expanded="true" aria-controls="acc-included" id="acc-included-h">
							What's included
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</button>
						<div class="acc-panel open" id="acc-included" role="region" aria-labelledby="acc-included-h">
							<div class="acc-inner">
								<ul class="acc-list">
									{included.map((t) => <li>{t}</li>)}
								</ul>
							</div>
						</div>
					</div>
					<div class="acc-item">
						<button type="button" class="acc-head" aria-expanded="false" aria-controls="acc-specs" id="acc-specs-h">
							Specs
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</button>
						<div class="acc-panel" id="acc-specs" role="region" aria-labelledby="acc-specs-h" inert>
							<div class="acc-inner">
								<dl class="spec-list">
									{specs.map((x) => (
										<div>
											<dt>{x.label}</dt>
											<dd>{x.value}</dd>
										</div>
									))}
								</dl>
							</div>
						</div>
					</div>
					<div class="acc-item">
						<button type="button" class="acc-head" aria-expanded="false" aria-controls="acc-shipping" id="acc-shipping-h">
							Shipping and preorder
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</button>
						<div class="acc-panel" id="acc-shipping" role="region" aria-labelledby="acc-shipping-h" inert>
							<div class="acc-inner">
								<ul class="acc-list">
									{shipping.map((t) => <li>{t}</li>)}
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="overview">
			<h2>Overview</h2>
			<p>
				The E-Ink Calendar connects directly to your Google Calendar, including shared or
				family calendars. Once set up, it refreshes automatically, either hourly or daily,
				your choice, and shows your day, upcoming events, and the current month at a
				glance.
			</p>
			<p>
				Because it uses an e-ink display, the screen only draws power when it actually
				changes, meaning the device runs for months on a single charge rather than needing
				to be plugged in permanently.
			</p>

			<h3>Features</h3>
			<ul>
				<li>Syncs with Google Calendar, including shared and family calendars</li>
				<li>Hourly or daily automatic refresh, your choice</li>
				<li>5-6 months of battery life per charge</li>
				<li>Wall-mountable or freestanding on a desk</li>
				<li>Simple setup: scan a QR code, sign in, pick a calendar</li>
			</ul>
		</div>
	</div>
</Layout>

<script>
	// ---------- Gallery: swipeable track, smooth slide between photos ----------
	const stage = document.getElementById('stage') as HTMLElement;
	const track = document.getElementById('track') as HTMLElement;
	const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb'));
	const last = thumbs.length - 1;
	const ring = document.getElementById('thumb-ring') as HTMLElement;
	let current = 0;

	// The further the jump, the longer it takes and the harder it eases out.
	// Next door is a quick, light switch (0.35s); five photos away (the most
	// there is to cross) is the long, heavily eased sweep (1.3s).
	const MAX_STEPS = Math.max(2, last);
	const progress = (steps: number) =>
		Math.min(1, Math.max(0, (steps - 1) / (MAX_STEPS - 1)));
	const durationFor = (steps: number) => 0.35 + 0.95 * progress(steps);
	const easeFor = (steps: number) => {
		const t = progress(steps);
		const x1 = 0.25 + 0.4 * t;
		const y1 = 0.1 - 0.1 * t;
		const x2 = 0.25 - 0.1 * t;
		return `cubic-bezier(${x1.toFixed(3)}, ${y1.toFixed(3)}, ${x2.toFixed(3)}, 1)`;
	};

	function moveRing(animate: boolean, dur = 0.35, ease = easeFor(1)) {
		const t = thumbs[current];
		ring.style.transition = animate ? `transform ${dur}s ${ease}` : 'none';
		ring.style.width = `${t.offsetWidth}px`;
		ring.style.height = `${t.offsetHeight}px`;
		ring.style.transform = `translate(${t.offsetLeft}px, ${t.offsetTop}px)`;
	}

	function setActive() {
		thumbs.forEach((t, n) => {
			t.classList.toggle('active', n === current);
			t.setAttribute('aria-pressed', String(n === current));
		});
	}
	function place(dragPx = 0, animate = true, dur = 0.35, ease = easeFor(1)) {
		track.style.transition = animate ? `transform ${dur}s ${ease}` : 'none';
		track.style.transform = `translate3d(calc(${-current * 100}% + ${dragPx}px), 0, 0)`;
	}
	function show(i: number) {
		const next = Math.max(0, Math.min(last, i));
		const steps = Math.max(1, Math.abs(next - current));
		const dur = durationFor(steps);
		const ease = easeFor(steps);
		current = next;
		setActive();
		place(0, true, dur, ease);
		moveRing(true, dur, ease);
	}
	moveRing(false);
	window.addEventListener('resize', () => moveRing(false));
	window.addEventListener('load', () => moveRing(false));
	thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.index))));

	// Drag / swipe with mouse, touch or pen. Vertical scrolling still works
	// because the stage only claims horizontal movement.
	let downX = 0, downY = 0, dx = 0, downT = 0, pid = -1;
	let armed = false, dragging = false;

	stage.addEventListener('pointerdown', (e) => {
		if (e.pointerType === 'mouse' && e.button !== 0) return;
		armed = true;
		dragging = false;
		pid = e.pointerId;
		downX = e.clientX;
		downY = e.clientY;
		downT = performance.now();
		dx = 0;
	});
	stage.addEventListener('pointermove', (e) => {
		if (!armed || e.pointerId !== pid) return;
		const mx = e.clientX - downX;
		const my = e.clientY - downY;
		if (!dragging) {
			if (Math.abs(mx) < 6 && Math.abs(my) < 6) return;
			if (Math.abs(my) > Math.abs(mx)) { armed = false; return; }
			dragging = true;
			stage.setPointerCapture(pid);
			stage.classList.add('dragging');
		}
		dx = mx;
		// Rubber-band a little at the first and last photo.
		const atEdge = (current === 0 && dx > 0) || (current === last && dx < 0);
		place(atEdge ? dx * 0.3 : dx, false);
	});
	function endDrag(e: PointerEvent) {
		if (!armed || e.pointerId !== pid) return;
		armed = false;
		if (!dragging) return;
		dragging = false;
		stage.classList.remove('dragging');
		const w = stage.clientWidth || 1;
		const speed = Math.abs(dx) / Math.max(1, performance.now() - downT);
		const far = Math.abs(dx) > w * 0.18;
		const flick = speed > 0.4 && Math.abs(dx) > 30;
		if (far || flick) show(current + (dx < 0 ? 1 : -1));
		else show(current);
	}
	stage.addEventListener('pointerup', endDrag);
	stage.addEventListener('pointercancel', endDrag);

	document.addEventListener('keydown', (e) => {
		if (menu && !menu.hidden) return;
		const tag = (e.target as HTMLElement)?.tagName;
		if (tag === 'INPUT' || tag === 'TEXTAREA') return;
		if (e.key === 'ArrowLeft') show(current - 1);
		if (e.key === 'ArrowRight') show(current + 1);
	});

	// ---------- Expandable sections ----------
	document.querySelectorAll<HTMLButtonElement>('.acc-head').forEach((head) => {
		head.addEventListener('click', () => {
			const panel = document.getElementById(head.getAttribute('aria-controls') || '');
			if (!panel) return;
			const open = head.getAttribute('aria-expanded') !== 'true';
			head.setAttribute('aria-expanded', String(open));
			panel.classList.toggle('open', open);
			panel.toggleAttribute('inert', !open);
		});
	});

	// ---------- Currency dropdown ----------
	const BASE_PRICE_USD = Number(document.getElementById('price-display')?.textContent?.replace(/[^0-9.]/g, '')) || 70;
	const btn = document.getElementById('cur-btn') as HTMLButtonElement;
	const menu = document.getElementById('cur-menu') as HTMLDivElement;
	const codeEl = document.getElementById('cur-code') as HTMLElement;
	const priceDisplay = document.getElementById('price-display') as HTMLElement;
	const opts = Array.from(menu.querySelectorAll<HTMLButtonElement>('.cur-opt'));
	let selected = opts[0];

	function openMenu() {
		menu.hidden = false;
		btn.setAttribute('aria-expanded', 'true');
		selected.focus();
	}
	function closeMenu(refocus = false) {
		menu.hidden = true;
		btn.setAttribute('aria-expanded', 'false');
		if (refocus) btn.focus();
	}
	function choose(opt: HTMLButtonElement) {
		selected = opt;
		opts.forEach((o) => o.setAttribute('aria-selected', String(o === opt)));
		codeEl.textContent = opt.dataset.code || 'USD';
		const rate = parseFloat(opt.dataset.rate || '1');
		priceDisplay.textContent = `${opt.dataset.symbol || '$'}${Math.round(BASE_PRICE_USD * rate)}`;
		closeMenu(true);
	}

	btn.addEventListener('click', () => (menu.hidden ? openMenu() : closeMenu()));
	opts.forEach((o) => o.addEventListener('click', () => choose(o)));
	document.addEventListener('click', (e) => {
		if (!menu.hidden && !(e.target as HTMLElement).closest('#cur')) closeMenu();
	});
	menu.addEventListener('keydown', (e) => {
		const i = opts.indexOf(document.activeElement as HTMLButtonElement);
		if (e.key === 'ArrowDown') { e.preventDefault(); opts[(i + 1) % opts.length].focus(); }
		else if (e.key === 'ArrowUp') { e.preventDefault(); opts[(i - 1 + opts.length) % opts.length].focus(); }
		else if (e.key === 'Escape') { e.preventDefault(); closeMenu(true); }
		else if (e.key === 'Tab') closeMenu();
	});

	// ---------- Checkout ----------
	const preorderBtn = document.getElementById('preorder-btn') as HTMLButtonElement;
	preorderBtn?.addEventListener('click', async () => {
		const currency = selected.dataset.code || 'USD';

		preorderBtn.disabled = true;
		const originalText = preorderBtn.textContent;
		preorderBtn.textContent = 'Redirecting to checkout...';

		try {
			const res = await fetch('/api/checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ currency }),
			});
			const data = await res.json();
			if (res.ok && data.url) {
				window.location.href = data.url;
			} else {
				alert(data.error || 'Could not start checkout. Please try again.');
				preorderBtn.disabled = false;
				preorderBtn.textContent = originalText;
			}
		} catch {
			alert('Could not start checkout. Please try again.');
			preorderBtn.disabled = false;
			preorderBtn.textContent = originalText;
		}
	});
</script>

<style>
	/* Wider than the site's 860px column, centred on the page, and pulled up
	   closer to the header. This page only. */
	.preorder-page {
		position: relative;
		left: 50%;
		width: min(1180px, 100vw - 3em);
		transform: translateX(-50%);
		margin-top: -1.8em;
		padding: 0 0 4em 0;
	}
	:global(html:has(.preorder-page)) {
		overflow-x: clip;
	}
	/* Circle cursor only: hide the native one on everything here. */
	:global(html.has-custom-cursor) .preorder-page,
	:global(html.has-custom-cursor) .preorder-page * {
		cursor: none !important;
	}

	/* ---------- top bar ---------- */
	.top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.2em;
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		color: var(--muted);
		font-size: 0.9em;
		text-decoration: none;
		transition: color 0.15s;
	}
	.back svg {
		width: 16px;
		height: 16px;
		transition: transform 0.15s;
	}
	.back:hover {
		color: var(--fg);
	}
	.back:hover svg {
		transform: translateX(-3px);
	}

	/* ---------- currency dropdown ---------- */
	.cur {
		position: relative;
	}
	.cur-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		font: inherit;
		font-size: 0.85em;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--fg);
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.5em 0.9em 0.5em 1.1em;
		transition: border-color 0.15s, background 0.15s;
	}
	.cur-btn:hover,
	.cur-btn[aria-expanded='true'] {
		border-color: var(--accent);
	}
	.chev {
		width: 14px;
		height: 14px;
		color: var(--muted);
		transition: transform 0.2s;
	}
	.cur-btn[aria-expanded='true'] .chev {
		transform: rotate(180deg);
	}
	.cur-menu {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		z-index: 30;
		min-width: 270px;
		padding: 6px;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: var(--shadow, 0 12px 32px rgba(0, 0, 0, 0.35));
		animation: menu-in 0.14s ease-out;
	}
	.cur-menu[hidden] {
		display: none;
	}
	@keyframes menu-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}
	.cur-opt {
		display: grid;
		grid-template-columns: 3.2em 1fr auto;
		align-items: center;
		gap: 0.6em;
		width: 100%;
		font: inherit;
		font-size: 0.88em;
		text-align: left;
		color: var(--muted);
		background: none;
		border: none;
		border-radius: 9px;
		padding: 0.55em 0.7em;
		transition: background 0.12s, color 0.12s;
	}
	.opt-code {
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--fg);
	}
	.opt-name {
		white-space: nowrap;
	}
	.opt-sym {
		color: var(--muted-dim);
		font-variant-numeric: tabular-nums;
	}
	.cur-opt:hover,
	.cur-opt:focus-visible {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--fg);
		outline: none;
	}
	.cur-opt[aria-selected='true'] {
		background: color-mix(in srgb, var(--accent) 18%, transparent);
		color: var(--fg);
	}

	/* ---------- layout ---------- */
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
		gap: 3.5em;
		align-items: start;
		margin-bottom: 3.5em;
	}
	.gallery {
		position: sticky;
		top: 5.5em;
	}

	/* ---------- gallery ---------- */
	.stage {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 16px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
		cursor: grab;
	}
	.stage.dragging {
		cursor: grabbing;
	}
	/* All photos sit side by side in one strip; switching slides the strip. */
	.track {
		display: flex;
		height: 100%;
		will-change: transform;
	}
	.shot {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		border: none;
		pointer-events: none;
	}
	/* The site gives every image a hover zoom; not on the product photo. */
	.stage :global(img.shot),
	.stage :global(img.shot:hover) {
		transform: none !important;
		transition: none !important;
	}
	@media (prefers-reduced-motion: reduce) {
		.track,
		.thumb-ring {
			transition-duration: 0.01s !important;
		}
	}
	.thumbs {
		position: relative;
		display: grid;
		grid-template-columns: repeat(var(--n, 6), minmax(0, 1fr));
		gap: 0.6em;
		margin-top: 0.8em;
	}
	/* One highlight that slides to whichever photo is showing. */
	.thumb-ring {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		pointer-events: none;
		border: 1px solid var(--accent);
		border-radius: 10px;
		box-shadow: 0 0 0 1px var(--accent);
		will-change: transform;
	}
	.thumb {
		aspect-ratio: 4 / 3;
		padding: 0;
		background-size: cover;
		background-position: center;
		border: 1px solid var(--border);
		border-radius: 10px;
		opacity: 0.6;
		transition: opacity 0.4s ease;
	}
	.thumb:hover {
		opacity: 1;
	}
	.thumb.active {
		opacity: 1;
	}

	/* ---------- info column ---------- */
	.eyebrow-row {
		display: flex;
