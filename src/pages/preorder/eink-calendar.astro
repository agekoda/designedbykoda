---
import Layout from '../../layouts/Layout.astro';
import { BASE_PRICE_USD, CURRENCIES } from '../../data/preorderPricing';

const IMAGES = [
	'/images/projects/eink-calendar/preorder-hero.jpg',
	'/images/projects/eink-calendar/1.jpg',
	'/images/projects/eink-calendar/3.jpg',
];

const specs = [
	{ label: 'Display', value: '4.2″ e-ink' },
	{ label: 'Battery', value: '5–6 months' },
	{ label: 'Syncs with', value: 'Google Calendar' },
	{ label: 'Refresh', value: 'Hourly or daily' },
];
---
<Layout
	title="Preorder - E-Ink Calendar - designedbykoda"
	description="Preorder the E-Ink Calendar, a low-power e-ink display that syncs with Google Calendar."
>
	<div class="preorder-page">
		<div class="top-bar">
			<a class="back" href="/projects/eink-calendar/">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				About the project
			</a>

			<div class="cur" id="cur">
				<button
					type="button"
					class="cur-btn"
					id="cur-btn"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-label="Currency"
				>
					<span class="cur-code" id="cur-code">USD</span>
					<svg class="chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>
				<div class="cur-menu" id="cur-menu" role="listbox" aria-label="Currency" hidden>
					{CURRENCIES.map((c, i) => (
						<button
							type="button"
							role="option"
							class="cur-opt"
							aria-selected={i === 0 ? 'true' : 'false'}
							data-code={c.code}
							data-symbol={c.symbol}
							data-rate={c.rate}
						>
							<span class="opt-code">{c.code}</span>
							<span class="opt-name">{c.name}</span>
							<span class="opt-sym">{c.symbol}</span>
						</button>
					))}
				</div>
			</div>
		</div>

		<div class="hero-grid">
			<div class="gallery">
				<div class="stage" id="stage">
					{IMAGES.map((src, i) => (
						<img
							src={src}
							alt={`E-Ink Calendar product photo ${i + 1}`}
							class:list={['shot', { active: i === 0 }]}
							loading="eager"
							decoding="async"
						/>
					))}
					<button class="arrow left" id="gallery-prev" aria-label="Previous image">
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</button>
					<button class="arrow right" id="gallery-next" aria-label="Next image">
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</button>
					<span class="counter" id="gallery-counter" aria-live="polite">1 / {IMAGES.length}</span>
				</div>
				<div class="thumbs" role="group" aria-label="Choose image">
					{IMAGES.map((src, i) => (
						<button
							type="button"
							class:list={['thumb', { active: i === 0 }]}
							data-index={i}
							aria-label={`Show image ${i + 1}`}
							aria-pressed={i === 0 ? 'true' : 'false'}
							style={`background-image:url('${src}')`}
						></button>
					))}
				</div>
			</div>

			<div class="hero-info">
				<div class="eyebrow-row">
					<p class="eyebrow">Preorder</p>
					<span class="badge">Ships end of Jan 2027</span>
				</div>
				<h1>E-Ink Calendar</h1>
				<p class="tagline">
					A low-power e-ink display that syncs with your Google Calendar. Mount it on the
					wall or leave it on a desk, and see your upcoming events at a glance, no phone
					required.
				</p>

				<div class="price-block">
					<span class="price" id="price-display">${BASE_PRICE_USD}</span>
					<span class="price-note">one-time payment</span>
				</div>

				<button class="preorder-btn" data-magnetic id="preorder-btn">Preorder Now</button>

				<ul class="assure">
					<li>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
						Secure checkout with Stripe
					</li>
					<li>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3.5 10h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
						Estimated to ship by end of January 2027
					</li>
				</ul>

				<dl class="specs">
					{specs.map((s) => (
						<div>
							<dt>{s.label}</dt>
							<dd>{s.value}</dd>
						</div>
					))}
				</dl>
			</div>
		</div>

		<div class="overview">
			<h2>Overview</h2>
			<p>
				The E-Ink Calendar connects directly to your Google Calendar, including shared or
				family calendars. Once set up, it refreshes automatically, either hourly or daily,
				your choice, and shows your day, upcoming events, and the current month at a
				glance.
			</p>
			<p>
				Because it uses an e-ink display, the screen only draws power when it actually
				changes, meaning the device runs for months on a single charge rather than needing
				to be plugged in permanently.
			</p>

			<h3>Features</h3>
			<ul>
				<li>Syncs with Google Calendar, including shared and family calendars</li>
				<li>Hourly or daily automatic refresh, your choice</li>
				<li>5-6 months of battery life per charge</li>
				<li>Wall-mountable or freestanding on a desk</li>
				<li>Simple setup: scan a QR code, sign in, pick a calendar</li>
			</ul>
		</div>
	</div>
</Layout>

<script>
	// ---------- Gallery: instant swap, nothing animates ----------
	const shots = Array.from(document.querySelectorAll<HTMLImageElement>('.shot'));
	const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb'));
	const counter = document.getElementById('gallery-counter');
	let current = 0;

	function show(i: number) {
		current = (i + shots.length) % shots.length;
		shots.forEach((s, n) => s.classList.toggle('active', n === current));
		thumbs.forEach((t, n) => {
			t.classList.toggle('active', n === current);
			t.setAttribute('aria-pressed', String(n === current));
		});
		if (counter) counter.textContent = `${current + 1} / ${shots.length}`;
	}
	document.getElementById('gallery-prev')?.addEventListener('click', () => show(current - 1));
	document.getElementById('gallery-next')?.addEventListener('click', () => show(current + 1));
	thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.index))));
	document.addEventListener('keydown', (e) => {
		if (menu && !menu.hidden) return;
		const tag = (e.target as HTMLElement)?.tagName;
		if (tag === 'INPUT' || tag === 'TEXTAREA') return;
		if (e.key === 'ArrowLeft') show(current - 1);
		if (e.key === 'ArrowRight') show(current + 1);
	});

	// ---------- Currency dropdown ----------
	const BASE_PRICE_USD = Number(document.getElementById('price-display')?.textContent?.replace(/[^0-9.]/g, '')) || 70;
	const btn = document.getElementById('cur-btn') as HTMLButtonElement;
	const menu = document.getElementById('cur-menu') as HTMLDivElement;
	const codeEl = document.getElementById('cur-code') as HTMLElement;
	const priceDisplay = document.getElementById('price-display') as HTMLElement;
	const opts = Array.from(menu.querySelectorAll<HTMLButtonElement>('.cur-opt'));
	let selected = opts[0];

	function openMenu() {
		menu.hidden = false;
		btn.setAttribute('aria-expanded', 'true');
		selected.focus();
	}
	function closeMenu(refocus = false) {
		menu.hidden = true;
		btn.setAttribute('aria-expanded', 'false');
		if (refocus) btn.focus();
	}
	function choose(opt: HTMLButtonElement) {
		selected = opt;
		opts.forEach((o) => o.setAttribute('aria-selected', String(o === opt)));
		codeEl.textContent = opt.dataset.code || 'USD';
		const rate = parseFloat(opt.dataset.rate || '1');
		priceDisplay.textContent = `${opt.dataset.symbol || '$'}${Math.round(BASE_PRICE_USD * rate)}`;
		closeMenu(true);
	}

	btn.addEventListener('click', () => (menu.hidden ? openMenu() : closeMenu()));
	opts.forEach((o) => o.addEventListener('click', () => choose(o)));
	document.addEventListener('click', (e) => {
		if (!menu.hidden && !(e.target as HTMLElement).closest('#cur')) closeMenu();
	});
	menu.addEventListener('keydown', (e) => {
		const i = opts.indexOf(document.activeElement as HTMLButtonElement);
		if (e.key === 'ArrowDown') { e.preventDefault(); opts[(i + 1) % opts.length].focus(); }
		else if (e.key === 'ArrowUp') { e.preventDefault(); opts[(i - 1 + opts.length) % opts.length].focus(); }
		else if (e.key === 'Escape') { e.preventDefault(); closeMenu(true); }
		else if (e.key === 'Tab') closeMenu();
	});

	// ---------- Checkout ----------
	const preorderBtn = document.getElementById('preorder-btn') as HTMLButtonElement;
	preorderBtn?.addEventListener('click', async () => {
		const currency = selected.dataset.code || 'USD';

		preorderBtn.disabled = true;
		const originalText = preorderBtn.textContent;
		preorderBtn.textContent = 'Redirecting to checkout...';

		try {
			const res = await fetch('/api/checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ currency }),
			});
			const data = await res.json();
			if (res.ok && data.url) {
				window.location.href = data.url;
			} else {
				alert(data.error || 'Could not start checkout. Please try again.');
				preorderBtn.disabled = false;
				preorderBtn.textContent = originalText;
			}
		} catch {
			alert('Could not start checkout. Please try again.');
			preorderBtn.disabled = false;
			preorderBtn.textContent = originalText;
		}
	});
</script>

<style>
	.preorder-page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 1em 0 4em 0;
	}
	/* Circle cursor only: hide the native one on everything here. */
	:global(html.has-custom-cursor) .preorder-page,
	:global(html.has-custom-cursor) .preorder-page * {
		cursor: none !important;
	}

	/* ---------- top bar ---------- */
	.top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.6em;
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		color: var(--muted);
		font-size: 0.9em;
		text-decoration: none;
		transition: color 0.15s;
	}
	.back svg {
		width: 16px;
		height: 16px;
		transition: transform 0.15s;
	}
	.back:hover {
		color: var(--fg);
	}
	.back:hover svg {
		transform: translateX(-3px);
	}

	/* ---------- currency dropdown ---------- */
	.cur {
		position: relative;
	}
	.cur-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		font: inherit;
		font-size: 0.85em;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--fg);
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.5em 0.9em 0.5em 1.1em;
		transition: border-color 0.15s, background 0.15s;
	}
	.cur-btn:hover,
	.cur-btn[aria-expanded='true'] {
		border-color: var(--accent);
	}
	.chev {
		width: 14px;
		height: 14px;
		color: var(--muted);
		transition: transform 0.2s;
	}
	.cur-btn[aria-expanded='true'] .chev {
		transform: rotate(180deg);
	}
	.cur-menu {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		z-index: 30;
		min-width: 270px;
		padding: 6px;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: var(--shadow, 0 12px 32px rgba(0, 0, 0, 0.35));
		animation: menu-in 0.14s ease-out;
	}
	.cur-menu[hidden] {
		display: none;
	}
	@keyframes menu-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}
	.cur-opt {
		display: grid;
		grid-template-columns: 3.2em 1fr auto;
		align-items: center;
		gap: 0.6em;
		width: 100%;
		font: inherit;
		font-size: 0.88em;
		text-align: left;
		color: var(--muted);
		background: none;
		border: none;
		border-radius: 9px;
		padding: 0.55em 0.7em;
		transition: background 0.12s, color 0.12s;
	}
	.opt-code {
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--fg);
	}
	.opt-name {
		white-space: nowrap;
	}
	.opt-sym {
		color: var(--muted-dim);
		font-variant-numeric: tabular-nums;
	}
	.cur-opt:hover,
	.cur-opt:focus-visible {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--fg);
		outline: none;
	}
	.cur-opt[aria-selected='true'] {
		background: color-mix(in srgb, var(--accent) 18%, transparent);
		color: var(--fg);
	}

	/* ---------- layout ---------- */
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 3em;
		align-items: start;
		margin-bottom: 3.5em;
	}
	.gallery {
		position: sticky;
		top: 5.5em;
	}

	/* ---------- gallery ---------- */
	.stage {
		position: relative;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-radius: 16px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
	}
	/* Every photo sits stacked in the same box; switching just changes which
	   one is visible, so there's nothing to load or animate. */
	.shot {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		visibility: hidden;
		border-radius: 0;
		border: none;
	}
	.shot.active {
		visibility: visible;
	}
	/* The site gives every image a hover zoom; not on the product photo. */
	.stage :global(img.shot),
	.stage :global(img.shot:hover) {
		transform: none !important;
		transition: none !important;
	}
	.arrow {
		position: absolute;
		z-index: 2;
		top: 50%;
		transform: translateY(-50%);
		width: 42px;
		height: 42px;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		background: rgba(10, 14, 20, 0.45);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 50%;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		opacity: 0;
		transition: opacity 0.15s, background 0.15s;
	}
	.arrow svg {
		width: 20px;
		height: 20px;
	}
	.stage:hover .arrow,
	.arrow:focus-visible {
		opacity: 1;
	}
	.arrow:hover {
		background: rgba(10, 14, 20, 0.7);
	}
	.arrow.left {
		left: 10px;
	}
	.arrow.right {
		right: 10px;
	}
	.counter {
		position: absolute;
		z-index: 2;
		right: 10px;
		bottom: 10px;
		font-size: 0.75em;
		font-variant-numeric: tabular-nums;
		color: #fff;
		background: rgba(10, 14, 20, 0.55);
		border-radius: 999px;
		padding: 0.25em 0.7em;
	}
	.thumbs {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(64px, 84px));
		gap: 0.6em;
		margin-top: 0.8em;
	}
	.thumb {
		aspect-ratio: 1;
		padding: 0;
		background-size: cover;
		background-position: center;
		border: 1px solid var(--border);
		border-radius: 10px;
		opacity: 0.6;
		transition: opacity 0.15s, border-color 0.15s;
	}
	.thumb:hover {
		opacity: 1;
	}
	.thumb.active {
		opacity: 1;
		border-color: var(--accent);
		box-shadow: 0 0 0 1px var(--accent);
	}

	/* ---------- info column ---------- */
	.eyebrow-row {
		display: flex;
		align-items: center;
		gap: 0.8em;
		flex-wrap: wrap;
		margin-bottom: 0.5em;
	}
	.eyebrow {
		color: var(--muted-dim);
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin: 0;
	}
	.badge {
		font-size: 0.75em;
		font-weight: 600;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		border-radius: 999px;
		padding: 0.25em 0.8em;
	}
	.hero-info h1 {
		margin: 0 0 0.5em 0;
		font-size: 2.3em;
		line-height: 1.1;
	}
	.tagline {
		color: var(--muted);
		line-height: 1.65;
		margin-bottom: 1.6em;
	}
	.price-block {
		display: flex;
		align-items: baseline;
		gap: 0.7em;
		margin-bottom: 1.2em;
	}
	.price {
		font-size: 2.6em;
		font-weight: 700;
		line-height: 1;
		color: var(--fg);
		font-variant-numeric: tabular-nums;
	}
	.price-note {
		color: var(--muted-dim);
		font-size: 0.85em;
	}
	.preorder-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		padding: 1em 1.8em;
		border: none;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font-weight: 700;
		font-size: 1.05em;
		font-family: inherit;
		transition: background 0.15s, opacity 0.15s;
	}
	.preorder-btn:hover {
		background: var(--accent);
	}
	.preorder-btn:disabled {
		opacity: 0.65;
	}
	.assure {
		list-style: none;
		padding: 0;
		margin: 1.3em 0 0 0;
		display: grid;
		gap: 0.65em;
		color: var(--muted);
		font-size: 0.88em;
	}
	.assure li {
		display: flex;
		align-items: center;
		gap: 0.65em;
	}
	.assure svg {
		width: 18px;
		height: 18px;
		flex: none;
		color: var(--muted-dim);
	}
	.specs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.7em;
		margin: 1.8em 0 0 0;
		padding-top: 1.6em;
		border-top: 1px solid var(--border);
	}
	.specs div {
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 0.75em 1em;
	}
	.specs dt {
		color: var(--muted-dim);
		font-size: 0.75em;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		margin-bottom: 0.15em;
	}
	.specs dd {
		margin: 0;
		color: var(--fg);
		font-weight: 600;
		font-size: 0.95em;
	}

	/* ---------- overview ---------- */
	.overview {
		border-top: 1px solid var(--border);
		padding-top: 2.4em;
		max-width: 680px;
	}
	.overview p {
		color: var(--muted);
		line-height: 1.65;
		margin-bottom: 1em;
	}
	.overview ul {
		color: var(--muted);
		line-height: 1.8;
		padding-left: 1.3em;
	}

	@media (max-width: 760px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}
		.gallery {
			position: static;
		}
		.arrow {
			opacity: 1;
		}
	}
</style>
