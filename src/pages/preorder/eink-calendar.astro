---
import Layout from '../../layouts/Layout.astro';
---
<Layout
	title="Preorder - E-Ink Calendar - designedbykoda"
	description="Preorder the E-Ink Calendar, a low-power e-ink display that syncs with Google Calendar."
>
	<div class="preorder-page">
		<div class="top-bar">
			<span></span>
			<label class="currency-select">
				<span class="sr-only">Currency</span>
				<select id="currency-picker">
					<option value="USD" data-symbol="$" data-rate="1">USD - US Dollar</option>
					<option value="EUR" data-symbol="€" data-rate="0.86">EUR - Euro</option>
					<option value="GBP" data-symbol="£" data-rate="0.74">GBP - British Pound</option>
					<option value="AUD" data-symbol="A$" data-rate="1.386">AUD - Australian Dollar</option>
					<option value="CAD" data-symbol="C$" data-rate="1.38">CAD - Canadian Dollar</option>
				</select>
			</label>
		</div>

		<div class="hero-grid">
			<div class="gallery">
				<div class="main-image-wrap card">
					<button class="gallery-arrow left" id="gallery-prev" aria-label="Previous image">
						<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</button>
					<img
						src="/images/projects/eink-calendar/1.jpg"
						alt="E-Ink Calendar product photo"
						class="hero-image"
						id="gallery-main-image"
					/>
					<button class="gallery-arrow right" id="gallery-next" aria-label="Next image">
						<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</button>
				</div>
			</div>
			<div class="hero-info">
				<p class="eyebrow">Preorder</p>
				<h1>E-Ink Calendar</h1>
				<p class="tagline">
					A low-power e-ink display that syncs with your Google Calendar. Mount it on the
					wall or leave it on a desk, and see your upcoming events at a glance, no phone
					required.
				</p>

				<div class="price-block">
					<span class="price" id="price-display">$70</span>
				</div>

				<button class="preorder-btn" data-magnetic id="preorder-btn">Preorder Now</button>

				<p class="shipping-note">Estimated to ship by end of January 2027</p>
			</div>
		</div>

		<div class="overview">
			<h2>Overview</h2>
			<p>
				The E-Ink Calendar connects directly to your Google Calendar, including shared or
				family calendars. Once set up, it refreshes automatically, either hourly or daily,
				your choice, and shows your day, upcoming events, and the current month at a
				glance.
			</p>
			<p>
				Because it uses an e-ink display, the screen only draws power when it actually
				changes, meaning the device runs for months on a single charge rather than needing
				to be plugged in permanently.
			</p>

			<h3>Features</h3>
			<ul>
				<li>Syncs with Google Calendar, including shared and family calendars</li>
				<li>Hourly or daily automatic refresh, your choice</li>
				<li>3-4 months of battery life per charge</li>
				<li>Wall-mountable or freestanding on a desk</li>
				<li>Simple setup: scan a QR code, sign in, pick a calendar</li>
			</ul>
		</div>
	</div>
</Layout>

<script>
	const IMAGES = [
		'/images/projects/eink-calendar/1.jpg',
		'/images/projects/eink-calendar/3.jpg',
		'/images/projects/eink-calendar/preorder-hero.jpg',
	];
	let currentIndex = 0;
	let isAnimating = false;
	const TRANSITION_MS = 220;

	const mainImage = document.getElementById('gallery-main-image') as HTMLImageElement;

	function wrap(i: number) {
		return (i + IMAGES.length) % IMAGES.length;
	}

	// direction: 1 = next (content slides in from the right), -1 = prev (from the left)
	function navigate(direction: number) {
		if (isAnimating) return;
		isAnimating = true;

		const exitClass = direction === 1 ? 'slide-exit-left' : 'slide-exit-right';
		const enterFromClass = direction === 1 ? 'slide-enter-from-right' : 'slide-enter-from-left';

		mainImage.classList.add(exitClass);

		setTimeout(() => {
			currentIndex = wrap(currentIndex + direction);
			mainImage.src = IMAGES[currentIndex];
			mainImage.classList.remove(exitClass);
			mainImage.classList.add(enterFromClass);
			// Force a reflow so the browser registers the off-screen starting
			// position before the transition below is allowed to run —
			// otherwise the browser can coalesce both style changes into one
			// frame and skip the animation entirely.
			void mainImage.offsetWidth;
			mainImage.classList.remove(enterFromClass);

			setTimeout(() => {
				isAnimating = false;
			}, TRANSITION_MS);
		}, TRANSITION_MS);
	}

	document.getElementById('gallery-prev')?.addEventListener('click', () => navigate(-1));
	document.getElementById('gallery-next')?.addEventListener('click', () => navigate(1));

	const picker = document.getElementById('currency-picker') as HTMLSelectElement;
	const priceDisplay = document.getElementById('price-display') as HTMLSpanElement;
	const BASE_PRICE_USD = 70;

	function updatePrice() {
		const selected = picker.options[picker.selectedIndex];
		const symbol = selected.dataset.symbol || '$';
		const rate = parseFloat(selected.dataset.rate || '1');
		const converted = Math.round(BASE_PRICE_USD * rate);
		priceDisplay.textContent = `${symbol}${converted}`;
	}
	picker.addEventListener('change', updatePrice);
	updatePrice();

	const preorderBtn = document.getElementById('preorder-btn') as HTMLButtonElement;
	preorderBtn?.addEventListener('click', async () => {
		const selected = picker.options[picker.selectedIndex];
		const currency = selected.value;

		preorderBtn.disabled = true;
		const originalText = preorderBtn.textContent;
		preorderBtn.textContent = 'Redirecting to checkout...';

		try {
			const res = await fetch('/api/checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ currency }),
			});
			const data = await res.json();
			if (res.ok && data.url) {
				window.location.href = data.url;
			} else {
				alert(data.error || 'Could not start checkout. Please try again.');
				preorderBtn.disabled = false;
				preorderBtn.textContent = originalText;
			}
		} catch {
			alert('Could not start checkout. Please try again.');
			preorderBtn.disabled = false;
			preorderBtn.textContent = originalText;
		}
	});
</script>

<style>
	.preorder-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 1.5em 0 4em 0;
	}
	.top-bar {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 1.5em;
	}
	.currency-select select {
		background: var(--bg-raised);
		color: var(--fg);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.4em 1em;
		font-size: 0.85em;
		font-family: inherit;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5em;
		align-items: center;
		margin-bottom: 3em;
	}
	.hero-image {
		width: 100%;
		display: block;
		border-radius: 14px;
		border: 1px solid var(--border);
		transition: transform 0.22s ease, opacity 0.22s ease;
		transform: translateX(0);
		opacity: 1;
	}
	.hero-image.slide-exit-left {
		transform: translateX(-28px);
		opacity: 0;
	}
	.hero-image.slide-exit-right {
		transform: translateX(28px);
		opacity: 0;
	}
	.hero-image.slide-enter-from-right {
		transition: none;
		transform: translateX(28px);
		opacity: 0;
	}
	.hero-image.slide-enter-from-left {
		transition: none;
		transform: translateX(-28px);
		opacity: 0;
	}
	.gallery {
		display: flex;
		flex-direction: column;
	}
	.main-image-wrap {
		position: relative;
		overflow: hidden;
		border-radius: 14px;
	}
	.gallery-arrow {
		position: absolute;
		z-index: 2;
		top: 50%;
		transform: translateY(-50%);
		width: 30px;
		height: 30px;
		border: none;
		background: none;
		padding: 0;
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.7));
		opacity: 0.8;
		transition: opacity 0.15s, transform 0.15s;
	}
	.gallery-arrow svg {
		width: 100%;
		height: 100%;
	}
	.gallery-arrow:hover {
		opacity: 1;
	}
	.gallery-arrow.left {
		left: 6px;
	}
	.gallery-arrow.left:hover {
		transform: translateY(-50%) translateX(-3px);
	}
	.gallery-arrow.right {
		right: 6px;
	}
	.gallery-arrow.right:hover {
		transform: translateY(-50%) translateX(3px);
	}
	.eyebrow {
		color: var(--muted-dim);
		font-size: 0.9em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin: 0 0 0.4em 0;
	}
	.hero-info h1 {
		margin: 0 0 0.5em 0;
	}
	.tagline {
		color: var(--muted);
		line-height: 1.6;
		margin-bottom: 1.5em;
	}
	.price-block {
		display: flex;
		align-items: baseline;
		gap: 0.6em;
		margin-bottom: 1.5em;
	}
	.price {
		font-size: 2.4em;
		font-weight: 700;
		color: var(--fg);
		font-variant-numeric: tabular-nums;
	}
	.shipping-note {
		margin-top: 1.2em;
		padding-top: 1em;
		border-top: 1px solid var(--border);
		color: var(--muted-dim);
		font-size: 0.85em;
	}
	.preorder-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8em 1.8em;
		border: none;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font-weight: 700;
		font-size: 1em;
		font-family: inherit;
		cursor: pointer;
	}
	.preorder-btn:hover {
		background: var(--accent);
	}
	.waitlist-wrap {
		margin-top: 1.5em;
		padding: 1.3em 1.4em;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 14px;
	}
	.waitlist-note {
		color: var(--muted);
		font-size: 0.9em;
		margin: 0 0 1em 0;
	}
	.overview {
		border-top: 1px solid var(--border);
		padding-top: 2em;
	}
	.overview p {
		color: var(--muted);
		line-height: 1.6;
		margin-bottom: 1em;
	}
	.overview ul {
		color: var(--muted);
		line-height: 1.7;
		padding-left: 1.3em;
	}
	@media (max-width: 700px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
