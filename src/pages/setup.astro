---
export const prerender = false;
// TEMPORARY: setup is gated until Google verification completes, so
// nobody stumbles onto the "unverified app" warning screen. Delete this
// whole block once verification clears.
// if (!Astro.url.searchParams.has('preview')) {
// 	return Astro.redirect('/setup-coming-soon');
// }
import Layout from '../layouts/Layout.astro';
import { getSessionUserId } from '../lib/session';
import { CALENDAR_STYLES, DEFAULT_STYLE } from '../data/calendarStyles';
import CitySearchStyles from '../components/CitySearchStyles.astro';

const env = Astro.locals.runtime?.env ?? {};
const db = env.DB;
let userId: string | null = null;
if (db) {
	userId = await getSessionUserId(Astro.request, db);
}

// Someone who already paired a device (e.g. coming back to change their
// layout) skips straight past the pairing step.
let hasDevice = false;
if (db && userId) {
	try {
		const row = await db.prepare('SELECT 1 AS x FROM devices WHERE user_id = ? LIMIT 1').bind(userId).first();
		hasDevice = !!row;
	} catch {}
}

// If this page was reached by scanning the device's QR code, carry the
// code through to the sign-in link too — otherwise it's dropped right
// here before the OAuth round trip even starts.
const incomingCode = Astro.url.searchParams.get('code');
const signInHref = incomingCode
	? `/api/auth/google/start?code=${encodeURIComponent(incomingCode)}`
	: '/api/auth/google/start';

// Once an account has a device, /setup is not the place to change things
// any more: send them to their device dashboard. Adding another device
// (or scanning a device's QR code) still comes here: /setup?new=1.
const addingDevice = Astro.url.searchParams.has('new') || !!incomingCode;
if (userId && hasDevice && !addingDevice) {
	return Astro.redirect('/dashboard');
}
---

<Layout
	title="Device setup — designedbykoda"
	description="Connect your Google Calendar and pair your E-Ink Calendar."
>
	<div class="setup-page" data-signed-in={userId ? '1' : '0'}>
		<div class="wizard">
			{userId && (
				<ol class="dots" aria-hidden="true">
					<li></li><li></li><li></li><li></li><li></li><li></li>
				</ol>
			)}

			{
				!userId ? (
					<section class="step is-active" data-step="signin">
						<div class="step-kicker">Step 1</div>
						<div class="step-title">Sign in with Google</div>
						<p class="step-text">
							This lets your calendar read your events. We only ever read them, never change
							anything.
						</p>
						<a class="btn" data-magnetic href={signInHref}>
							Sign in with Google
						</a>
					</section>
				) : (
					<>
						<section class="step" data-step="pair">
							<div class="step-kicker">Step 2</div>
							<div class="step-title">Enter your pairing code</div>
							<p class="step-text">
								It's on your calendar's screen, under "Almost there!". Or scan the QR code and
								it fills in by itself.
							</p>
							<form id="pair-form" novalidate>
								<label for="pairing-code" class="sr-only">Pairing code</label>
								<input
									type="text"
									id="pairing-code"
									placeholder="XXXXXX"
									maxlength="6"
									autocomplete="off"
									autocapitalize="characters"
									spellcheck="false"
									required
								/>
								<button type="submit" class="btn" data-magnetic>Pair device</button>
							</form>
							<p class="msg" id="pair-message" aria-live="polite" />
						</section>

						<section class="step" data-step="calendars">
							<div class="step-kicker">Step 3</div>
							<div class="step-title">Pick your calendars</div>
							<p class="step-text">Choose which ones your calendar should show.</p>
							<div id="calendar-list" class="cal-list">
								<p class="loading-text">Loading your calendars…</p>
							</div>
							<p class="msg" id="calendar-message" aria-live="polite" />
							<div class="row">
								<button type="button" class="btn ghost" data-back>Back</button>
								<button type="button" class="btn" id="save-calendars" data-magnetic disabled>
									Continue
								</button>
							</div>
						</section>

						<section class="step" data-step="style">
							<div class="step-kicker">Step 4</div>
							<div class="step-title">Choose a layout</div>
							<p class="step-text">
								You can change this any time. Your times automatically follow your Google
								Calendar's timezone, so there's nothing to set.
							</p>
							<div class="styles" role="radiogroup" aria-label="Calendar layout">
								{CALENDAR_STYLES.map((st) => (
									<label class="style-opt">
										<input type="radio" name="style" value={st.id} checked={st.id === DEFAULT_STYLE} />
										<span class="style-card">
											<span class="style-img" style={`background-image:url(${st.image})`} />
											<span class="style-name">{st.label}</span>
											<span class="style-note">{st.note}</span>
										</span>
									</label>
								))}
							</div>
							<p class="msg" id="style-message" aria-live="polite" />
							<div class="row">
								<button type="button" class="btn ghost" data-back>Back</button>
								<button type="button" class="btn" id="save-style" data-magnetic>
									Continue
								</button>
							</div>
						</section>

						<section class="step" data-step="weather">
							<div class="step-kicker">Step 5 · Optional</div>
							<div class="step-title">Show the weather?</div>
							<p class="step-text">
								Pick your city and your calendar shows today's high and low. You can skip this
								and add it later.
							</p>
							<div id="weather-box"></div>
							<p class="msg" id="weather-message" aria-live="polite" />
							<div class="row">
								<button type="button" class="btn ghost" data-back>Back</button>
								<button type="button" class="btn" id="save-weather" data-magnetic>
									Skip for now
								</button>
							</div>
						</section>

						<section class="step" data-step="done">
							<div class="done-mark" aria-hidden="true">✓</div>
							<div class="step-title">You're all set</div>
							<p class="step-text">
								Your calendar will pick up your events and layout the next time it refreshes.
								To refresh it right now, press the button on the back.
							</p>
							<a class="btn" data-magnetic href="/dashboard">Go to my devices</a>
						</section>
					</>
				)
			}
		</div>
	</div>
	<CitySearchStyles />
</Layout>

<script>
	import { createCitySearch, type City } from '../lib/citySearch';
	const page = document.querySelector('.setup-page') as HTMLElement | null;
	if (page && page.dataset.signedIn === '1') {
		const order = ['pair', 'calendars', 'style', 'weather', 'done'];
		const steps: Record<string, HTMLElement> = {};
		page.querySelectorAll<HTMLElement>('.step').forEach((el) => (steps[el.dataset.step!] = el));
		const dots = Array.from(page.querySelectorAll('.dots li'));
		let current = '';
		let deviceId = ''; // the device just paired; calendars + layout are saved to it

		function show(name: string) {
			current = name;
			for (const k of order) steps[k].classList.toggle('is-active', k === name);
			const i = order.indexOf(name);
			dots.forEach((d, n) => {
				// dot 0 is the sign-in step, already done by the time we get here
				d.classList.toggle('on', n <= i + 1);
				d.classList.toggle('now', n === i + 1);
			});
			(page!.querySelector('.dots') as HTMLElement).style.visibility = name === 'done' ? 'hidden' : 'visible';
			const focusEl = steps[name].querySelector<HTMLElement>('input[type="text"], .btn:not(.ghost)');
			if (focusEl && name === 'pair') setTimeout(() => focusEl.focus({ preventScroll: true }), 250);
		}

		page.querySelectorAll('[data-back]').forEach((b) =>
			b.addEventListener('click', () => {
				const i = order.indexOf(current);
				if (i > 0) show(order[i - 1]);
			})
		);

		// Browser timezone is only a fallback; the server uses the timezone
		// Google Calendar itself reports on every refresh.
		const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
		if (tz) {
			fetch('/api/dashboard/timezone', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ timezone: tz }),
			}).catch(() => {});
		}

		async function post(url: string, body: unknown) {
			try {
				const res = await fetch(url, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(body),
				});
				const data = await res.json().catch(() => ({}));
				return { ok: res.ok && data.ok, error: data.error as string | undefined, data };
			} catch {
				return { ok: false, error: undefined, data: {} as any };
			}
		}
		function setMsg(el: HTMLElement, text: string, err = false) {
			el.textContent = text;
			el.classList.toggle('is-error', err);
		}
		const esc = (v: string) =>
			v.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

		/* ---- pairing ---- */
		const form = document.getElementById('pair-form') as HTMLFormElement;
		const input = document.getElementById('pairing-code') as HTMLInputElement;
		const pairBtn = form.querySelector('button') as HTMLButtonElement;
		const pairMsg = document.getElementById('pair-message') as HTMLElement;
		const prefilled = new URLSearchParams(location.search).get('code');
		if (prefilled) input.value = prefilled.toUpperCase();

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const code = input.value.trim().toUpperCase();
			if (!code) return;
			pairBtn.disabled = input.disabled = true;
			pairBtn.textContent = 'Pairing…';
			setMsg(pairMsg, '');
			const r = await post('/api/dashboard/devices/pair', { pairingCode: code });
			pairBtn.disabled = input.disabled = false;
			pairBtn.textContent = 'Pair device';
			if (r.ok) {
				deviceId = r.data.deviceId || '';
				show('calendars');
			} else setMsg(pairMsg, r.error || 'Something went wrong. Try again.', true);
		});
		
		/* ---- calendars ---- */
		const list = document.getElementById('calendar-list')!;
		const saveCals = document.getElementById('save-calendars') as HTMLButtonElement;
		const calMsg = document.getElementById('calendar-message')!;

		fetch('/api/dashboard/calendars')
			.then((r) => r.json())
			.then((data) => {
				if (!data.calendars || !data.calendars.length) {
					list.innerHTML = '<p class="loading-text">No calendars found.</p>';
					return;
				}
				list.innerHTML = data.calendars
					.map((c: any) => {
						const on = !!c.primary;
						return `<label class="cal-opt"><input type="checkbox" value="${esc(c.id)}" ${on ? 'checked' : ''} /><span class="box" aria-hidden="true"></span><span class="cal-name">${esc(c.summary)}${c.primary ? ' <em>primary</em>' : ''}</span></label>`;
					})
					.join('');
				saveCals.disabled = false;
			})
			.catch(() => {
				list.innerHTML = '<p class="loading-text">Could not load calendars.</p>';
			});

		saveCals.addEventListener('click', async () => {
			const ids = Array.from(list.querySelectorAll<HTMLInputElement>('input:checked')).map((el) => el.value);
			saveCals.disabled = true;
			setMsg(calMsg, '');
			const r = await post('/api/dashboard/devices', { deviceId, calendarIds: ids });
			saveCals.disabled = false;
			if (r.ok) show('style');
			else setMsg(calMsg, r.error || 'Something went wrong.', true);
		});

		/* ---- weather (optional) ---- */
		let chosenCity: City | null = null;
		const saveWeather = document.getElementById('save-weather') as HTMLButtonElement;
		const weatherMsg = document.getElementById('weather-message')!;
		document.getElementById('weather-box')!.appendChild(
			createCitySearch({
				onSelect: (c) => {
					chosenCity = c;
					saveWeather.textContent = c ? 'Finish' : 'Skip for now';
				},
			})
		);
		saveWeather.addEventListener('click', async () => {
			if (!chosenCity) return show('done');
			saveWeather.disabled = true;
			setMsg(weatherMsg, '');
			const r = await post('/api/dashboard/devices', {
				deviceId,
				location: { name: chosenCity.label, lat: chosenCity.lat, lon: chosenCity.lon },
			});
			saveWeather.disabled = false;
			if (r.ok) show('done');
			else setMsg(weatherMsg, r.error || 'Something went wrong.', true);
		});

		/* ---- style ---- */
		const saveStyle = document.getElementById('save-style') as HTMLButtonElement;
		const styleMsg = document.getElementById('style-message')!;
		saveStyle.addEventListener('click', async () => {
			const chosen = page.querySelector<HTMLInputElement>('input[name="style"]:checked');
			saveStyle.disabled = true;
			setMsg(styleMsg, '');
			const r = await post('/api/dashboard/devices', { deviceId, style: chosen ? chosen.value : 'agenda' });
			saveStyle.disabled = false;
			if (r.ok) show('weather');
			else setMsg(styleMsg, r.error || 'Something went wrong.', true);
		});

				show('pair');
	}
</script>

<style is:global>
	.setup-page {
		min-height: calc(100svh - 230px);
		display: grid;
		place-items: center;
		padding: 2em 0;
	}
	.setup-page .wizard {
		width: 100%;
		max-width: 860px;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
		text-align: center;
	}
	.setup-page .dots {
		display: flex;
		gap: 8px;
		list-style: none;
		margin: 0 0 2.2em;
		padding: 0;
	}
	.setup-page .dots li {
		width: 28px;
		height: 4px;
		border-radius: 4px;
		background: var(--border);
		transition: background 0.3s, width 0.3s;
	}
	.setup-page .dots li.on { background: var(--accent-dark); }
	.setup-page .dots li.now { background: var(--accent); width: 44px; }

	.setup-page .step { display: none; width: 100%; }
	.setup-page .step:not([data-step='style']) { max-width: 520px; margin: 0 auto; }
	/* The layout step spans the whole screen width, not the centre column. */
	html:has(.setup-page) { overflow-x: clip; }
	.setup-page .step[data-step='style'] {
		justify-self: start;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding: 0 clamp(16px, 2.5vw, 48px);
		box-sizing: border-box;
	}
	.setup-page .step[data-step='style'] .step-text { max-width: 60ch; }
	.setup-page .step.is-active {
		display: block;
		animation: step-in 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	@keyframes step-in {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: none; }
	}
	.setup-page .step-kicker {
		font-size: 0.78em;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.7em;
	}
	.setup-page .step-title {
		font-size: 1.9em;
		font-weight: 800;
		line-height: 1.15;
		color: var(--fg);
		margin-bottom: 0.5em;
	}
	.setup-page .step-text {
		color: var(--muted);
		margin: 0 auto 1.8em;
		max-width: 44ch;
	}
	.setup-page .loading-text { color: var(--muted); font-size: 0.9em; margin: 0; }

	.setup-page .btn {
		display: inline-block;
		padding: 0.75em 1.7em;
		border: 1px solid transparent;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font: inherit;
		font-weight: 700;
		font-size: 0.95em;
		text-decoration: none;
	}
	.setup-page .btn:hover:not(:disabled) { background: var(--accent); color: var(--bg); }
	.setup-page .btn:disabled { opacity: 0.5; }
	.setup-page .btn.ghost {
		background: transparent;
		color: var(--muted);
		border-color: var(--border);
	}
	.setup-page .btn.ghost:hover { color: var(--fg); background: transparent; border-color: var(--muted); }
	.setup-page .row { display: flex; gap: 0.7em; justify-content: center; margin-top: 1.6em; }
	.setup-page .link {
		margin-top: 1.4em;
		background: none;
		border: none;
		padding: 0;
		color: var(--muted);
		font: inherit;
		font-size: 0.88em;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.setup-page .link:hover { color: var(--fg); }

	.setup-page #pair-form {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1em;
	}
	.setup-page #pairing-code {
		width: 100%;
		max-width: 320px;
		padding: 0.6em 1em;
		border-radius: 16px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
		color: var(--fg);
		font: inherit;
		font-size: 2em;
		font-weight: 700;
		letter-spacing: 0.3em;
		text-indent: 0.3em;
		text-transform: uppercase;
		text-align: center;
	}
	.setup-page #pairing-code::placeholder { color: var(--muted-dim); }
	.setup-page #pairing-code:focus { outline: none; border-color: var(--accent); }
	.setup-page #pairing-code:disabled { opacity: 0.6; }

	.setup-page .msg { margin: 1em 0 0; font-size: 0.92em; color: var(--muted); }
	.setup-page .msg.is-error { color: #e08a8a; }
	.setup-page .msg:empty { display: none; }

	/* calendar toggles */
	.setup-page .cal-list {
		display: grid;
		gap: 0.6em;
		text-align: left;
		max-height: 46vh;
		overflow-y: auto;
		padding: 2px;
	}
	.setup-page .cal-opt {
		display: flex;
		align-items: center;
		gap: 0.9em;
		padding: 0.9em 1.1em;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 14px;
		color: var(--fg);
		transition: border-color 0.2s, background 0.2s;
	}
	.setup-page .cal-opt:hover { border-color: var(--muted); }
	.setup-page .cal-opt:has(input:checked) { border-color: var(--accent); background: rgba(var(--accent-rgb), 0.08); }
	.setup-page .cal-opt input,
	.setup-page .style-opt input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.setup-page .cal-opt .box {
		flex: 0 0 auto;
		width: 22px;
		height: 22px;
		border-radius: 7px;
		border: 2px solid var(--muted-dim);
		display: grid;
		place-items: center;
		transition: background 0.2s, border-color 0.2s;
	}
	.setup-page .cal-opt .box::after {
		content: '';
		width: 6px;
		height: 11px;
		border: solid var(--bg);
		border-width: 0 2.5px 2.5px 0;
		transform: translateY(-1px) rotate(45deg) scale(0);
		transition: transform 0.18s;
	}
	.setup-page .cal-opt input:checked + .box { background: var(--accent); border-color: var(--accent); }
	.setup-page .cal-opt input:checked + .box::after { transform: translateY(-1px) rotate(45deg) scale(1); }
	.setup-page .cal-opt input:focus-visible + .box { outline: 2px solid var(--accent); outline-offset: 2px; }
	.setup-page .cal-name { overflow-wrap: anywhere; }
	.setup-page .cal-name em {
		font-style: normal;
		font-size: 0.72em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.15em 0.6em;
		margin-left: 0.5em;
	}

	/* layout picker */
	.setup-page .styles {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: clamp(0.8em, 1.4vw, 1.6em);
		text-align: left;
	}
	.setup-page .style-card {
		display: grid;
		gap: 0.3em;
		padding: clamp(0.5em, 0.8vw, 0.9em);
		height: 100%;
		align-content: start;
		background: var(--bg-raised);
		border: 2px solid var(--border);
		border-radius: 14px;
		transition: border-color 0.2s, background 0.2s;
	}
	.setup-page .style-opt:hover .style-card { border-color: var(--muted); }
	.setup-page .style-opt input:checked + .style-card {
		border-color: var(--accent);
		background: rgba(var(--accent-rgb), 0.08);
	}
	.setup-page .style-opt input:focus-visible + .style-card { outline: 2px solid var(--accent); outline-offset: 2px; }
	.setup-page .style-img {
		aspect-ratio: 4 / 3;
		border-radius: 8px;
		background-size: cover;
		background-position: center;
		background-color: #fff;
	}
	.setup-page .style-name { font-weight: 700; color: var(--fg); font-size: clamp(0.95em, 1.2vw, 1.25em); }
	.setup-page .style-note { color: var(--muted); font-size: clamp(0.78em, 0.95vw, 1em); line-height: 1.35; }

	.setup-page .done-mark {
		width: 64px;
		height: 64px;
		margin: 0 auto 1em;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--accent);
		color: var(--bg);
		font-size: 2em;
		font-weight: 800;
	}

	/* Only the site's circle cursor on this whole page. */
	html.has-custom-cursor .setup-page,
	html.has-custom-cursor .setup-page * { cursor: none !important; }

	@media (max-width: 800px) {
		.setup-page .styles { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
	}
	@media (max-width: 560px) {
		.setup-page .step-title { font-size: 1.6em; }
	}
</style>
