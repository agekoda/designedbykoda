---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getSessionUserId } from '../lib/session';

const env = Astro.locals.runtime?.env ?? {};
const db = env.DB;
let userId: string | null = null;
if (db) {
	userId = await getSessionUserId(Astro.request, db);
}
---

<Layout
	title="Device setup — designedbykoda"
	description="Connect your Google Calendar and pair your E-Ink Calendar."
>
	<div class="setup-page">
		<h1>Set up your E-Ink Calendar</h1>

		{
			!userId ? (
				<div class="setup-card">
					<p>Sign in with Google to connect your calendar.</p>
					<a class="button" data-magnetic href="/api/auth/google/start">
						Sign in with Google
					</a>
				</div>
			) : (
				<div class="setup-card">
					<p>
						Enter the pairing code shown on your device's screen — it's under "Almost
						there!" on the display.
					</p>
					<form id="pair-form" novalidate>
						<label for="pairing-code" class="sr-only">Pairing code</label>
						<input
							type="text"
							id="pairing-code"
							placeholder="XXXXXX"
							maxlength="6"
							autocomplete="off"
							autocapitalize="characters"
							required
						/>
						<button type="submit" data-magnetic>Pair device</button>
					</form>
					<p id="pair-message" aria-live="polite"></p>
				</div>
			)
		}
	</div>
</Layout>

<script>
	const form = document.getElementById('pair-form');
	if (form) {
		const input = document.getElementById('pairing-code') as HTMLInputElement;
		const button = form.querySelector('button') as HTMLButtonElement;
		const message = document.getElementById('pair-message') as HTMLParagraphElement;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const code = input.value.trim().toUpperCase();
			if (!code) return;

			button.disabled = true;
			input.disabled = true;
			button.textContent = 'Pairing…';
			message.textContent = '';
			message.classList.remove('is-error');

			try {
				const res = await fetch('/api/dashboard/devices/pair', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ pairingCode: code }),
				});
				const data = await res.json().catch(() => ({}));

				if (res.ok && data.ok) {
					form.style.display = 'none';
					message.textContent =
						"Device paired! It'll pick up your calendar on its next refresh.";
				} else {
					message.textContent = data.error || 'Something went wrong — try again.';
					message.classList.add('is-error');
					button.disabled = false;
					input.disabled = false;
					button.textContent = 'Pair device';
				}
			} catch {
				message.textContent = 'Something went wrong — try again.';
				message.classList.add('is-error');
				button.disabled = false;
				input.disabled = false;
				button.textContent = 'Pair device';
			}
		});
	}
</script>

<style>
	.setup-page {
		max-width: 520px;
		margin: 0 auto;
		padding: 2em 0;
	}
	.setup-page h1 {
		margin-bottom: 0.6em;
	}
	.setup-card {
		padding: 1.5em 1.6em;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 14px;
	}
	.setup-card p {
		color: var(--muted);
		margin: 0 0 1.2em 0;
	}
	.setup-card form {
		display: flex;
		gap: 0.6em;
		flex-wrap: wrap;
	}
	.setup-card input {
		flex: 1 1 160px;
		min-width: 0;
		padding: 0.7em 1em;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--fg);
		font-family: inherit;
		font-size: 1.1em;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		text-align: center;
	}
	.setup-card input::placeholder {
		color: var(--muted-dim);
		letter-spacing: 0.15em;
	}
	.setup-card input:focus {
		outline: none;
		border-color: var(--accent-dark);
	}
	.setup-card button {
		flex: 0 0 auto;
		padding: 0.7em 1.4em;
		border: none;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font-weight: 700;
		font-size: 0.95em;
		font-family: inherit;
		cursor: pointer;
	}
	.setup-card button:hover:not(:disabled) {
		background: var(--accent);
	}
	.setup-card button:disabled,
	.setup-card input:disabled {
		opacity: 0.6;
		cursor: default;
	}
	#pair-message {
		margin: 1em 0 0 0;
		font-size: 0.92em;
		color: var(--muted);
	}
	#pair-message.is-error {
		color: #e08a8a;
	}
	#pair-message:empty {
		display: none;
	}
	.setup-card .button {
		display: inline-block;
		padding: 0.7em 1.4em;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font-weight: 700;
		font-size: 0.95em;
	}
	.setup-card .button:hover {
		background: var(--accent);
		color: var(--bg);
	}
</style>
