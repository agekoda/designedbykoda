---
// The page a shared message link opens: a phone-friendly box to leave a message on someone's
// calendar. No account; the secret in the link is the permission. Kept out of search engines.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { isToken, EXPIRY_CHOICES, MAX_BODY, MAX_AUTHOR } from '../../lib/messages';

const token = Astro.params.token ?? '';
const db = Astro.locals.runtime?.env?.DB;
let name: string | null = null;
let ok = false;
if (db && isToken(token)) {
	try {
		const r = await db.prepare('SELECT name FROM devices WHERE msg_token = ? AND user_id IS NOT NULL').bind(token).first();
		if (r) {
			ok = true;
			name = r.name || null;
		}
	} catch {}
}
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!ok) Astro.response.status = 404;
const choices = EXPIRY_CHOICES.filter((c) => c.id !== 'never');
---

<Layout title={ok ? 'Send a message' : 'Link not found'} description="Leave a message on an E-Ink Calendar." noindex>
	<div class={ok ? 'mlink wide' : 'mlink'} data-token={token}>
		{
			ok ? (
				<>
					<div class="intro">
						<p class="kicker">E-Ink Calendar</p>
						<h1>Send a message{name ? ` to ${name}` : ''}</h1>
						<p class="sub">It shows up on the calendar's screen the next time it updates.</p>
						<div class="preview">
							<canvas id="screen" width="675" height="506" aria-label="How your message will look on the calendar" />
							<p class="cap">How it will look on the calendar</p>
						</div>
					</div>
					<form id="form">
						<label class="fld">
							<span class="lab">Message</span>
							<textarea id="text" rows="4" maxlength={MAX_BODY} placeholder="Dinner at 7!" required />
							<span class="count" id="count">0 / {MAX_BODY}</span>
						</label>
						<label class="fld">
							<span class="lab">Your name</span>
							<input id="author" maxlength={MAX_AUTHOR} placeholder="So they know who it's from" autocomplete="given-name" />
						</label>
						<div class="lab">Show it for</div>
						<div class="seg" id="exp">
							{choices.map((c) => (
								<label>
									<input type="radio" name="exp" value={c.id} checked={c.id === 'tonight'} />
									<span>{c.label}</span>
								</label>
							))}
						</div>
						<button type="submit" class="go" id="go">Send</button>
						<p class="note" id="note" aria-live="polite" />
						<p class="foot">Made by <a href="/projects/eink-calendar/">designedbykoda</a></p>
					</form>
				</>
			) : (
				<>
					<h1>This link doesn't work</h1>
					<p class="sub">It may have been turned off or replaced. Ask whoever sent it for a new one.</p>
				</>
			)
		}
	</div>
</Layout>

<script>
	import { renderPreview, paintScreen } from '../../lib/eink/previewKit';
	const root = document.querySelector('.mlink') as HTMLElement;
	const form = document.getElementById('form') as HTMLFormElement | null;
	if (form) {
		const text = document.getElementById('text') as HTMLTextAreaElement;
		const author = document.getElementById('author') as HTMLInputElement;
		const note = document.getElementById('note')!;
		const go = document.getElementById('go') as HTMLButtonElement;
		const count = document.getElementById('count')!;
		try {
			author.value = localStorage.getItem('msgAuthor') ?? '';
		} catch {}
		text.addEventListener('input', () => {
			count.textContent = `${text.value.length} / ${text.maxLength}`;
			drawPreview();
		});
		author.addEventListener('input', drawPreview);

		// The Message board with this message on it, as the calendar will draw it.
		const canvas = document.getElementById('screen') as HTMLCanvasElement;
		let pending = false;
		function drawPreview() {
			if (pending || !canvas || !canvas.offsetParent) return; // hidden on phones
			pending = true;
			requestAnimationFrame(async () => {
				pending = false;
				const nowLocal = Math.floor(Date.now() / 1000) - new Date().getTimezoneOffset() * 60;
				const body = text.value.trim() || text.placeholder;
				try {
					const r = await renderPreview({ style: 'messages', dark: false, hasWeather: false, vbat: null, messages: [{ author: author.value.trim(), body, atLocal: nowLocal }] });
					const dpr = window.devicePixelRatio || 1;
					const k = Math.max(1, Math.floor(((canvas.parentElement as HTMLElement).clientWidth * dpr) / 675));
					paintScreen(canvas, r.px, { mode: 'device', scale: k });
					canvas.style.width = canvas.width / dpr + 'px';
				} catch {}
			});
		}
		drawPreview();
		addEventListener('resize', drawPreview);
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!text.value.trim()) return;
			go.disabled = true;
			note.textContent = 'Sending…';
			note.className = 'note';
			try {
				localStorage.setItem('msgAuthor', author.value);
			} catch {}
			const expires = (form.querySelector('input[name="exp"]:checked') as HTMLInputElement)?.value ?? 'tonight';
			try {
				const r = await fetch('/api/m/' + encodeURIComponent(root.dataset.token!), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: text.value, author: author.value, expires }) });
				const d = await r.json().catch(() => ({}));
				if (!r.ok || d.error) throw new Error(d.error || 'Couldn’t send that. Try again.');
				text.value = '';
				count.textContent = `0 / ${text.maxLength}`;
				note.textContent = 'Sent! It’ll show on the calendar the next time it updates.';
				note.className = 'note ok';
			} catch (err: any) {
				note.textContent = err.message;
				note.className = 'note err';
			}
			go.disabled = false;
		});
	}
</script>

<style>
	.mlink { max-width: 460px; margin: 0 auto; padding: 0.5em 0 3em; }
	.preview { display: none; }
	/* desktop: the heading and a preview of the screen on the left, the form on the right */
	@media (min-width: 900px) {
		.mlink.wide { max-width: 1040px; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 3.5em; align-items: start; padding-top: 1.5em; }
		.mlink.wide form { padding: 1.6em 1.6em 1.2em; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 20px; }
		.mlink.wide textarea, .mlink.wide input:not([type='radio']), .mlink.wide .seg { background: var(--bg); }
		.mlink.wide .preview { display: block; }
		.mlink.wide .foot { margin-top: 1.4em; }
	}
	.preview canvas { display: block; max-width: 100%; height: auto; border-radius: 14px; }
	.cap { margin: 0.6em 0 0; text-align: center; font-size: 0.82em; color: var(--muted); }
	.kicker { margin: 0; font-size: 0.75em; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
	h1 { font-size: clamp(1.7em, 7vw, 2.3em); line-height: 1.1; margin: 0.2em 0 0.3em; }
	.sub { color: var(--muted); margin: 0 0 1.6em; }
	.fld { display: block; position: relative; margin-bottom: 1.1em; }
	.lab { display: block; font-size: 0.74em; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.45em; }
	textarea, input:not([type='radio']) { width: 100%; box-sizing: border-box; background: var(--bg-raised); color: var(--fg); border: 1px solid var(--border); border-radius: 14px; padding: 0.8em 0.95em; font: inherit; font-size: 1.05em; }
	textarea { resize: vertical; line-height: 1.4; }
	textarea:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
	.count { position: absolute; right: 0.9em; bottom: 0.7em; font-size: 0.75em; color: var(--muted-dim); }
	input[type='radio'] { position: absolute; opacity: 0; pointer-events: none; }
	.seg { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 16px; padding: 4px; margin-bottom: 1.4em; }
	.seg span { display: block; padding: 0.6em; border-radius: 12px; text-align: center; font-weight: 600; font-size: 0.92em; color: var(--muted); cursor: pointer; }
	.seg input:checked + span { background: var(--fg); color: var(--bg); }
	.seg input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
	.go { width: 100%; padding: 0.9em; border: none; border-radius: 999px; background: var(--fg); color: var(--bg); font: inherit; font-weight: 800; font-size: 1.05em; cursor: pointer; }
	.go:disabled { opacity: 0.5; }
	.note { min-height: 1.4em; margin: 0.9em 0 0; text-align: center; color: var(--muted); }
	.note.ok { color: #69b98a; }
	.note.err { color: #e08a8a; }
	.foot { margin-top: 2.5em; text-align: center; font-size: 0.8em; color: var(--muted-dim); }
	.foot a { color: inherit; }
</style>
