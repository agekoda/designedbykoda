---
// designedbykoda.com/e-ink: the E-Ink Calendar's product overview, laid out like a printed magazine
// page sitting on the dark site. Links out to pre-orders, the dashboard, setup, help, the spec sheet
// and the build story.
export const prerender = false; // the open/early-bird state changes with the date
import Layout from '../layouts/Layout.astro';
import ProjectModel from '../components/ProjectModel.astro';
import { CALENDAR_STYLES } from '../data/calendarStyles';
import { EARLY_PRICES, STANDARD_PRICES, PREORDER_OPENS, earlyBirdActive } from '../data/preorderPricing';

const now = Date.now();
const open = now >= Date.parse(PREORDER_OPENS);
const early = earlyBirdActive(now);
const price = `A$${early ? EARLY_PRICES.AUD : STANDARD_PRICES.AUD}`;
const screens = CALENDAR_STYLES.length - 1; // ready-made screens; the last is "your own design"

const gallery = ['agenda', 'week', 'month', 'countdown', 'timeline', 'moon', 'planner', 'quote'].map((id) => CALENDAR_STYLES.find((s) => s.id === id)!).filter(Boolean);
const cta = open ? 'Pre-order now' : 'Join the waitlist';
---

<Layout title="The E-Ink Calendar — designedbykoda" description="A 4.2-inch e-ink calendar that shows your Google Calendar, hangs on your wall from one screw, and runs for months between charges. Designed and assembled in Perth." image="/images/projects/eink-calendar/7.jpg" bodyClass="paper-theme">
	<article class="paper">
		<div class="mast">
			<span>Perth, Western Australia</span>
			<span>The E-Ink Calendar</span>
			<span class="r">{open ? 'Pre-orders open now' : 'Pre-orders open 30 November'}</span>
		</div>

		<section class="cover">
			<div class="tx">
				<p class="kick">designedbykoda · product overview</p>
				<h1>Your day, on paper that <i>updates itself.</i></h1>
				<p class="lede">
					I wanted something on the wall that shows me what my day looks like without lighting up, buzzing, or
					asking for anything back, so I designed one from the circuit board to the case. It reads your Google
					Calendar, hangs from a single screw, and goes months between charges.
				</p>
				<div class="go">
					<a class="b" href="/preorder/eink-calendar">{cta}</a>
					<a class="l" href="/projects/eink-calendar/">Read the build story</a>
				</div>
			</div>
			<figure class="dev">
				<canvas id="ek-device" width="900" height="760" aria-label="The E-Ink Calendar showing an agenda"></canvas>
				<figcaption>Fig. 1 — The agenda screen: today, the month, and what's next.</figcaption>
			</figure>
		</section>

		<div class="facts">
			<div><b>4.2″</b><span>e-ink, easy to read in daylight</span></div>
			<div><b>5–6 mo</b><span>between charges, updating daily</span></div>
			<div><b>{screens}</b><span>screens, or design your own</span></div>
			<div><b>{price}</b><span>{early ? 'early-bird price' : 'price'}</span></div>
		</div>

		<section class="cols">
			<div>
				<div class="n">i.</div>
				<h2>On the wall, or the desk</h2>
				<p>A keyhole on the back takes one screw, and it sits flat against the wall like a framed print. If you'd rather keep it on a desk or a bedside table, the kickstand folds out and tucks away again.</p>
			</div>
			<div>
				<div class="n">ii.</div>
				<h2>It reads your Google Calendar</h2>
				<p>Sign in once and your events turn up on their own. It wakes, draws your day, and goes back to sleep, and the picture stays on the screen even with the power off.</p>
			</div>
			<div>
				<div class="n">iii.</div>
				<h2>Made one at a time</h2>
				<p>Every board is checked, every case fitted and every screen tested by me in Perth before it's packed. Pre-orders ship by the end of February.</p>
			</div>
		</section>

		<section class="model">
			<div class="model-box"><ProjectModel src="/models/projects/eink-calendar/model.glb" alt="3D model of the E-Ink Calendar" cameraOrbit="180deg 75deg 105%" rotationSpeed="-12deg/s" /></div>
			<p class="cap">Fig. 2 — The case, in 3D. Drag to turn it around and see the keyhole and kickstand.</p>
		</section>

		<section class="photos">
			<figure class="p-big"><img src="/images/projects/eink-calendar/7.jpg" alt="The E-Ink Calendar from the side, on a blue background" loading="lazy" /><figcaption>Fig. 3 — 19 mm deep, with a USB-C port and one button on the side.</figcaption></figure>
			<figure><img src="/images/projects/eink-calendar/3.jpg" alt="Hanging on a white brick wall" loading="lazy" /><figcaption>Fig. 4 — On the wall, from one screw.</figcaption></figure>
			<figure><img src="/images/projects/eink-calendar/6.jpg" alt="Showing the month layout" loading="lazy" /><figcaption>Fig. 5 — The month layout.</figcaption></figure>
			<figure><img src="/images/projects/eink-calendar/4.jpg" alt="In dark mode on a wooden desk" loading="lazy" /><figcaption>Fig. 6 — Dark mode, on a desk.</figcaption></figure>
			<figure><img src="/images/projects/eink-calendar/5.jpg" alt="Showing the week layout" loading="lazy" /><figcaption>Fig. 7 — The week layout.</figcaption></figure>
		</section>

		<section class="screens">
			<div class="intro">
				<h2>{screens} faces for <i>one screen.</i></h2>
				<p>Pick a screen from your dashboard, change the font, go dark, swap screens at set times, or drag together your own in the builder and share it with a link.</p>
				<a class="l" href="/dashboard">Open your dashboard</a>
			</div>
			<div class="sg">
				{gallery.map((s) => (
					<figure>
						<img src={s.image} alt={`${s.label} screen`} loading="lazy" />
						<figcaption>{s.label}</figcaption>
					</figure>
				))}
			</div>
		</section>

		<section class="spec">
			<h2>At a glance</h2>
			<dl>
				<div><dt>Screen</dt><dd>4.2″ e-paper, 400 × 300</dd></div>
				<div><dt>Size</dt><dd>95.8 × 93.8 × 19 mm, 114 g</dd></div>
				<div><dt>Battery</dt><dd>450 mAh, about 5–6 months</dd></div>
				<div><dt>Charging</dt><dd>USB-C, about 2.5 hours</dd></div>
				<div><dt>Mounting</dt><dd>Keyhole, kickstand, adhesive strips</dd></div>
				<div><dt>Connects to</dt><dd>2.4 GHz Wi-Fi, Google Calendar</dd></div>
				<div><dt>Languages</dt><dd>English, 日本語</dd></div>
				<div><dt>Warranty</dt><dd>1 year</dd></div>
			</dl>
			<a class="l" href="/projects/eink-calendar/specs">The full spec sheet</a>
		</section>

		<section class="toc">
			<h2>Everything else</h2>
			<a class="row" href="/preorder/eink-calendar"><span>01</span><b>{open ? 'Pre-order' : 'Pre-orders and the waitlist'}</b><em>{open ? `${price}, ships by the end of February` : 'Opening 30 November'}</em></a>
			<a class="row" href="/projects/eink-calendar/"><span>02</span><b>The build story</b><em>How it was designed, from the board up</em></a>
			<a class="row" href="/dashboard"><span>03</span><b>Your dashboard</b><em>Screens, settings and your orders</em></a>
			<a class="row" href="/setup"><span>04</span><b>Set up a calendar</b><em>Pair a new one in about five minutes</em></a>
			<a class="row" href="/help"><span>05</span><b>Help</b><em>Charging, Wi-Fi, and what to do if it's stuck</em></a>
			<a class="row" href="/track"><span>06</span><b>Track an order</b><em>No sign-in needed</em></a>
		</section>

		<section class="end">
			<h2>Your day, on the wall.</h2>
			<a class="b" href="/preorder/eink-calendar">{cta}</a>
		</section>
	</article>
</Layout>

<script>
	import { renderPreview, paintScreen } from '../lib/eink/previewKit';
	const cv = document.getElementById('ek-device') as HTMLCanvasElement | null;
	if (cv) {
		renderPreview({ style: 'agenda', dark: false, hasWeather: true, vbat: 4.05 })
			.then((r) => paintScreen(cv, r.px, { mode: 'device', scale: 2 }))
			.catch(() => {});
	}
</script>

<style is:global>
	@font-face { font-family: 'Instrument'; src: url('/fonts/instrument-serif.woff2') format('woff2'); font-display: swap; }
	@font-face { font-family: 'Instrument'; src: url('/fonts/instrument-serif-italic.woff2') format('woff2'); font-style: italic; font-display: swap; }
	@font-face { font-family: 'Fraunces'; src: url('/fonts/fraunces-300.woff2') format('woff2'); font-weight: 300; font-display: swap; }
	/* The whole page, header and footer included, in the printed-paper look. */
	body.paper-theme {
		--bg: #efe9df; --bg-raised: #e7e0d4; --fg: #1b1a17; --muted: #5b564d; --muted-dim: #857e72;
		--border: #cfc6b8; --accent: #a0472b; --accent-dark: #7d3620; --accent-rgb: 160, 71, 43;
		--black: 27, 26, 23; --gray: 91, 86, 77; --gray-light: 207, 198, 184; --gray-dark: 27, 26, 23;
		--gray-gradient: #efe9df, #efe9df; --box-shadow: 0 8px 30px rgba(60, 40, 20, 0.12);
		--dot: rgba(27, 26, 23, 0.1);
		--glow-blue: transparent; --glow-teal: transparent; --glow-pink: transparent; --glow-purple: transparent; --glow-center: transparent;
		background: #efe9df; color: #1b1a17;
	}
	body.paper-theme header nav > a:first-child, body.paper-theme header .logo, body.paper-theme header h2 a { font-family: 'Instrument', serif; font-weight: 400; font-size: 1.5em; letter-spacing: -0.01em; }
	body.paper-theme footer { border-top: 3px double #1b1a17; }
</style>

<style>

	.paper {
		--ink: #1b1a17; --muted: #5b564d; --rust: #a0472b; --cream: #efe9df;
		background: var(--cream); color: var(--ink);
		margin: 0.5em 0 3em; width: min(1240px, calc(100vw - 48px)); position: relative; left: 50%; transform: translateX(-50%);
		border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
	}
	.paper a { color: inherit; }
	.mast { display: grid; grid-template-columns: 1fr auto 1fr; padding: 1.1em 2.5em; border-bottom: 3px double var(--ink); font-size: 0.72em; letter-spacing: 0.16em; text-transform: uppercase; }
	.mast span:nth-child(2) { text-align: center; } .mast .r { text-align: right; }

	.cover { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--ink); }
	.cover .tx { padding: 3em 2.5em; border-right: 1px solid var(--ink); }
	.kick { margin: 0; font-size: 0.75em; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rust); }
	h1 { font-family: 'Instrument', serif; font-weight: 400; font-size: clamp(3.2em, 6.4vw, 5.6em); line-height: 0.92; letter-spacing: -0.025em; margin: 0.25em 0 0.35em; color: var(--ink); }
	h1 i, h2 i { color: var(--rust); }
	.lede { font-family: 'Fraunces', serif; font-weight: 300; font-size: 1.2em; line-height: 1.55; margin: 0 0 1.6em; }
	.lede::first-letter { font-family: 'Instrument', serif; font-size: 3.6em; float: left; line-height: 0.8; margin: 0.08em 0.12em 0 0; }
	.go { display: flex; gap: 1.2em; align-items: center; flex-wrap: wrap; }
	.b { display: inline-block; background: var(--ink); color: var(--cream) !important; padding: 0.9em 1.5em; font-weight: 700; text-decoration: none; }
	.b:hover { background: var(--rust); }
	.l { border-bottom: 1px solid var(--ink); text-decoration: none; font-size: 0.95em; }
	.l:hover { color: var(--rust) !important; border-color: var(--rust); }

	.dev { margin: 0; padding: 2.5em; display: flex; flex-direction: column; justify-content: center; }
	#ek-device { width: 100%; height: auto; display: block; border-radius: 6px; }
	.dev figcaption, .photos figcaption, .model .cap, .sg figcaption { font-family: 'Instrument', serif; font-style: italic; color: var(--muted); }
	.dev figcaption { margin-top: 0.9em; font-size: 1.05em; }

	.facts { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--ink); }
	.facts div { padding: 1.3em 1.5em 1.4em 2.5em; border-right: 1px solid var(--ink); }
	.facts div:last-child { border-right: 0; }
	.facts b { display: block; font-family: 'Instrument', serif; font-weight: 400; font-size: 2.4em; line-height: 1; }
	.facts span { font-size: 0.85em; color: var(--muted); }

	.cols { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--ink); }
	.cols > div { padding: 2.2em 2.5em 2.5em; border-right: 1px solid var(--ink); }
	.cols > div:last-child { border-right: 0; }
	.cols .n { font-family: 'Instrument', serif; font-size: 3.2em; color: var(--rust); line-height: 1; }
	.cols h2 { font-family: 'Fraunces', serif; font-weight: 300; font-size: 1.45em; margin: 0.4em 0 0.4em; color: var(--ink); }
	.cols p { margin: 0; line-height: 1.6; color: #3c3934; }

	.model { border-bottom: 1px solid var(--ink); padding: 1.5em 2.5em 2em; }
	.model-box { height: 520px; }
	.model-box :global(.model-slot), .model-box :global(model-viewer) { width: 100%; height: 100%; background: transparent; }
	.model .cap { margin: 0.4em 0 0; font-size: 1.05em; text-align: center; }
	.photos { display: grid; grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: auto auto; gap: 1.6em 1.6em; padding: 2.5em; border-bottom: 1px solid var(--ink); }
	.photos figure { margin: 0; }
	.photos img { width: 100%; height: 240px; object-fit: cover; display: block; }
	.photos .p-big { grid-row: span 2; }
	.photos .p-big img { height: calc(480px + 3.4em); }
	.photos figcaption { margin-top: 0.5em; font-size: 1em; }
	.screens { display: grid; grid-template-columns: 280px 1fr; gap: 3em; padding: 3em 2.5em; border-bottom: 1px solid var(--ink); }
	.screens h2, .spec h2, .toc h2, .end h2 { font-family: 'Instrument', serif; font-weight: 400; font-size: 3.2em; line-height: 0.95; margin: 0 0 0.35em; color: var(--ink); letter-spacing: -0.01em; }
	.screens p { line-height: 1.6; color: #3c3934; margin: 0 0 1.2em; }
	.sg { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4em 1.2em; }
	.sg figure { margin: 0; }
	.sg img { width: 100%; display: block; border: 1px solid var(--ink); background: #fff; filter: grayscale(1); }
	.sg figcaption { margin-top: 0.3em; }

	.spec { padding: 3em 2.5em; border-bottom: 1px solid var(--ink); }
	.spec dl { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 3em; margin: 0.5em 0 1.6em; }
	.spec dl div { display: flex; justify-content: space-between; gap: 1em; border-top: 1px solid var(--ink); padding: 0.75em 0; }
	.spec dt { color: var(--muted); } .spec dd { margin: 0; text-align: right; }

	.toc { padding: 3em 2.5em 2.5em; border-bottom: 1px solid var(--ink); }
	.toc .row { display: grid; grid-template-columns: 4em 1fr 1fr; align-items: center; border-top: 1px solid var(--ink); padding: 1em 0; text-decoration: none; }
	.toc .row:hover b { color: var(--rust); }
	.toc .row span { font-family: 'Instrument', serif; font-size: 1.7em; color: var(--rust); }
	.toc .row b { font-family: 'Fraunces', serif; font-weight: 300; font-size: 1.35em; }
	.toc .row em { font-style: normal; color: var(--muted); }

	.end { padding: 3.5em 2.5em; text-align: center; }
	.end h2 { font-size: 3.6em; }

	@media (max-width: 900px) {
		.paper { margin: 0.5em 0 2em; width: 100vw; }
		.mast { grid-template-columns: 1fr; gap: 0.3em; text-align: center; padding: 0.9em 1.2em; }
		.mast span, .mast .r { text-align: center; }
		.mast span:first-child { display: none; }
		.cover, .cols, .screens { grid-template-columns: 1fr; }
		.cover .tx { border-right: 0; border-bottom: 1px solid var(--ink); padding: 2em 1.3em; }
		.dev { padding: 1.5em 1.3em; }
		.facts { grid-template-columns: 1fr 1fr; }
		.facts div { padding: 1em 1.3em; border-bottom: 1px solid var(--ink); }
		.facts div:nth-child(2n) { border-right: 0; }
		.cols > div { border-right: 0; border-bottom: 1px solid var(--ink); padding: 1.6em 1.3em; }
		.cols > div:last-child { border-bottom: 0; }
		.model { padding: 1em 1.3em 1.5em; } .model-box { height: 340px; }
		.photos { grid-template-columns: 1fr 1fr; padding: 1.3em; gap: 1.2em; }
		.photos .p-big { grid-column: span 2; grid-row: auto; } .photos .p-big img { height: 260px; }
		.photos img { height: 150px; }
		.screens, .spec, .toc { padding: 2em 1.3em; gap: 1.5em; }
		.sg { grid-template-columns: 1fr 1fr; }
		.spec dl { grid-template-columns: 1fr; }
		.toc .row { grid-template-columns: 3em 1fr; }
		.toc .row em { grid-column: 2; font-size: 0.9em; }
		.screens h2, .spec h2, .toc h2 { font-size: 2.5em; }
		.end h2 { font-size: 2.6em; }
	}
</style>
