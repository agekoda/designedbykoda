---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getSessionUserId } from '../lib/session';
import CitySearchStyles from '../components/CitySearchStyles.astro';

const db = Astro.locals.runtime?.env?.DB;
const userId = db ? await getSessionUserId(Astro.request, db) : null;
// Not signed in: sign in, then come straight back here.
if (!userId) return Astro.redirect('/signin?return=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
---

<Layout title="My devices — designedbykoda" description="Manage your E-Ink Calendar devices.">
	<div class="dash">
		<div class="dash-head">
			<div>
				<div class="kicker">Your account</div>
				<div class="dash-title">My devices</div>
			</div>
			<div class="head-btns">
				<a class="btn ghost" href="/help">Help</a>
				<a class="btn" data-magnetic href="/setup?new=1">Add a device</a>
			</div>
		</div>

		<div id="orders" class="orders" hidden></div>

		<div id="devices" class="devices">
			<p class="muted">Loading your devices…</p>
		</div>

		<div class="alerts" id="alerts" hidden>
			<div class="alerts-title">Email alerts</div>
			<p class="muted small" id="alerts-to"></p>
			<label class="chk"><input type="checkbox" data-k="battery" /> <span><b>Battery low</b> · when a calendar gets down to 15%</span></label>
			<label class="chk"><input type="checkbox" data-k="offline" /> <span><b>Stopped checking in</b> · when a calendar hasn't been heard from for 2 days</span></label>
			<label class="chk"><input type="checkbox" data-k="update" /> <span><b>Updated</b> · when a calendar installs new firmware</span></label>
			<p class="note" id="alerts-msg" aria-live="polite"></p>
		</div>

		<div class="danger">
			<div class="danger-title">Delete my account</div>
			<p class="muted">
				Unpairs every calendar, disconnects Google and removes everything we store about you. Your
				calendars go back to showing a pairing code.
			</p>
			<div id="delete-area">
				<button type="button" class="link danger-link" id="delete-start">Delete my account and data</button>
			</div>
		</div>
	</div>
	<CitySearchStyles />
</Layout>

<script>
	import { createCitySearch } from '../lib/citySearch';
	// Subject names to pick from when naming classes (WA senior school, plus general ones). Any name can be typed too.
	const SUBJECTS = ['English', 'Literature', 'English as an Additional Language', 'Mathematics', 'Mathematics Methods', 'Mathematics Applications', 'Mathematics Specialist', 'Mathematics Essential', 'Science', 'Physics', 'Chemistry', 'Biology', 'Human Biology', 'Psychology', 'Earth and Environmental Science', 'Integrated Science', 'Marine and Maritime Studies', 'HASS', 'Geography', 'Modern History', 'Ancient History', 'Economics', 'Accounting and Finance', 'Business Management and Enterprise', 'Politics and Law', 'Philosophy and Ethics', 'Religion and Life', 'Career and Enterprise', 'Building & Construction', 'Engineering Studies', 'Design', 'Materials Design and Technology', 'Computer Science', 'Applied Information Technology', 'Digital Technologies', 'Automotive Engineering and Technology', 'Food Science and Technology', 'Hospitality', 'Children, Family and the Community', 'Health and PE', 'Physical Education Studies', 'PE', 'Health Studies', 'Outdoor Education', 'Sport and Recreation', 'Visual Arts', 'Drama', 'Music', 'Dance', 'Media Production and Analysis', 'Japanese', 'French', 'Italian', 'Chinese', 'Indonesian', 'German', 'Spanish', 'Workplace Learning', 'Tutor group', 'Form', 'Assembly', 'Study period'];

	// A name box with suggestions, in the same style as the city search (CitySearchStyles.astro).
	// Any text is allowed; the list just helps. The list is fixed-position so a scrolling dialog can't clip it.
	function subjectBox(value: string, placeholder: string): HTMLElement {
		const wrap = document.createElement('div');
		wrap.className = 'citysearch subj';
		wrap.innerHTML = `<input type="text" class="cs-input" role="combobox" aria-expanded="false" aria-autocomplete="list" autocomplete="off" spellcheck="false" maxlength="40" aria-label="Name on the screen" /><ul class="cs-list" role="listbox" hidden></ul>`;
		const input = wrap.querySelector('.cs-input') as HTMLInputElement;
		const list = wrap.querySelector('.cs-list') as HTMLUListElement;
		input.value = value;
		input.placeholder = placeholder;
		let items: string[] = [];
		let active = -1;
		const e = (v: string) => v.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]!);
		const close = () => {
			list.hidden = true;
			input.setAttribute('aria-expanded', 'false');
			active = -1;
		};
		const open = () => {
			const q = input.value.trim().toLowerCase();
			items = q ? SUBJECTS.filter((s) => s.toLowerCase().startsWith(q)).concat(SUBJECTS.filter((s) => !s.toLowerCase().startsWith(q) && s.toLowerCase().includes(q))) : SUBJECTS.slice();
			items = items.filter((s) => s !== input.value.trim()).slice(0, 40);
			if (!items.length) return close();
			list.innerHTML = items.map((s, i) => `<li role="option" data-i="${i}" class="${i === active ? 'on' : ''}">${e(s)}</li>`).join('');
			const r = input.getBoundingClientRect();
			Object.assign(list.style, { position: 'fixed', left: r.left + 'px', width: Math.max(r.width, 220) + 'px', top: r.bottom + 6 + 'px', right: 'auto', maxHeight: Math.max(140, Math.min(280, innerHeight - r.bottom - 16)) + 'px', zIndex: '1000' });
			list.hidden = false;
			input.setAttribute('aria-expanded', 'true');
			// the dialog scrolling would leave the list behind: close it
			const onScroll = (ev: Event) => {
				if (list.contains(ev.target as Node)) return addEventListener('scroll', onScroll, { capture: true, once: true });
				close();
			};
			addEventListener('scroll', onScroll, { capture: true, once: true });
		};
		const pick = (s: string) => {
			input.value = s;
			close();
		};
		input.addEventListener('focus', open);
		input.addEventListener('input', () => {
			active = -1;
			open();
		});
		input.addEventListener('keydown', (ev) => {
			if (list.hidden || !items.length) return;
			if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
				ev.preventDefault();
				active = (active + (ev.key === 'ArrowDown' ? 1 : items.length - 1) + (active < 0 && ev.key === 'ArrowUp' ? 1 : 0)) % items.length;
				open();
				list.querySelector('li.on')?.scrollIntoView({ block: 'nearest' });
			} else if (ev.key === 'Enter' && active >= 0) {
				ev.preventDefault();
				ev.stopPropagation();
				pick(items[active]);
			} else if (ev.key === 'Escape') {
				ev.stopPropagation();
				close();
			}
		});
		list.addEventListener('mousedown', (ev) => {
			ev.preventDefault();
			const li = (ev.target as HTMLElement).closest('li[data-i]') as HTMLElement | null;
			if (li) pick(items[+li.dataset.i!]);
		});
		input.addEventListener('blur', close);
		return wrap;
	}
	import { renderPreview, paintScreen } from '../lib/eink/previewKit';
	import { batteryPercent } from '../lib/eink/battery';
	import { estimate, measured, lifeText } from '../lib/eink/batteryLife';
	import { layoutNeeds } from '../lib/eink/builder/model';
	import { CALENDAR_STYLES } from '../data/calendarStyles';
	import { ask } from '../lib/dialog';
	const list = document.getElementById('devices')!;

	const esc = (v: string) =>
		v.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

	async function post(url: string, body: unknown) {
		try {
			const res = await fetch(url, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});
			const data = await res.json().catch(() => ({}));
			return { ok: res.ok && data.ok, error: data.error as string | undefined };
		} catch {
			return { ok: false, error: undefined };
		}
	}

	function ago(sec: number) {
		const d = Math.max(0, Math.floor(Date.now() / 1000) - sec);
		if (d < 90) return 'just now';
		if (d < 3600) return `${Math.round(d / 60)} min ago`;
		if (d < 86400) return `${Math.round(d / 3600)} h ago`;
		return `${Math.round(d / 86400)} d ago`;
	}

	const hhmm = (unix: number) => {
		const t = new Date(unix * 1000);
		if (t.getHours() === 0 && t.getMinutes() === 0) return 'Midnight';
		if (t.getHours() === 12 && t.getMinutes() === 0) return 'Midday';
		return t.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', hour12: false });
	};
	const dayTime = (unix: number) => {
		const t = new Date(unix * 1000);
		const days = Math.floor((Date.now() - t.getTime()) / 86400000);
		return days < 6 ? t.toLocaleDateString(undefined, { weekday: 'long' }) : t.toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
	};
	// the screens a calendar can show: the ready-made ones, then its own designs
	function screensOf(d: any): { id: string; label: string }[] {
		const ready = CALENDAR_STYLES.filter((s) => !s.builder || d.designs === null).map((s) => ({ id: s.id, label: s.label }));
		const mine = (d.designs ?? []).map((x: any) => ({ id: 'design:' + x.id, label: x.name }));
		return [...ready, ...mine];
	}
	const labelIn = (d: any, id: string) => screensOf(d).find((x) => x.id === id)?.label ?? 'Your design';
	const layoutFor = (d: any, id: string) => (id.startsWith('design:') ? d.designs?.find((x: any) => 'design:' + x.id === id)?.layout ?? null : id === 'custom' ? d.custom ?? null : null);
	// does this screen show messages? The Message board, or a design with a Messages widget
	const showsMsgs = (d: any, id: string) => id === 'messages' || !!layoutFor(d, id)?.widgets?.some((w: any) => w.t === 'messages');

	// A small line graph of battery % over time (readings every few hours, up to 60 days).
	function battGraph(points: [number, number][]): string {
		if (points.length < 2) return '<p class="muted small">Not enough readings yet. It saves one every few hours, so check back in a day or two.</p>';
		const W = 600, H = 90, P = 4;
		const t0 = points[0][0], t1 = Math.max(points[points.length - 1][0], t0 + 1);
		const x = (t: number) => P + ((t - t0) / (t1 - t0)) * (W - 2 * P);
		const y = (pct: number) => P + (1 - pct / 100) * (H - 2 * P);
		const pts = points.map(([t, mv]) => [x(t), y(batteryPercent(mv / 1000))]);
		const line = pts.map(([a, b], i) => `${i ? 'L' : 'M'}${a.toFixed(1)},${b.toFixed(1)}`).join('');
		const area = `${line}L${pts[pts.length - 1][0].toFixed(1)},${H - P}L${pts[0][0].toFixed(1)},${H - P}Z`;
		const days = Math.max(1, Math.round((t1 - t0) / 86400));
		const fmt = (t: number) => new Date(t * 1000).toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
		return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" class="bgraph" role="img" aria-label="Battery over the last ${days} days">
			<line x1="0" x2="${W}" y1="${y(50)}" y2="${y(50)}" class="g50" vector-effect="non-scaling-stroke"/>
			<path d="${area}" class="ga"/><path d="${line}" class="gl" vector-effect="non-scaling-stroke"/></svg>
			<div class="bgraph-x"><span>${fmt(t0)}</span><span>Battery, last ${days} day${days === 1 ? '' : 's'} · line is 50%</span><span>${fmt(t1)}</span></div>`;
	}

	let allCalendars: { id: string; summary: string; primary: boolean }[] | null = null;

	function flash(el: HTMLElement, text: string, err = false) {
		el.textContent = text;
		el.classList.toggle('is-error', err);
		el.classList.add('show');
		clearTimeout((el as any)._t);
		if (!err) (el as any)._t = setTimeout(() => el.classList.remove('show'), 1800);
	}

	let allDevices: any[] = [];
	function render(devices: any[]) {
		if (!devices.length) {
			list.innerHTML = `<div class="empty"><div class="dev-name-static">No devices yet</div><p class="muted">Pair your first E-Ink Calendar to get started.</p><a class="btn" href="/setup?new=1">Set up a device</a></div>`;
			return;
		}
		list.innerHTML = '';
		allDevices = devices;
		devices.forEach((d, i) => list.appendChild(card(d, i)));
	}

	function card(d: any, index: number): HTMLElement {
		const el = document.createElement('article');
		el.className = 'dev';
		const interval = 86400; // every layout wakes at least once a day
		let status = '<span class="dot off"></span>Hasn\'t checked in yet';
		let alert = '';
		if (d.lastSeenAt) {
			const late = Date.now() / 1000 - d.lastSeenAt > interval + 3 * 3600;
			status = `<span class="dot ${late ? 'bad' : 'on'}"></span>Checked in ${ago(d.lastSeenAt)}`;
			if (late) {
				el.classList.add('warn');
				alert = `<div class="alert"><b>Hasn\'t checked in since ${esc(dayTime(d.lastSeenAt))}.</b> Press its button. If the screen doesn\'t change, charge it for an hour. If it still doesn\'t, it may not be reaching your Wi-Fi. <a href="/help#trouble">More help</a></div>`;
			}
		}
		let battery = '';
		if (d.batteryMv) {
			const v = d.batteryMv / 1000;
			const pct = batteryPercent(v);
			const needs = pct <= 10;
			if (needs) el.classList.add('warn');
			// days left: from real use once there's enough of it, else from the settings
			const real = measured(d.batteryAnchorMv, d.batteryAnchorAt, d.batteryMv, d.batteryAt);
			const live = layoutNeeds(layoutFor(d, d.style)).live || d.style === 'room' || d.style === 'nameplate';
			const left = real ? real.left : (estimate({ style: d.style, refreshSec: d.refreshIntervalSec, schedule: d.schedule, live, msgCheck: d.msgCheck }) * pct) / 100;
			const leftText = needs ? ' · Needs charging' : pct >= 99 && !real ? '' : ` · ${lifeText(left)} left`;
			battery = `<span class="sep">·</span><button type="button" data-batt aria-expanded="false" class="batt${needs ? ' needs' : ''}" title="Battery level${d.batteryAt ? ', ' + ago(d.batteryAt) : ''}${real ? '. Time left is from how fast it has actually been using its battery.' : '. Time left is an estimate from its settings.'}"><span class="batt-icon ${needs ? 'flat' : pct < 20 ? 'low' : ''}"><i style="width:${Math.max(6, pct)}%"></i></span>${pct}%${leftText}<span class="caret" aria-hidden="true">▾</span></button>`;
		}
		const paired = d.createdAt ? new Date(d.createdAt * 1000).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) : '';
		el.innerHTML = `
			<div class="dev-left">
				<a class="dev-preview" data-preview href="/dashboard/display?device=${encodeURIComponent(d.id)}" aria-label="Customize this display"><canvas data-canvas width="800" height="600"></canvas><span class="dev-preview-cap">Preview</span></a>
				<div class="cals">
					<div class="label">Calendars</div>
					<div class="cal-list" data-cals><p class="muted small">Loading calendars…</p></div>
					<div class="label">Timetables and other calendars</div>
					<div class="feed-list" data-feeds></div>
					<button type="button" class="link feed-add" data-feed-add>+ Add a school timetable or calendar</button>
					<button type="button" class="link feed-add" data-classes hidden>Name your classes</button>
				</div>
			</div>
			<div class="dev-body">
				<input class="dev-name" maxlength="40" value="${esc(d.name)}" placeholder="E-Ink Calendar${index ? ' ' + (index + 1) : ''}" aria-label="Device name" />
				${alert}
				<div class="dev-meta">${status}${battery}</div>
				<div class="batt-hist" data-bhist hidden></div>
				<div class="onnow" data-onnow></div>
				<div class="actions">
					<a class="btn customize" href="/dashboard/display?device=${encodeURIComponent(d.id)}">Customize display</a>
					<a class="btn ghost customize" data-msgbtn href="/dashboard/messages?device=${encodeURIComponent(d.id)}">Messages${d.msgCount ? ` <span class="msg-count">${d.msgCount}</span>` : ''}</a>
				</div>
				<form class="quick" data-quick hidden>
					<div class="label">Quick message</div>
					<div class="qrow"><input class="txt" data-qtext maxlength="140" placeholder="Type a message for the screen…" autocomplete="off" /><button type="submit" class="btn small">Send</button></div>
				</form>

				<p class="note" data-note aria-live="polite"></p>
				<div class="weather">
					<div class="label">Weather</div>
					<div data-weather></div>
					<p class="muted small weather-hint">Today's high and low. Leave empty for none.</p>
				</div>

				<div class="daycfg">
					<div class="label">Away and quiet hours</div>
					<div class="feed-list" data-dc-list></div>
					<button type="button" class="link feed-add" data-away-add>+ Add away dates</button>
					<button type="button" class="link feed-add" data-quiet-add>+ Add quiet hours</button>
				</div>

				<div class="dev-foot">
					${paired ? `<span class="muted small paired">Paired ${paired}</span>` : ''}
					${d.firmware ? `<span class="muted small paired">Firmware ${esc(d.firmware)}</span>` : ''}
					${d.update ? `<button type="button" class="link copy-link" data-update>${d.update.asked ? 'Update waiting: press the button' : `Update to ${esc(d.update.version)}`}</button>` : ''}
					<button type="button" class="link copy-link" data-copy hidden>Copy settings to…</button>
					<span data-foot><button type="button" class="link danger-link" data-unpair>Unpair this device</button></span>
				</div>
			</div>`;

		const note = el.querySelector('[data-note]') as HTMLElement;
		// Live preview of this device's display (sample events, real layout/font/dark settings).
		const canvas = el.querySelector('[data-canvas]') as HTMLCanvasElement;
		let cornerImage: Uint8Array | null = null;
		if (d.cornerBits) {
			try {
				const bin = atob(d.cornerBits);
				cornerImage = Uint8Array.from(bin, (c) => c.charCodeAt(0));
			} catch {}
		}
		// what the next update puts on the screen (your saved choice, the schedule or a button pick)
		const onScreen = d.nextStyle ?? d.style;
		const nowShowing = d.shownStyle ?? onScreen; // what the calendar was last sent
		let frameImage: Uint8Array | null = null;
		if (d.frameBits && onScreen === 'frame') {
			try {
				frameImage = Uint8Array.from(atob(d.frameBits), (c) => c.charCodeAt(0));
			} catch {}
		}
		// The preview is what's on the calendar now (the "Showing" line says if that's about to change).
		renderPreview({ style: nowShowing.startsWith('design:') ? 'custom' : nowShowing, unit: d.unit, clock: d.clock, font: d.font, dark: !!d.dark, hasWeather: !!d.location, vbat: d.batteryMv ? d.batteryMv / 1000 : null, cornerImage, refreshSec: nowShowing === 'timeline' ? d.refreshIntervalSec : 86400, loc: d.location ? { lat: d.location.lat, lon: d.location.lon } : null, countdown: d.countdown ?? null, frameImage, custom: layoutFor(d, nowShowing), sign: d.sign ?? null, reminders: d.reminders ?? [], habits: d.habits ?? [] })
			.then((r) => paintScreen(canvas, r.px, { mode: 'screen', scale: 2 }))
			.catch(() => {});

		// what's on it now, and when it next updates
		const onnow = el.querySelector('[data-onnow]') as HTMLElement;
		const next = d.nextWakeAt && d.nextWakeAt > Date.now() / 1000 ? ` <span class="sep">·</span> next update <b>${hhmm(d.nextWakeAt)}</b>` : '';
		const when = d.nextWakeAt && d.nextWakeAt > Date.now() / 1000 ? hhmm(d.nextWakeAt) : '';
		onnow.innerHTML = !d.lastSeenAt
			? ''
			: nowShowing !== onScreen
				? `Showing <b>${esc(labelIn(d, nowShowing))}</b> <span class="sep">·</span> <b>${esc(labelIn(d, onScreen))}</b> from ${when ? when : 'the next update'} or a button press`
				: `Showing <b>${esc(labelIn(d, onScreen))}</b>${next}`;

		const quick = el.querySelector('[data-quick]') as HTMLFormElement;
		const syncQuick = () => (quick.hidden = !(showsMsgs(d, onScreen) || showsMsgs(d, nowShowing)));
		syncQuick();
		// battery history: click the battery to open a small graph
		const battBtn = el.querySelector<HTMLButtonElement>('[data-batt]');
		const bhist = el.querySelector('[data-bhist]') as HTMLElement;
		battBtn?.addEventListener('click', async () => {
			const open = bhist.hidden;
			bhist.hidden = !open;
			battBtn.setAttribute('aria-expanded', String(open));
			battBtn.classList.toggle('open', open);
			if (!open || bhist.dataset.loaded) return;
			bhist.innerHTML = '<p class="muted small">Loading…</p>';
			try {
				const r = await (await fetch('/api/dashboard/battery?deviceId=' + encodeURIComponent(d.id))).json();
				if (!r.ok) throw new Error(r.error || 'Could not load the battery history.');
				bhist.dataset.loaded = '1';
				bhist.innerHTML = battGraph(r.points as [number, number][]);
			} catch (err: any) {
				bhist.innerHTML = `<p class="muted small">${esc(err?.message || 'Could not load the battery history.')}</p>`;
			}
		});

		// quick message
		const qtext = el.querySelector('[data-qtext]') as HTMLInputElement;
		quick.addEventListener('submit', async (e) => {
			e.preventDefault();
			const text = qtext.value.trim();
			if (!text) return qtext.focus();
			const btn = quick.querySelector('button')!;
			btn.disabled = true;
			const r = await post('/api/dashboard/messages', { deviceId: d.id, action: 'send', text, expires: 'tonight' });
			btn.disabled = false;
			if (r.ok) {
				qtext.value = '';
				d.msgCount = (d.msgCount || 0) + 1;
				el.querySelector('[data-msgbtn]')!.innerHTML = `Messages <span class="msg-count">${d.msgCount}</span>`;
				flash(note, 'Sent. It shows until midnight, from the next update.');
			} else flash(note, r.error || 'Could not send.', true);
		});

		// name: saves when you leave the box or press Enter
		const nameInput = el.querySelector('.dev-name') as HTMLInputElement;
		let lastName = d.name;
		const saveName = async () => {
			const v = nameInput.value.trim();
			if (v === lastName) return;
			const r = await post('/api/dashboard/devices', { deviceId: d.id, name: v });
			if (r.ok) { lastName = v; flash(note, 'Saved'); } else flash(note, r.error || 'Could not save the name.', true);
		};
		nameInput.addEventListener('change', saveName);
		nameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') nameInput.blur(); });

		// calendars: saves shortly after you stop toggling
		const calBox = el.querySelector('[data-cals]') as HTMLElement;
		const drawCalendars = () => {
			if (!allCalendars) {
				calBox.innerHTML = '<p class="muted small">Couldn\'t load your calendars right now.</p>';
				return;
			}
			const sel: string[] = d.calendarIds.length ? d.calendarIds : allCalendars.filter((c) => c.primary).map((c) => c.id);
			calBox.innerHTML = allCalendars
				.map((c) => `<label class="cal-opt"><input type="checkbox" value="${esc(c.id)}" ${sel.includes(c.id) ? 'checked' : ''} /><span class="box" aria-hidden="true"></span><span class="cal-name">${esc(c.summary)}${c.primary ? ' <em>primary</em>' : ''}</span></label>`)
