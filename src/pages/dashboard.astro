		// class names for school timetables (src/lib/classes.ts)
		const clsBtn = el.querySelector('[data-classes]') as HTMLButtonElement;
		const showClsBtn = () => (clsBtn.hidden = !feeds.length);
		const _drawFeeds = drawFeeds;
		drawFeeds = () => {
			_drawFeeds();
			showClsBtn();
		};
		clsBtn.addEventListener('click', () => openClasses(false));
		// after adding a timetable (justAdded) it opens by itself, with Skip; it stays quiet when there are no classes
		async function openClasses(justAdded: boolean) {
			if (!justAdded) flash(note, 'Loading your classes…');
			let j: any;
			try {
				j = await (await fetch('/api/dashboard/classes?deviceId=' + encodeURIComponent(d.id))).json();
			} catch {
				return flash(note, 'Could not load your classes.', true);
			}
			const list: any[] = Array.isArray(j.classes) ? j.classes : [];
			if (!list.length) return justAdded ? undefined : flash(note, 'No classes found yet. They show up once your timetable has some repeats in it.', true);
			if (!justAdded) flash(note, '');
			const body = document.createElement('div');
			body.className = 'cls-dlg';
			body.innerHTML = `
				<div class="cls-head"><span>Code</span><span>Name on the screen</span><span>Bring</span></div>
				<div class="cls-list">${list
					.map(
						(c) => `<div class="cls-row" data-code="${esc(c.code)}">
							<div class="cls-code"><b>${esc(c.code)}</b><span>${c.room ? esc(c.room) + ' · ' : ''}${c.count ? c.count + '×' : 'not on now'}</span></div>
							<div data-nslot></div>
							<input class="x-dlg-field" data-b maxlength="40" placeholder="Nothing" value="${esc(c.bring)}" autocomplete="off" />
						</div>`
					)
					.join('')}</div>
				<label class="cls-opt"><input type="checkbox" data-rooms ${j.opts?.rooms !== false ? 'checked' : ''} /> Show the room after the name</label>
				<label class="cls-opt"><input type="checkbox" data-moves ${j.opts?.moves !== false ? 'checked' : ''} /> Point out room changes</label>`;
			body.querySelectorAll<HTMLElement>('.cls-row').forEach((r, i) => r.querySelector('[data-nslot]')!.replaceWith(subjectBox(list[i].name || '', list[i].code)));
			const intro = justAdded ? 'Your timetable calls classes by codes. Give them proper names now, or skip and do it later from the timetable on your dashboard.' : 'Give your class codes proper names. Pick one from the list or type your own. Bring shows on the School day screen.';
			if (!(await ask(intro, { title: 'Name your classes', ok: 'Save', cancel: justAdded ? 'Skip' : 'Cancel', body }))) return;
			const classes = [...body.querySelectorAll<HTMLElement>('.cls-row')].map((r) => ({ code: r.dataset.code, name: (r.querySelector('.cs-input') as HTMLInputElement).value.trim(), bring: (r.querySelector('[data-b]') as HTMLInputElement).value.trim() }));
			const opts = { rooms: (body.querySelector('[data-rooms]') as HTMLInputElement).checked, moves: (body.querySelector('[data-moves]') as HTMLInputElement).checked };
			const r = await post('/api/dashboard/classes', { deviceId: d.id, classes, opts });
			flash(note, r.ok ? 'Saved. Your calendar uses the names from its next update.' : r.error || 'Could not save.', !r.ok);
		}

		// away mode and quiet hours (src/lib/eink/dayCfg.ts): rows like the timetable list, added and edited in a box
		let dayCfg: any = d.dayCfg ?? { away: null, quiet: { on: false, from: 1320, to: 360 } };
		const dcList = el.querySelector('[data-dc-list]') as HTMLElement;
		const awayAdd = el.querySelector('[data-away-add]') as HTMLButtonElement;
		const quietAdd = el.querySelector('[data-quiet-add]') as HTMLButtonElement;
		const hm = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
		const mOf = (v: string) => {
			const [h, m] = v.split(':').map(Number);
			return (h || 0) * 60 + (m || 0);
		};
		const clock = (m: number) => new Date(2000, 0, 1, Math.floor(m / 60), m % 60).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
		const todayIso = () => new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
		const awayOn = () => !!dayCfg.away && dayCfg.away.until > todayIso();
		const drawDay = () => {
			const rows: string[] = [];
			if (awayOn()) {
				const when = new Date(dayCfg.away.until + 'T12:00:00').toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' });
				rows.push(`<div class="feed" data-k="away"><span class="feed-ico" aria-hidden="true">✈</span><span class="feed-t"><span class="feed-name">Away until ${esc(when)}</span><span class="feed-sub">${dayCfg.away.note ? esc(dayCfg.away.note) : 'No note'} · checks in every two days</span></span><button type="button" class="feed-edit" data-edit>Edit</button><button type="button" class="feed-del" data-del aria-label="Remove away dates">&times;</button></div>`);
			}
			if (dayCfg.quiet?.on) rows.push(`<div class="feed" data-k="quiet"><span class="feed-ico" aria-hidden="true">☾</span><span class="feed-t"><span class="feed-name">Quiet ${esc(clock(dayCfg.quiet.from))} to ${esc(clock(dayCfg.quiet.to))}</span><span class="feed-sub">No timed updates. The button still works.</span></span><button type="button" class="feed-edit" data-edit>Edit</button><button type="button" class="feed-del" data-del aria-label="Remove quiet hours">&times;</button></div>`);
			dcList.innerHTML = rows.join('');
			awayAdd.hidden = awayOn();
			quietAdd.hidden = !!dayCfg.quiet?.on;
		};
		const saveDay = async (next: any, msg: string) => {
			const r = await post('/api/dashboard/daycfg', { deviceId: d.id, cfg: next });
			if (!r.ok) return flash(note, r.error || 'Could not save.', true);
			dayCfg = next;
			drawDay();
			flash(note, msg);
		};
		const field = (label: string, input: string) => `<label class="dc-f"><span>${label}</span>${input}</label>`;
		async function editAway() {
			const body = document.createElement('div');
			body.className = 'dc-dlg';
			const cur = awayOn() ? dayCfg.away : { until: '', note: '' };
			body.innerHTML = field('Back on', `<input type="date" class="x-dlg-field" data-until min="${todayIso()}" value="${esc(cur.until)}" />`) + field('Note on the screen (optional)', `<input class="x-dlg-field" data-awaynote maxlength="60" placeholder="Camping at Margaret River" value="${esc(cur.note || '')}" autocomplete="off" />`);
			if (!(await ask('The screen says "Away until…" and the calendar only checks in every two days, which saves battery. It goes back to normal on the day you choose.', { title: 'Away dates', ok: 'Save', body }))) return;
			const until = (body.querySelector('[data-until]') as HTMLInputElement).value;
			if (!until || until <= todayIso()) return flash(note, 'Pick the day you\u2019re back.', true);
			saveDay({ ...dayCfg, away: { until, note: (body.querySelector('[data-awaynote]') as HTMLInputElement).value.trim() } }, 'Away dates saved. The screen changes at its next update, or press the button.');
		}
		async function editQuiet() {
			const body = document.createElement('div');
			body.className = 'dc-dlg';
			const q = dayCfg.quiet ?? { from: 1320, to: 360 };
			body.innerHTML = `<div class="dc-two">${field('From', `<input type="time" class="x-dlg-field" data-from value="${hm(q.from)}" />`)}${field('To', `<input type="time" class="x-dlg-field" data-to value="${hm(q.to)}" />`)}</div>`;
			if (!(await ask('No timed updates between these times, every day. Pressing the button still updates the screen.', { title: 'Quiet hours', ok: 'Save', body }))) return;
			const from = mOf((body.querySelector('[data-from]') as HTMLInputElement).value);
			const to = mOf((body.querySelector('[data-to]') as HTMLInputElement).value);
			if (from === to) return flash(note, 'Pick two different times.', true);
			saveDay({ ...dayCfg, quiet: { on: true, from, to } }, 'Quiet hours saved.');
		}
