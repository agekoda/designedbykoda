			if (!f || !(await ask(`${f.name} will stop showing on this calendar.`, { title: 'Remove this calendar?', ok: 'Remove', danger: true }))) return;
			const r = await post('/api/dashboard/feeds', { deviceId: d.id, action: 'remove', id: f.id });
			if (r.ok) {
				feeds = feeds.filter((x) => x.id !== f.id);
