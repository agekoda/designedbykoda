		// school timetables and other calendars (.ics links and files)
		const feedBox = el.querySelector('[data-feeds]') as HTMLElement;
		const feedAdd = el.querySelector('[data-feed-add]') as HTMLButtonElement;
		let feeds: any[] = [];
		let feedMax = 4;
		const feedLine = (f: any) => {
			if (f.error) return `<span class="feed-err">${esc(f.error)}</span>`;
			if (!f.count) return f.kind === 'file' ? 'Nothing coming up in this file. Upload a new one.' : 'Nothing coming up';
			const n = f.next;
			const when = n ? (n.allDay ? new Date(n.ms).toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }) : new Date(n.ms).toLocaleString(undefined, { weekday: 'short', hour: 'numeric', minute: '2-digit' })) : '';
