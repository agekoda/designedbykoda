				(u.notes ? `<p><strong>What's new:</strong> ${esc(u.notes)}</p>` : '') +
				`<p class="muted small">It needs at least a quarter of its battery. If anything goes wrong, it goes back to ${esc(d.firmware || 'the old version')} by itself.</p>`;
			const ok = await ask('After you click Update now, press the button on the calendar. It shows a progress bar, then restarts by itself. This takes about a minute.', { title: `Update to ${u.version}`, ok: 'Update now', body });
			if (!ok) return;
