---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

const env = Astro.locals.runtime?.env ?? {};

// Plain Cloudflare "Variable" type — not secrets, since none of this is
// sensitive (they're public follower/view counts). Update anytime via
// Workers & Pages → Settings → Variables and Secrets → edit the value →
// Deploy. No code change or redeploy-from-git needed for a number update.
function formatNumber(raw: string | undefined): string {
	const n = Number(raw);
	if (!raw || isNaN(n)) return '—';
	if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
	if (n >= 1_000) return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'K';
	return n.toLocaleString();
}

const stats = [
	{
		platform: 'YouTube',
		metrics: [
			{ label: 'Subscribers', value: formatNumber(env.YOUTUBE_SUBSCRIBERS) },
			{ label: 'Total views', value: formatNumber(env.YOUTUBE_VIEWS) },
		],
	},
	{
		platform: 'TikTok',
		metrics: [
			{ label: 'Followers', value: formatNumber(env.TIKTOK_FOLLOWERS) },
			{ label: 'Total views', value: formatNumber(env.TIKTOK_VIEWS) },
		],
	},
	{
		platform: 'Instagram',
		metrics: [
			{ label: 'Followers', value: formatNumber(env.INSTAGRAM_FOLLOWERS) },
			{ label: 'Total views', value: formatNumber(env.INSTAGRAM_VIEWS) },
		],
	},
];

const lastUpdated = env.STATS_LAST_UPDATED || null;
const totalViewersRaw = Number(env.TOTAL_VIEWERS_REACHED) || 0;
const totalViewersExact = totalViewersRaw ? totalViewersRaw.toLocaleString() : '—';
---

<Layout
	title="Press & Brands — designedbykoda"
	description="Channel stats and collaboration info for designedbykoda."
>
	<div class="press-page">
		<h1>Press &amp; Brands</h1>

		<div class="reach-block">
			<p class="intro">
				Stats across designedbykoda's channels — for anyone exploring a collaboration or
				sponsorship.
			</p>
			<span class="hero-value" id="hero-total" data-target={totalViewersRaw}>0</span>
			<span class="hero-label">Individual people reached across YouTube, TikTok &amp; Instagram</span>
		</div>

		<div class="stats-grid">
			{
				stats.map((s) => (
					<div class="stat-card">
						<h2>{s.platform}</h2>
						{s.metrics.map((m) => (
							<div class="metric">
								<span class="metric-value">{m.value}</span>
								<span class="metric-label">{m.label}</span>
							</div>
						))}
					</div>
				))
			}
		</div>

		{lastUpdated && <p class="updated-note">Last updated {lastUpdated}</p>}

		<div class="contact-card">
			<p>For collaboration or sponsorship enquiries, reach out via:</p>
			<a class="button" data-magnetic href="mailto:hello@designedbykoda.com">
				hello@designedbykoda.com
			</a>
		</div>
	</div>
</Layout>

<script>
	// Counts up from 0 to the real number on load — respects reduced-motion
	// preferences by just setting the final value instantly for anyone
	// who's asked their system to minimise animation.
	const el = document.getElementById('hero-total');
	if (el) {
		const target = Number(el.dataset.target || '0');
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (!target || prefersReducedMotion) {
			el.textContent = target ? target.toLocaleString() : '—';
		} else {
			const durationMs = 1600;
			const frameIntervalMs = 1000 / 30; // cap DOM text updates to 30fps —
				// requestAnimationFrame can fire 240+ times/sec on high-refresh
				// monitors, and updating text content that often reads as a
				// blurry mess rather than a smooth count. The loop below still
				// runs every frame for accurate timing, it just skips the
				// actual DOM write unless enough time has passed.
			const startTime = performance.now();
			let lastDrawTime = 0;

			function tick(now: number) {
				const elapsed = now - startTime;
				const progress = Math.min(elapsed / durationMs, 1);
				const isDone = progress >= 1;

				if (now - lastDrawTime >= frameIntervalMs || isDone) {
					// Quadratic ease-out — fast start, gentle finish, but
					// without cubic's noticeably long "hang" right at the end.
					const eased = 1 - Math.pow(1 - progress, 2);
					const current = Math.floor(eased * target);
					el.textContent = (isDone ? target : current).toLocaleString();
					lastDrawTime = now;
				}

				if (!isDone) {
					requestAnimationFrame(tick);
				}
			}
			requestAnimationFrame(tick);
		}
	}
</script>

<style>
	.press-page {
		max-width: 700px;
		margin: 0 auto;
		padding: 2em 0;
	}
	.reach-block {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
		margin-bottom: 0;
	}
	.hero-value {
		margin-top: 0.8em;
		font-size: 3.6em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.hero-label {
		margin-top: 0.4em;
		color: var(--muted);
		font-size: 0.95em;
	}
	.intro {
		color: var(--muted);
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1em;
		margin-bottom: 1em;
	}
	.stat-card {
		padding: 1.3em 1.4em;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 14px;
	}
	.stat-card h2 {
		font-size: 1em;
		color: var(--muted);
		font-weight: 700;
		margin: 0 0 1em 0;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.metric {
		display: flex;
		flex-direction: column;
		margin-bottom: 0.8em;
	}
	.metric:last-child {
		margin-bottom: 0;
	}
	.metric-value {
		font-size: 1.8em;
		font-weight: 700;
		color: var(--fg);
		line-height: 1.1;
	}
	.metric-label {
		font-size: 0.85em;
		color: var(--muted);
	}
	.updated-note {
		font-size: 0.85em;
		color: var(--muted-dim);
		margin-bottom: 2em;
	}
	.contact-card {
		padding: 1.5em 1.6em;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 14px;
		text-align: center;
	}
	.contact-card p {
		color: var(--muted);
		margin: 0 0 1em 0;
	}
	.button {
		display: inline-block;
		padding: 0.7em 1.4em;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font-weight: 700;
		font-size: 0.95em;
	}
	.button:hover {
		background: var(--accent);
		color: var(--bg);
	}
</style>
