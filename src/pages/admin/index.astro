---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { isAdmin, adminSecret } from '../../lib/admin';
import { ADMIN_LABEL, STATUSES, statusOf, orderNumber, trackingUrl, type Status } from '../../lib/orders';
import { batteryPercent } from '../../lib/eink/battery';

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'no-store');

const env = Astro.locals.runtime?.env ?? {};
const configured = !!adminSecret(env);
const unlocked = configured && (await isAdmin(Astro.cookies, env));
const wrong = Astro.url.searchParams.has('wrong');
const BATCH = 100; // first batch size

interface Order {
	id: string; created_at: number; email: string; name: string; phone: string;
	address_json: string | null; country: string; currency: string;
	amount_total: number; shipping_amount: number; shipped_at: number | null; tracking: string | null;
	status: Status; status_at: number | null; user_id: string | null; customer_note: string | null; admin_note: string | null;
	addr: Record<string, string>;
}
let orders: Order[] = [];
let dbError = '';
let hasStatus = true;
// calendars overview
let fleet = { users: 0, paired: 0, online: 0, setup: 0, low: [] as { name: string; pct: number }[], fw: [] as [string, number][] };
if (unlocked) {
	try {
		const { results } = await env.DB.prepare('SELECT * FROM orders ORDER BY created_at DESC LIMIT 2000').all();
		orders = (results ?? []).map((o: any) => {
			let addr = {};
			try { addr = o.address_json ? JSON.parse(o.address_json) : {}; } catch {}
			if (!('status' in o)) hasStatus = false;
			return { ...o, status: statusOf(o), addr };
		});
	} catch {
		dbError = 'Could not read the orders table. If you have not created it yet, run: npx wrangler d1 execute eink-calendar-db --remote --file=./schema-orders.sql';
	}
	try {
		const now = Math.floor(Date.now() / 1000);
		const u: any = await env.DB.prepare('SELECT COUNT(*) AS n FROM users').first();
		const d: any = await env.DB.prepare('SELECT COUNT(*) AS paired, SUM(CASE WHEN last_seen_at > ? THEN 1 ELSE 0 END) AS online FROM devices WHERE user_id IS NOT NULL').bind(now - 48 * 3600).first();
		const w: any = await env.DB.prepare('SELECT COUNT(*) AS n FROM devices WHERE user_id IS NULL').first();
		fleet.users = u?.n ?? 0;
		fleet.paired = d?.paired ?? 0;
		fleet.online = d?.online ?? 0;
		fleet.setup = w?.n ?? 0;
		const b = await env.DB.prepare("SELECT COALESCE(name, 'E-Ink Calendar') AS name, battery_mv FROM devices WHERE user_id IS NOT NULL AND battery_mv IS NOT NULL").all();
		fleet.low = (b.results ?? []).map((x: any) => ({ name: x.name, pct: batteryPercent(x.battery_mv / 1000) })).filter((x: any) => x.pct <= 15).sort((a: any, c: any) => a.pct - c.pct).slice(0, 8);
		const f = await env.DB.prepare('SELECT COALESCE(firmware, ?) AS fw, COUNT(*) AS n FROM devices WHERE user_id IS NOT NULL GROUP BY fw ORDER BY n DESC').bind('unknown').all();
		fleet.fw = (f.results ?? []).map((x: any) => [x.fw, x.n]);
	} catch {}
}

const live = orders.filter((o) => o.status !== 'cancelled');
const count = (st: Status) => orders.filter((o) => o.status === st).length;
const byCurrency = new Map<string, number>();
for (const o of live) byCurrency.set(o.currency || '?', (byCurrency.get(o.currency || '?') ?? 0) + (o.amount_total ?? 0));
const money = (cents: number, cur: string) => {
	try { return new Intl.NumberFormat('en-AU', { style: 'currency', currency: cur }).format(cents / 100); }
	catch { return `${(cents / 100).toFixed(2)} ${cur}`; }
};
const countries = new Map<string, number>();
for (const o of live) { const c = o.country || '?'; countries.set(c, (countries.get(c) ?? 0) + 1); }
const topCountries = [...countries.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6);
const weekAgo = Date.now() / 1000 - 7 * 86400;
const lastWeek = live.filter((o) => o.created_at > weekAgo).length;
const linked = live.filter((o) => o.user_id).length;
const addressText = (o: Order) =>
	[o.name, o.addr.line1, o.addr.line2, [o.addr.city, o.addr.state, o.addr.postal_code].filter(Boolean).join(' '), o.addr.country || o.country]
		.filter(Boolean).join('\n');
const batchPct = Math.min(100, Math.round((live.length / BATCH) * 100));
---

<Layout title="Admin - designedbykoda" description="Owner only.">
	<div class="admin">
		{!configured && (
			<div class="narrow">
				<h1>Admin isn't set up</h1>
				<p>Add a password as a Cloudflare secret, then reload:</p>
				<pre>npx wrangler secret put ADMIN_PASSWORD</pre>
			</div>
		)}

		{configured && !unlocked && (
			<div class="narrow">
				<h1>Owner area</h1>
				<form method="post" action="/api/admin/login" autocomplete="off">
					<label for="pw">Password</label>
					<div class="row">
						<input id="pw" name="password" type="password" required autocomplete="current-password" autofocus />
						<button type="submit" class="btn-p">Unlock</button>
					</div>
					{wrong && <p class="err" role="alert">Wrong password.</p>}
				</form>
			</div>
		)}

		{unlocked && (
			<>
				<div class="head">
					<div>
						<div class="kicker">Owner area</div>
						<h1>Overview</h1>
					</div>
					<div class="head-actions">
						<a class="btn" href="/api/admin/auspost" download title="Orders marked Ready to ship, for MyPost Business > Import CSV">AusPost CSV</a>
						<a class="btn" href="/api/admin/orders" download>Download CSV</a>
						<form method="post" action="/api/admin/logout"><button type="submit" class="btn">Lock</button></form>
					</div>
				</div>

				{dbError && <p class="err">{dbError}</p>}
				{!dbError && !hasStatus && orders.length > 0 && (
					<p class="err">Order statuses need a migration: npx wrangler d1 execute eink-calendar-db --remote --file=schema-order-status.sql</p>
				)}

				<section class="ov">
					<div class="ov-card big">
						<div class="ov-l">First batch</div>
						<div class="ov-n">{live.length}<span> / {BATCH}</span></div>
						<div class="meter"><i style={`width:${batchPct}%`}></i></div>
						<div class="ov-s">{lastWeek} in the last 7 days · {linked} linked to an account</div>
					</div>
					<div class="ov-card">
						<div class="ov-l">Paid</div>
						{[...byCurrency.entries()].map(([cur, cents]) => <div class="ov-n sm">{money(cents, cur)}</div>)}
						{byCurrency.size === 0 && <div class="ov-n sm">$0</div>}
						<div class="ov-s">{topCountries.map(([c, n]) => `${c} ${n}`).join(' · ') || 'No orders yet'}</div>
					</div>
					<div class="ov-card">
						<div class="ov-l">Orders by status</div>
						<ul class="by">
							{STATUSES.map((st) => (
								<li class={`st-${st}`}><span>{ADMIN_LABEL[st]}</span><b>{count(st)}</b></li>
							))}
						</ul>
					</div>
					<div class="ov-card">
						<div class="ov-l">Calendars</div>
						<ul class="by">
							<li><span>Accounts</span><b>{fleet.users}</b></li>
							<li><span>Paired</span><b>{fleet.paired}</b></li>
							<li><span>Checked in, last 48 h</span><b>{fleet.online}</b></li>
							<li><span>Waiting to pair</span><b>{fleet.setup}</b></li>
						</ul>
					</div>
					<div class="ov-card">
						<div class="ov-l">Firmware</div>
						<ul class="by">
							{fleet.fw.map(([v, n]) => <li><span>{v}</span><b>{n}</b></li>)}
							{fleet.fw.length === 0 && <li><span>No calendars yet</span></li>}
						</ul>
					</div>
					<div class="ov-card">
						<div class="ov-l">Low battery (15% or less)</div>
						<ul class="by">
							{fleet.low.map((d) => <li><span>{d.name}</span><b>{d.pct}%</b></li>)}
							{fleet.low.length === 0 && <li><span>None</span></li>}
						</ul>
					</div>
				</section>

				<h2 class="sec">Orders</h2>
				<div class="bar">
					<div class="tabs" role="tablist">
						<button class="tab on" data-tab="open" role="tab">To do <span>{orders.filter((o) => ['ordered', 'making', 'ready'].includes(o.status)).length}</span></button>
						{STATUSES.map((st) => (
							<button class="tab" data-tab={st} role="tab">{ADMIN_LABEL[st]} <span>{count(st)}</span></button>
						))}
						<button class="tab" data-tab="all" role="tab">All <span>{orders.length}</span></button>
					</div>
					<input id="q" type="search" placeholder="Search name, email, suburb, order number" aria-label="Search orders" />
				</div>

				<div class="bulk" id="bulk" hidden>
					<span id="bulk-n">0 selected</span>
					<select id="bulk-status" aria-label="New status">
						{STATUSES.map((st) => <option value={st}>{ADMIN_LABEL[st]}</option>)}
					</select>
					<button class="btn btn-p" type="button" id="bulk-go">Set status</button>
					<button class="btn" type="button" id="bulk-auspost">AusPost CSV</button>
					<button class="btn" type="button" id="bulk-clear">Clear</button>
					<span class="msg" id="bulk-msg" role="status"></span>
				</div>
				<label class="selall"><input type="checkbox" id="selall" /> Select all shown</label>

				<div id="list">
					{orders.map((o) => (
						<article class="order" data-id={o.id} data-status={o.status} data-tracking={o.tracking ?? ''}
							data-search={`${addressText(o)} ${o.email} ${o.phone} ${o.id} ${orderNumber(o.id)} ${o.tracking ?? ''}`.toLowerCase()}>
							<div class="top">
								<label class="pick"><input type="checkbox" class="sel" aria-label="Select order" /></label>
								<div class="who">
									<strong>{o.name || '(no name)'}</strong>
									<a href={`mailto:${o.email}`}>{o.email}</a>
									{o.phone && <span>{o.phone}</span>}
								</div>
								<div class="amt">
									<strong>{money(o.amount_total ?? 0, o.currency || 'AUD')}</strong>
									<span>incl. {money(o.shipping_amount ?? 0, o.currency || 'AUD')} shipping</span>
								</div>
							</div>
							<div class="mid">
								<pre class="addr">{addressText(o) || '(no address)'}</pre>
								<div class="meta">
									<span class={`pill st-${o.status}`}>{ADMIN_LABEL[o.status]}</span>
									<span>Order {orderNumber(o.id)}</span>
									<span class="when" data-ts={o.created_at}>{new Date(o.created_at * 1000).toISOString().slice(0, 16).replace('T', ' ')} UTC</span>
									{o.status_at && <span class="when" data-ts={o.status_at} data-prefix="Updated ">Updated</span>}
									<span>{o.user_id ? 'Linked to an account' : 'Not linked to an account'}</span>
								</div>
							</div>
							<div class="edit">
								<label><span>Status</span>
									<select class="status">
										{STATUSES.map((st) => <option value={st} selected={st === o.status}>{ADMIN_LABEL[st]}</option>)}
									</select>
								</label>
								<label><span>Tracking number (emails the buyer when first added) {o.tracking && trackingUrl(o.tracking) && <a href={trackingUrl(o.tracking)} target="_blank" rel="noopener">open</a>}</span>
									<input class="track" type="text" placeholder="e.g. 33ABC1234567" value={o.tracking ?? ''} maxlength="300" />
								</label>
								<label class="wide"><span>Note to the buyer (shows on their dashboard)</span>
									<input class="cnote" type="text" placeholder="e.g. Your calendar is packed and leaves Monday." value={o.customer_note ?? ''} maxlength="300" />
								</label>
								<label class="wide"><span>Private note</span>
									<input class="anote" type="text" placeholder="Only you see this" value={o.admin_note ?? ''} maxlength="500" />
								</label>
							</div>
							<div class="actions">
								<button class="btn copy" type="button" data-copy={addressText(o)}>Copy address</button>
								<button class="btn btn-p save" type="button">Save</button>
								<span class="msg" role="status"></span>
							</div>
						</article>
					))}
					{orders.length === 0 && !dbError && <p class="empty">No orders yet. They show up here the moment a payment goes through.</p>}
				</div>
				<p id="none" class="empty" hidden>Nothing matches.</p>
			</>
		)}
	</div>
</Layout>

<script>
	import { ask } from '../../lib/dialog';
	import { dropdown } from '../../lib/dropdown';
	// the site's own dropdowns instead of the browser's
	document.querySelectorAll<HTMLSelectElement>('.admin select').forEach((s) => dropdown(s));
	const list = document.getElementById('list');
	if (list) {
		let tab = 'open';
		const q = document.getElementById('q') as HTMLInputElement;
		const none = document.getElementById('none')!;
		const orders = [...list.querySelectorAll<HTMLElement>('.order')];
		const bulk = document.getElementById('bulk')!;
		const bulkN = document.getElementById('bulk-n')!;
		const selAll = document.getElementById('selall') as HTMLInputElement;

		// dates in the viewer's own time zone
		document.querySelectorAll<HTMLElement>('.when[data-ts]').forEach((el) => {
			const d = new Date(Number(el.dataset.ts) * 1000);
			el.textContent = (el.dataset.prefix ?? '') + d.toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
		});

		const selected = () => orders.filter((o) => !o.hidden && o.querySelector<HTMLInputElement>('.sel')!.checked);
		document.getElementById('bulk-auspost')?.addEventListener('click', () => {
			const ids = selected().map((o) => o.dataset.id).join(',');
			if (ids) location.href = '/api/admin/auspost?ids=' + encodeURIComponent(ids);
		});
		const syncBulk = () => {
			const n = selected().length;
			bulk.hidden = n === 0;
			bulkN.textContent = `${n} selected`;
			const shown = orders.filter((o) => !o.hidden);
			selAll.checked = shown.length > 0 && n === shown.length;
		};
		const apply = () => {
			const term = q.value.trim().toLowerCase();
			let shown = 0;
			for (const o of orders) {
				const st = o.dataset.status!;
				const okTab = tab === 'all' || (tab === 'open' ? ['ordered', 'making', 'ready'].includes(st) : st === tab);
				const ok = okTab && (!term || (o.dataset.search ?? '').includes(term));
				o.hidden = !ok;
				if (!ok) o.querySelector<HTMLInputElement>('.sel')!.checked = false;
				if (ok) shown++;
			}
			none.hidden = shown > 0 || orders.length === 0;
			syncBulk();
		};
		document.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) =>
			b.addEventListener('click', () => {
				tab = b.dataset.tab!;
				document.querySelectorAll('.tab').forEach((x) => x.classList.toggle('on', x === b));
				apply();
			})
		);
		q.addEventListener('input', apply);
		list.addEventListener('change', (e) => {
			if ((e.target as HTMLElement).classList.contains('sel')) syncBulk();
		});
		selAll.addEventListener('change', () => {
			orders.forEach((o) => {
				if (!o.hidden) o.querySelector<HTMLInputElement>('.sel')!.checked = selAll.checked;
			});
			syncBulk();
		});
		document.getElementById('bulk-clear')!.addEventListener('click', () => {
			orders.forEach((o) => (o.querySelector<HTMLInputElement>('.sel')!.checked = false));
			syncBulk();
		});

		async function post(body: object) {
			const res = await fetch('/api/admin/orders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
			const data = await res.json().catch(() => ({}));
			if (!res.ok || !data.ok) throw new Error(data.error || 'Failed');
			return data;
		}

		document.getElementById('bulk-go')!.addEventListener('click', async () => {
			const ids = selected().map((o) => o.dataset.id);
			const status = (document.getElementById('bulk-status') as HTMLSelectElement).value;
			const msg = document.getElementById('bulk-msg')!;
			if (!ids.length) return;
			const label = (document.getElementById('bulk-status') as HTMLSelectElement).selectedOptions[0].text;
			if (!(await ask(`Buyers see this on their dashboard.${status === 'shipped' ? ' Orders with a tracking number also get an \u201con its way\u201d email.' : ''}`, { title: `Set ${ids.length} order${ids.length > 1 ? 's' : ''} to ${label}?`, ok: 'Set status' }))) return;
			msg.textContent = 'Saving…';
			try {
				await post({ ids, status });
				location.reload();
			} catch (e: any) {
				msg.textContent = 'Could not save: ' + e.message;
			}
		});

		list.addEventListener('click', async (e) => {
			const t = (e.target as HTMLElement).closest('button');
			const o = (e.target as HTMLElement).closest<HTMLElement>('.order');
			if (!t || !o) return;
			const el = o.querySelector<HTMLElement>('.msg')!;
			if (t.classList.contains('copy')) {
				try {
					await navigator.clipboard.writeText(t.dataset.copy ?? '');
					el.textContent = 'Address copied';
				} catch {
					el.textContent = 'Could not copy';
				}
			} else if (t.classList.contains('save')) {
				const status = o.querySelector<HTMLSelectElement>('.status')!.value;
				const tracking = o.querySelector<HTMLInputElement>('.track')!.value;
				const hadTracking = (o.dataset.tracking ?? '') !== '';
				const firstTracking = tracking.trim() !== '' && !hadTracking && o.dataset.status !== 'delivered';
				if (firstTracking && !(await ask('This marks the order Shipped and emails the buyer that it\u2019s on its way, with the tracking link.', { title: 'Save the tracking number?', ok: 'Save and email' }))) return;
				el.textContent = 'Saving…';
				try {
					await post({
						ids: [o.dataset.id],
						status,
						tracking,
						customer_note: o.querySelector<HTMLInputElement>('.cnote')!.value,
						admin_note: o.querySelector<HTMLInputElement>('.anote')!.value,
					});
					el.textContent = 'Saved';
					if (status !== o.dataset.status || firstTracking) setTimeout(() => location.reload(), 500);
				} catch (e: any) {
					el.textContent = 'Could not save: ' + e.message;
				}
			}
		});
		apply();
	}
</script>

<style>
	.admin { max-width: 1120px; margin: 0 auto; padding: 3em 16px 5em; }
	.narrow { max-width: 420px; margin: 12vh auto; }
	h1 { margin: 0; font-size: 1.8rem; }
	.sec { font-size: 1.3rem; margin: 2em 0 0.8em; }
	.kicker { font-size: 0.8rem; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.08em; }
	.head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 22px; }
	.head-actions { display: flex; gap: 8px; }
	.head-actions form { margin: 0; }
	.narrow label { display: block; font-size: 0.8rem; opacity: 0.6; margin: 14px 0 6px; }
	.row { display: flex; gap: 8px; }
	input:not([type='checkbox']), select { min-width: 0; padding: 10px 14px; border-radius: 12px; border: 1px solid var(--border); border-style: solid; background: var(--bg-raised); color: inherit; font: inherit; font-size: 0.9rem; box-shadow: none; outline: none; -webkit-appearance: none; appearance: none; }
	input[type='checkbox'] { width: 1.05em; height: 1.05em; accent-color: var(--accent); margin: 0; }
	input:not([type='checkbox']):focus { border-color: color-mix(in srgb, var(--fg) 45%, transparent); }
	.edit :global(.dd), .bulk :global(.dd) { display: block; }
	.edit :global(.dd-btn), .bulk :global(.dd-btn) { font-size: 0.9rem; padding: 0.62em 0.9em 0.62em 1.1em; }
	.bulk :global(.dd) { display: inline-block; min-width: 160px; }
	select option { color: #000; }
	.narrow input { flex: 1; }
	.btn, button.btn-p { padding: 9px 14px; border-radius: 8px; border: 1px solid color-mix(in srgb, currentColor 40%, transparent); background: transparent; color: inherit; font: inherit; font-size: 0.9rem; cursor: pointer; text-decoration: none; display: inline-block; }
	.btn-p { background: var(--accent) !important; color: #fff !important; border-color: var(--accent) !important; }
	.err { color: #e5484d; margin: 10px 0; font-size: 0.9rem; }
	pre { margin: 8px 0 0; padding: 10px 12px; border-radius: 8px; background: color-mix(in srgb, currentColor 8%, transparent); overflow-x: auto; }

	.ov { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
	.ov-card { padding: 16px 18px; border-radius: 14px; border: 1px solid color-mix(in srgb, currentColor 16%, transparent); }
	.ov-card.big { grid-row: span 1; }
	.ov-l { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.6; margin-bottom: 8px; }
	.ov-n { font-size: 2rem; font-weight: 800; line-height: 1.1; }
	.ov-n span { font-size: 1rem; opacity: 0.5; font-weight: 600; }
	.ov-n.sm { font-size: 1.5rem; }
	.ov-s { font-size: 0.8rem; opacity: 0.65; margin-top: 8px; }
	.meter { height: 8px; border-radius: 999px; background: color-mix(in srgb, currentColor 12%, transparent); margin-top: 10px; overflow: hidden; }
	.meter i { display: block; height: 100%; background: var(--accent); border-radius: 999px; }
	.by { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 5px; font-size: 0.88rem; }
	.by li { display: flex; justify-content: space-between; gap: 10px; }
	.by li span { opacity: 0.75; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

	.bar { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 10px; }
	.tabs { display: flex; gap: 6px; flex-wrap: wrap; }
	.tab { padding: 7px 13px; border-radius: 999px; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); background: transparent; color: inherit; font: inherit; font-size: 0.85rem; cursor: pointer; }
	.tab span { opacity: 0.6; margin-left: 4px; }
	.tab.on { background: var(--accent); color: #fff; border-color: var(--accent); }
	#q { flex: 0 1 300px; }
	.bulk { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 10px 14px; border-radius: 12px; background: color-mix(in srgb, var(--accent) 14%, transparent); margin-bottom: 10px; position: sticky; top: 10px; z-index: 5; backdrop-filter: blur(8px); }
	.bulk[hidden] { display: none; }
	.selall { display: inline-flex; gap: 8px; align-items: center; font-size: 0.85rem; opacity: 0.75; margin: 0 0 10px; cursor: pointer; }
