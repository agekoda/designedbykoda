---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Setup — coming soon" description="Device setup is opening soon.">
	<div style="max-width:520px; margin:0 auto; padding:3em 0; text-align:center;">
		<h1>Setup is opening soon</h1>
		<p style="color:var(--muted);">We're finishing up final checks before this goes live. Join the waitlist to be notified.</p>
		<a class="button" data-magnetic href="/projects/eink-calendar">Join the waitlist</a>
	</div>
</Layout>

<style>
	.button {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.7em 1.4em;
		border-radius: 999px;
		background: var(--fg);
		color: var(--bg);
		font-weight: 700;
		font-size: 0.95em;
	}
	.button:hover {
		background: var(--accent);
		color: var(--bg);
	}
</style>