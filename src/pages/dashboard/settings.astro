	// ---------------------------------------------------------------- controls
	function buildControls() {
		buildPicker();
		fontsEl.innerHTML = families
			.map(
				(f) => `<label class="fnt"><input type="radio" name="font" value="${f.id}" /><span class="fnt-card"><canvas data-fid="${f.id}" width="400" height="120"></canvas><span class="fnt-name">${f.label}</span></span></label>`
			)
			.join('');
		refreshEl.innerHTML = refreshes
			.map((x) => `<label><input type="radio" name="refresh" value="${x.sec}" /><span>${x.label}</span></label>`)
			.join('');
		refreshEl.addEventListener('change', (e) => {
			st.refreshSec = parseInt((e.target as HTMLInputElement).value, 10);
			syncControls();
			schedule();
			changed();
		});
		ditherEl.innerHTML = dithers
			.map((d) => `<label title="${d.note}"><input type="radio" name="dither" value="${d.id}" /><span>${d.label}</span></label>`)
			.join('');


		fontsEl.addEventListener('change', (e) => {
			st.font = (e.target as HTMLInputElement).value;
			syncControls();
			schedule();
			changed();
		});
		cdTitle.addEventListener('input', () => {
			st.countdown.title = cdTitle.value;
			schedule();
			changed();
		});
		cdDate.addEventListener('input', () => {
			st.countdown.date = cdDate.value;
			schedule();
			changed();
		});
		langEl.addEventListener('change', (e) => {
			st.lang = (e.target as HTMLInputElement).value === 'ja' ? 'ja' : 'en';
			wordLangEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === effWordLang()));
			syncSums();
			thumbsDirty = true;
			schedule();
			changed();
		});
		wordLangEl.addEventListener('change', (e) => {
			st.wordLang = (e.target as HTMLInputElement).value === 'en' ? 'en' : 'ja';
			thumbsDirty = true;
			schedule();
			changed();
		});
		unitEl.addEventListener('change', (e) => {
			st.unit = (e.target as HTMLInputElement).value === 'f' ? 'f' : 'c';
			syncSums();
			schedule();
			changed();
		});
		clockEl.addEventListener('change', (e) => {
			st.clock = (e.target as HTMLInputElement).value === '12' ? '12' : '24';
			thumbsDirty = true;
			syncSums();
			schedule();
			changed();
		});
		darkBox.addEventListener('change', () => {
			st.dark = darkBox.checked;
			schedule();
			changed();
		});
		document.querySelectorAll<HTMLInputElement>('input[name="corner"]').forEach((r) =>
			r.addEventListener('change', () => {
				st.cornerMode = r.value as 'calendar' | 'image';
				syncControls();
				schedule();
				changed();
			})
		);
		ditherEl.addEventListener('change', (e) => {
			cfgNow().dither = (e.target as HTMLInputElement).value as any;
			pictureEdited();
		});
		const sliders: [string, keyof ImageSettings][] = [
			['zoom', 'zoom'],
			['exposure', 'exposure'],
			['brightness', 'brightness'],
			['contrast', 'contrast'],
			['threshold', 'threshold'],
		];
		for (const [id, key] of sliders) {
			$<HTMLInputElement>('s-' + id).addEventListener('input', (e) => {
				(cfgNow() as any)[key] = parseFloat((e.target as HTMLInputElement).value);
				pictureEdited();
			});
		}
		$<HTMLInputElement>('invert').addEventListener('change', (e) => {
			cfgNow().invert = (e.target as HTMLInputElement).checked;
			pictureEdited();
		});
		$('ed-reset').addEventListener('click', () => {
			setCfgNow({ ...DEFAULT_IMAGE_SETTINGS });
			syncControls();
			pictureEdited();
		});
		const choose = () => fileInput.click();
		$('ed-replace').addEventListener('click', choose);
		drop.addEventListener('click', choose);
		drop.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				choose();
			}
		});
		['dragenter', 'dragover'].forEach((ev) =>
			drop.addEventListener(ev, (e) => {
				e.preventDefault();
				drop.classList.add('over');
			})
		);
		['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove('over')));
		drop.addEventListener('drop', (e) => {
			e.preventDefault();
			const f = (e as DragEvent).dataTransfer?.files?.[0];
			if (f) takeFile(f);
		});
		fileInput.addEventListener('change', () => {
			const f = fileInput.files?.[0];
			if (f) takeFile(f);
			fileInput.value = '';
		});

		// drag to move the picture inside its box
		let drag: { x: number; y: number; px: number; py: number } | null = null;
		edCanvas.addEventListener('pointerdown', (e) => {
			if (!P().img) return;
			edCanvas.setPointerCapture(e.pointerId);
			drag = { x: e.clientX, y: e.clientY, px: cfgNow().panX, py: cfgNow().panY };
		});
		edCanvas.addEventListener('pointermove', (e) => {
			if (!drag) return;
			const k = dimsOf(pkey()).w / edCanvas.getBoundingClientRect().width; // screen px -> dots
			cfgNow().panX = drag.px + (e.clientX - drag.x) * k;
			cfgNow().panY = drag.py + (e.clientY - drag.y) * k;
			pictureEdited();
		});
		const end = () => (drag = null);
		edCanvas.addEventListener('pointerup', end);
		edCanvas.addEventListener('pointercancel', end);
		edCanvas.addEventListener(
			'wheel',
			(e) => {
				if (!P().img) return;
				e.preventDefault();
				cfgNow().zoom = Math.max(1, Math.min(4, cfgNow().zoom * (e.deltaY < 0 ? 1.06 : 1 / 1.06)));
				syncControls();
				pictureEdited();
			},
			{ passive: false }
		);
	}

	async function takeFile(f: File) {
		if (!f.type.startsWith('image/')) {
			flash('That is not an image.', true);
			return;
		}
		try {
			const src = await prepareSource(f);
			await loadSource(src, pkey());
			setSrcNow(src);
			setCfgNow({ ...DEFAULT_IMAGE_SETTINGS, dither: cfgNow().dither });
			if (!isFrame()) st.cornerMode = 'image';
			syncControls();
			pictureEdited();
		} catch {
			flash("Couldn't read that picture. Try a JPEG or PNG.", true);
		}
	}

	function pictureEdited() {
		P().changed = true;
		syncSliders();
		recomputePicture();
		schedule(false);
		// only the Agenda's (or the Photo frame's) thumbnail changes when the picture does
		const sid = isFrame() ? 'frame' : 'agenda';
		const cv = picker.querySelector<HTMLCanvasElement>(`canvas[data-sid="${sid}"]`);
		if (cv)
			renderPreview({ style: sid, font: effFont(), dark: st.dark, lang: st.lang, wordLang: effWordLang(), unit: st.unit, clock: st.clock, hasWeather, vbat: vbat ?? 4.12, ...extras(sid, true) }).then((r) => paintScreen(cv, r.px, { mode: 'screen', scale: 1 }));
		changed();
	}

	function syncSliders() {
		const c = cfgNow();
		const set = (id: string, v: number, text: string) => {
			$<HTMLInputElement>('s-' + id).value = String(v);
			$('o-' + id).textContent = text;
		};
		set('zoom', c.zoom, c.zoom.toFixed(2) + '×');
		set('exposure', c.exposure, (c.exposure > 0 ? '+' : '') + c.exposure.toFixed(2));
		set('brightness', c.brightness, String(Math.round(c.brightness)));
		set('contrast', c.contrast, String(Math.round(c.contrast)));
		set('threshold', c.threshold, String(Math.round(c.threshold)));
		$<HTMLInputElement>('invert').checked = c.invert;
	}

	function syncControls() {
		picker.querySelectorAll<HTMLInputElement>('input[name="layout"]').forEach((i) => (i.checked = i.value === st.style));
		syncScreenBox();
		syncSchedule();
		syncBattery();
		fontsEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === effFont()));
		darkBox.checked = st.dark;
		langEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === st.lang));
		wordLangEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === effWordLang()));
		unitEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === st.unit));
		clockEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === st.clock));
		refreshBox.hidden = !usedStyles().some((x) => x === 'timeline' || x === 'timetable');
		refreshEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = parseInt(i.value, 10) === st.refreshSec));
		refreshHint.textContent = REFRESH_HINTS[st.refreshSec] ?? '';

		// The Photo frame's festive border
		decoBox.hidden = !isFrame();
		decoBox.querySelectorAll<HTMLInputElement>('input[name="deco"]').forEach((r) => (r.checked = r.value === st.deco.when));
		$('deco-text-row').hidden = st.deco.when === 'off';
		if (document.activeElement !== decoText) decoText.value = st.deco.text;
		$('deco-hint').textContent =
			st.deco.when === 'off'
				? 'Snowflakes, trees and baubles round your photo, with a greeting if you like.'
				: st.deco.when === 'december'
					? 'Shows from 1 to 31 December, then your photo goes back to normal by itself. The preview shows it now so you can see it.'
					: 'Shows all the time, until you turn it off.';

		// Picture tab: the Agenda's corner picture, or the Photo frame's whole-screen one
		picBox.hidden = !(supportsCorner() || isFrame());
		cornerSeg.hidden = isFrame();
		picIntro.hidden = isFrame();
		document.querySelectorAll<HTMLInputElement>('input[name="corner"]').forEach((r) => (r.checked = r.value === st.cornerMode));
		pictureTools.hidden = !(isFrame() || st.cornerMode === 'image');
		editor.hidden = !P().img;
		drop.hidden = !!P().img;
		dropText.textContent = isFrame() ? 'Choose a photo for the whole screen, or drop one here' : 'Choose a picture, or drop one here';
		edNote.textContent = isFrame() ? 'Drag to move it, scroll to zoom. 400 × 300 black and white dots.' : 'Drag to move it, scroll to zoom. 184 × 140 black and white dots.';
		ditherEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === cfgNow().dither));
		syncSliders();
		paintEditor();

		// Options tab: the Countdown's name and date, or connecting Google Tasks
		const opt = fs() === 'countdown' ? 'countdown' : (fs() === 'todo' || fs() === 'planner') ? 'todo' : isSignStyle(fs()) ? 'sign' : (fs() === 'messages' || fs() === 'notes') ? 'msgs' : null;
		optCountdown.hidden = false;
		optTodo.hidden = opt !== 'todo';
		optSign.hidden = opt !== 'sign';
		optMsgs.hidden = opt !== 'msgs';
		// reminders: on the Reminders screen, or a design with the Reminders widget
		const remNow = fs() === 'reminders' || !!layoutOf(fs())?.widgets?.some((w: any) => w.t === 'reminders');
		optRem.hidden = false;
		if (!remList.contains(document.activeElement)) drawReminders();
		// habits: on the Habits screen, or a design with the Habits widget
		const habNow = fs() === 'habits' || !!layoutOf(fs())?.widgets?.some((w: any) => w.t === 'habits');
		optHab.hidden = false;
		if (!habList.contains(document.activeElement)) drawHabits();
		syncWhere(remNow, habNow);
		($('msgs-open') as HTMLAnchorElement).href = '/dashboard/messages?device=' + encodeURIComponent(deviceId);
		if (opt === 'sign') syncSignFields();
		// your own design: a button to edit it
		const mineNow = isDesign(fs()) || fs() === 'custom';
		optDesign.hidden = !mineNow;
		designEdit.textContent = fs() === 'custom' && !customLayout?.widgets?.length ? 'Start designing' : 'Edit this design';
		designEdit.href = '/dashboard/builder?device=' + encodeURIComponent(deviceId) + (isDesign(fs()) ? '&design=' + fs().slice(7) : '');
		designEdit.dataset.builder = '1';
		// a saved design can be shared (a link anyone can open to copy it)
		const shareId = isDesign(fs()) ? fs().slice(7) : null;
		const shareBtn = $<HTMLButtonElement>('design-share');
		shareBtn.hidden = !shareId || !designs?.some((x) => x.id === shareId);

		// nothing to set up for this screen? say so, rather than leave an empty box
		const detailsEl = $('details');
		detailsEl.classList.toggle('empty', [...detailsEl.children].every((c) => (c as HTMLElement).hidden));
		syncSums();
		if (cdTitle.value !== st.countdown.title) cdTitle.value = st.countdown.title;
		if (cdDate.value !== st.countdown.date) cdDate.value = st.countdown.date;
		todoStatus.textContent = tasksGranted ? 'Google Tasks is connected.' : 'To show your tasks, allow this calendar to read your Google Tasks.';
		todoConnect.textContent = tasksGranted ? 'Reconnect Google Tasks' : 'Connect Google Tasks';
		todoConnect.href = '/api/auth/google/start?tasks=1&return=' + encodeURIComponent('/dashboard/settings?device=' + deviceId);
	}

	// ---------------------------------------------------------------- reminders (bin day and the like)
	const REPEATS: [string, string][] = [['1', 'Every week'], ['2', 'Every 2 weeks'], ['3', 'Every 3 weeks'], ['4', 'Every 4 weeks'], ['m', 'Every month']];
	let remDds: Dropdown[] = [];
	const todayIso = () => new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
	function drawReminders() {
		remDds.forEach((d) => d.destroy());
		remDds = [];
		remList.innerHTML = st.reminders
			.map((r, i) => {
				const rep = r.kind === 'month' ? 'm' : String(r.every);
				const days = DAY_ORDER.map((d) => `<button type="button" class="day${(r.days >> d) & 1 ? ' on' : ''}" data-d="${d}" aria-pressed="${!!((r.days >> d) & 1)}" title="${DAY_NAME[d]}">${DAY_LETTER[d]}</button>`).join('');
				return `<div class="slot rem" data-i="${i}">
					<div class="sl-top"><input class="txt rem-text" type="text" maxlength="${MAX_REMINDER_TEXT}" value="${escHtml(r.text)}" placeholder="Bins out" aria-label="Reminder" autocomplete="off" /><button type="button" class="sl-del" aria-label="Remove">&times;</button></div>
					<div class="rem-when"><select class="rem-rep" aria-label="Repeats">${REPEATS.map(([v, l]) => `<option value="${v}"${v === rep ? ' selected' : ''}>${l}</option>`).join('')}</select>
					${
						r.kind === 'month'
							? `<label class="rem-md"><span class="muted small">on the</span><input class="txt rem-mday" type="number" min="1" max="31" value="${r.mday}" aria-label="Day of the month" /><span class="muted small">${r.mday === 31 ? '(the last day)' : ''}</span></label>`
							: `<div class="sl-days" role="group" aria-label="Days">${days}</div>`
					}</div>
					${r.kind === 'week' && r.every > 1 ? `<label class="rem-start"><span class="muted small">Next one is in the week of</span><input class="txt rem-from" type="date" value="${r.start || todayIso()}" /></label>` : ''}
					<p class="sl-note">${escHtml(repeatText(r))}</p>
				</div>`;
			})
			.join('');
		remList.querySelectorAll<HTMLSelectElement>('select.rem-rep').forEach((sel) => remDds.push(dropdown(sel)));
		($('rem-add') as HTMLButtonElement).hidden = st.reminders.length >= MAX_REMINDERS;
	}
	const remAt = (el: Element) => {
		const row = el.closest<HTMLElement>('.rem');
		return row ? { i: parseInt(row.dataset.i!, 10), r: st.reminders[parseInt(row.dataset.i!, 10)], row } : null;
	};
	const remChanged = (redrawRows: boolean) => {
		if (redrawRows) drawReminders();
		schedule(false);
		changed();
	};
	$('rem-add').addEventListener('click', () => {
		const wd = new Date().getDay();
		st.reminders.push({ text: '', kind: 'week', days: 1 << wd, every: 1, start: '', mday: new Date().getDate() });
		remChanged(true);
		remList.querySelector<HTMLInputElement>('.rem:last-child .rem-text')?.focus();
	});
	remList.addEventListener('input', (e) => {
		const el = e.target as HTMLInputElement;
		const a = remAt(el);
		if (!a) return;
		if (el.classList.contains('rem-text')) {
			a.r.text = el.value;
			a.row.querySelector('.sl-note')!.textContent = repeatText(a.r);
			remChanged(false);
		} else if (el.classList.contains('rem-mday')) {
			const n = Math.max(1, Math.min(31, parseInt(el.value, 10) || 1));
			a.r.mday = n;
			a.row.querySelector('.sl-note')!.textContent = repeatText(a.r);
			remChanged(false);
		} else if (el.classList.contains('rem-from')) {
			a.r.start = el.value;
			remChanged(false);
		}
	});
	remList.addEventListener('change', (e) => {
		const el = e.target as HTMLSelectElement;
		const a = remAt(el);
		if (!a || !el.classList.contains('rem-rep')) return;
		if (el.value === 'm') a.r.kind = 'month';
		else {
			a.r.kind = 'week';
			a.r.every = parseInt(el.value, 10);
			if (a.r.every > 1 && !a.r.start) a.r.start = todayIso();
			if (!a.r.days) a.r.days = 1 << new Date().getDay();
		}
		remChanged(true);
	});
	remList.addEventListener('click', (e) => {
		const t = e.target as HTMLElement;
		const a = remAt(t);
		if (!a) return;
		if (t.closest('.sl-del')) {
			st.reminders.splice(a.i, 1);
			remChanged(true);
			return;
		}
		const day = t.closest<HTMLElement>('.day');
		if (day) {
			const bit = 1 << parseInt(day.dataset.d!, 10);
			const next = a.r.days ^ bit;
			if (!next) return; // at least one day
			a.r.days = next;
			remChanged(true);
		}
	});

	// ---------------------------------------------------------------- habits (ticked off here, streaks on the screen)
	const dayNum = (offsetDays = 0) => Math.floor((Date.now() - new Date().getTimezoneOffset() * 60000) / 86400000) + offsetDays;
	const isoDay = (n: number) => new Date(n * 86400000).toISOString().slice(0, 10);
	function drawHabits() {
		const today = dayNum();
		habList.innerHTML = st.habits
			.map((h, i) => {
				const done = new Set(h.done);
				const ticks = [6, 5, 4, 3, 2, 1, 0]
					.map((back) => {
						const n = today - back;
						const wd = new Date(n * 86400000).getUTCDay();
						const on = done.has(isoDay(n));
						const name = back === 0 ? 'Today' : back === 1 ? 'Yesterday' : DAY_NAME[wd];
						return `<button type="button" class="day${on ? ' on' : ''}${back === 0 ? ' today' : ''}" data-n="${n}" aria-pressed="${on}" title="${name}">${back === 0 ? '✓' : DAY_LETTER[wd]}</button>`;
					})
					.join('');
				const s = habitStreak(h, today);
				return `<div class="hab hab2" data-i="${i}">
					<div class="hab2-l"><input class="hab-name hab2-name" type="text" maxlength="${MAX_HABIT_NAME}" value="${escHtml(h.name)}" placeholder="Name it, e.g. Read 20 pages" aria-label="Habit" autocomplete="off" />
					<div class="hab2-days" role="group" aria-label="Done on these days (the last week)">${ticks}</div></div>
					<div class="hab2-r"><b>${s}</b><span>${s === 1 ? 'day in a row' : 'days in a row'}</span></div>
					<button type="button" class="sl-del hab2-del" aria-label="Remove this habit">&times;</button>
				</div>`;
			})
			.join('');
		($('hab-add') as HTMLButtonElement).hidden = st.habits.length >= MAX_HABITS;
	}
	const habAt = (el: Element) => {
		const row = el.closest<HTMLElement>('.hab');
		return row ? { i: parseInt(row.dataset.i!, 10), h: st.habits[parseInt(row.dataset.i!, 10)], row } : null;
	};
	const habChanged = (redrawRows: boolean) => {
		if (redrawRows) drawHabits();
		schedule(false);
		changed();
	};
	$('hab-add').addEventListener('click', () => {
		st.habits.push({ name: '', done: [] });
		habChanged(true);
		habList.querySelector<HTMLInputElement>('.hab:last-child .hab-name')?.focus();
	});
	habList.addEventListener('input', (e) => {
		const el = e.target as HTMLInputElement;
		const a = habAt(el);
		if (!a || !el.classList.contains('hab-name')) return;
		a.h.name = el.value;
		habChanged(false);
	});
	habList.addEventListener('click', (e) => {
		const t = e.target as HTMLElement;
		const a = habAt(t);
		if (!a) return;
		if (t.closest('.sl-del')) {
			st.habits.splice(a.i, 1);
			habChanged(true);
			return;
		}
		const day = t.closest<HTMLElement>('.day');
		if (day) {
			const iso = isoDay(parseInt(day.dataset.n!, 10));
			a.h.done = a.h.done.includes(iso) ? a.h.done.filter((d) => d !== iso) : [iso, ...a.h.done].sort().reverse();
			habChanged(true);
		}
	});

	// ---------------------------------------------------------------- signs (Meeting room, Guest welcome, Desk name plate)
	const SIGN_FIELDS: Record<string, { key: string; label: string; max: number; rows?: number; ph?: string; choices?: [string, string][] }[]> = {
		room: [{ key: 'name', label: 'Room name', max: 40 }],
		guest: [
			{ key: 'title', label: 'Welcome message', max: 40 },
			{ key: 'ssid', label: 'Wi-Fi name', max: 32 },
			{ key: 'pass', label: 'Wi-Fi password', max: 63, ph: 'Leave empty if there isn\u2019t one' },
			{ key: 'rules', label: 'House rules (one per line)', max: 300, rows: 5 },
			{ key: 'checkout', label: 'Check-out', max: 30 },
			{ key: 'contact', label: 'Bottom line', max: 60 },
		],
		nameplate: [
			{ key: 'name', label: 'Name', max: 40 },
			{ key: 'role', label: 'Role', max: 40 },
		],
		waiting: [
			{ key: 'title', label: 'Name of the place', max: 40 },
			{ key: 'note', label: 'Bottom line', max: 60 },
		],
		youtube: [{ key: 'channel', label: 'YouTube channel', max: 120, ph: '@yourchannel, or a link to it' }],
		github: [{ key: 'user', label: 'GitHub username', max: 80 }],
		headlines: [{ key: 'url', label: 'News site or feed link', max: 400, ph: 'abc.net.au/news, or any RSS feed' }],
		potd: [{ key: 'cat', label: 'Pictures of', max: 8, choices: [['art', 'Art (paintings from the Art Institute of Chicago)'], ['photo', 'Photography (Wikimedia Commons)'], ['space', 'Space (NASA)']] }],
		markets: [
			{ key: 'list', label: 'Show', max: 60, ph: 'USD, EUR, BTC, ETH' },
			{ key: 'base', label: 'Prices in', max: 3, ph: 'AUD' },
		],
	};
	let signFor = '';
	function syncSignFields() {
		const id = fs();
		if (!isSignStyle(id)) return;
		const vals = st.sign[id] as Record<string, string>;
		if (signFor !== id) {
			signFor = id;
			signFields.innerHTML = SIGN_FIELDS[id]
				.map((f) => {
					const v = (vals[f.key] ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
					const ph = f.ph ? ` placeholder="${f.ph}"` : '';
					const inp = f.choices
						? `<select class="txt" data-k="${f.key}">${f.choices.map(([cv, cl]) => `<option value="${cv}"${cv === (vals[f.key] || f.choices![0][0]) ? ' selected' : ''}>${cl}</option>`).join('')}</select>`
						: f.rows ? `<textarea class="txt" data-k="${f.key}" rows="${f.rows}" maxlength="${f.max}"${ph}>${v}</textarea>` : `<input class="txt" data-k="${f.key}" type="text" maxlength="${f.max}" value="${v}"${ph} autocomplete="off" spellcheck="${f.key === 'ssid' || f.key === 'pass' ? 'false' : 'true'}" />`;
					return `<label class="sign-f"><span class="label sub">${f.label}</span>${inp}</label>`;
				})
				.join('');
		} else {
			signFields.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-k]').forEach((el) => {
				if (document.activeElement !== el && el.value !== (vals[el.dataset.k!] ?? '')) el.value = vals[el.dataset.k!] ?? '';
			});
		}
		drawSignCals(id);
		drawDesk(id);
		signBuilder.href = '/dashboard/builder?device=' + encodeURIComponent(deviceId) + '&seed=1';
		signBuilder.dataset.builder = '1';
	}
	// Desk name plate: a private link that sets what the sign says from your phone (src/lib/deskStatus.ts).
	let deskLink: { token: string; check: number; now: { text: string; until: number | null } | null } | null | undefined;
	let deskLoading = false;
	async function deskApi(body?: any) {
		const r = body
			? await fetch('/api/dashboard/desk', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ deviceId, ...body }) })
			: await fetch('/api/dashboard/desk?deviceId=' + encodeURIComponent(deviceId));
		const j = await r.json().catch(() => ({}));
		if (!r.ok || !j.ok) throw new Error(j.error || 'Could not do that.');
		deskLink = j.link;
	}
	function drawDesk(id: string) {
		const box = $('desk');
		box.hidden = id !== 'nameplate';
		if (box.hidden) return;
		const body = $('desk-body');
		if (deskLink === undefined) {
			body.innerHTML = '<p class="muted small">Loading\u2026</p>';
			if (!deskLoading) {
				deskLoading = true;
				deskApi()
					.catch(() => (deskLink = null))
					.finally(() => {
						deskLoading = false;
						if (fs() === 'nameplate') drawDesk('nameplate');
					});
			}
			return;
		}
		if (!deskLink) {
			body.innerHTML = `<p class="muted small">Set the sign to \u201cIn a meeting\u201d, \u201cBack soon\u201d or anything else from your phone, without opening the dashboard. You get a private link to keep on your home screen, and it works with iPhone Shortcuts too.</p>
				<button type="button" class="btn small" data-desk="make">Make a status link</button>`;
			return;
		}
		const url = location.origin + '/desk/' + deskLink.token;
		const every = (c: number) => (c >= 3600 ? '1 hour' : c / 60 + ' min');
		body.innerHTML = `<div class="desk-link"><input class="txt" readonly value="${escHtml(url)}" aria-label="Your status link" /><button type="button" class="sp-pill" data-desk="copy">Copy</button><a class="sp-pill" href="${escHtml(url)}" target="_blank" rel="noopener">Open</a></div>
			<p class="muted small sp-hint">${deskLink.now ? `Showing <b>${escHtml(deskLink.now.text)}</b> now.` : 'Showing free or busy from your calendar now.'} Anyone with this link can change what the sign says, so keep it to yourself.</p>
			<div class="label sub" style="margin-top:1.3em">How often the sign looks for a new status</div>
			<div class="seg" role="radiogroup" aria-label="How often it looks">${[600, 900, 1800, 3600].map((c) => `<label><input type="radio" name="desk-check" value="${c}" ${c === deskLink!.check ? 'checked' : ''} /><span>${every(c)}</span></label>`).join('')}</div>
			<p class="muted small sp-hint">Between 7 am and 10 pm. More often changes sooner but uses more battery.</p>
			<div class="desk-acts"><button type="button" class="sp-pill" data-desk="make">Make a new link</button><button type="button" class="sp-pill" data-desk="remove">Turn it off</button></div>`;
	}
	$('desk').addEventListener('click', async (e) => {
		const b = (e.target as HTMLElement).closest<HTMLElement>('[data-desk]');
		if (!b) return;
		const what = b.dataset.desk;
		try {
			if (what === 'copy') {
				await navigator.clipboard.writeText(location.origin + '/desk/' + deskLink!.token);
				return toast('Link copied');
			}
			if (what === 'make' && deskLink && !(await ask('The old link stops working straight away.', { title: 'Make a new link?', ok: 'Make a new one' }))) return;
			if (what === 'remove' && !(await ask('The link stops working, and the sign goes back to free or busy from your calendar.', { title: 'Turn off the status link?', ok: 'Turn it off', danger: true }))) return;
			await deskApi({ action: what });
			drawDesk('nameplate');
			toast(what === 'remove' ? 'Turned off' : 'Link ready. Copy it, or open it on your phone.');
		} catch (err: any) {
			toast(err.message || 'Could not do that.', true);
		}
	});
	$('desk').addEventListener('change', async (e) => {
		const t = e.target as HTMLInputElement;
		if (t.name !== 'desk-check') return;
		try {
			await deskApi({ action: 'check', check: Number(t.value) });
			toast('Saved');
		} catch (err: any) {
			toast(err.message || 'Could not save that.', true);
		}
	});

	// Meeting room and Waiting room: which of your calendars this sign reads. Picked here, they're used
	// instead of the ones in Calendars and timetables while this sign is on the screen, so work and
	// home never mix, and switching to Agenda goes straight back to your usual ones.
	let calChoices: { id: string; label: string; kind: string }[] | null = null;
	let calLoading: Promise<void> | null = null;
	let calDd: Dropdown | null = null;
	function loadCalChoices() {
		calLoading ??= (async () => {
			const out: { id: string; label: string; kind: string }[] = [];
			try {
				const r = await fetch('/api/dashboard/calendars');
				const j = r.ok ? await r.json() : null;
				for (const c of j?.calendars ?? []) out.push({ id: c.id, label: c.summary, kind: 'Google Calendar' });
			} catch {}
			try {
				const r = await fetch('/api/dashboard/feeds?deviceId=' + encodeURIComponent(deviceId));
				const j = r.ok ? await r.json() : null;
				for (const f of j?.feeds ?? []) out.push({ id: 'feed:' + f.id, label: f.name, kind: (f.kind === 'file' ? 'File' : 'Calendar link') + (f.off ? ', off on other screens' : '') });
			} catch {}
			calChoices = out;
		})();
		return calLoading;
	}
	function drawSignCals(id: string) {
		const box = $('sign-cals');
		box.hidden = id !== 'room' && id !== 'waiting';
		if (box.hidden) return;
		const cfg = st.sign[id] as { cals?: string[] };
		const chosen = cfg.cals ?? [];
		const list = $('sign-cal-list');
		const add = $('sign-cal-add') as HTMLSelectElement;
		const hint = $('sign-cal-hint');
		if (!calChoices) {
			list.innerHTML = '<p class="muted small">Loading your calendars\u2026</p>';
			loadCalChoices().then(() => fs() === id && drawSignCals(id));
			return;
		}
		const byId = new Map(calChoices.map((c) => [c.id, c]));
		list.innerHTML = chosen
			.map((c) => {
				const x = byId.get(c);
				return `<div class="sp-row sp-item"><span class="sp-t"><b>${escHtml(x?.label ?? 'A calendar that\u2019s been removed')}</b><span class="sp-sub">${escHtml(x?.kind ?? 'Remove it, or add it again in Calendars and timetables')}</span></span><button type="button" class="sp-x" data-rm="${escHtml(c)}" aria-label="Remove">&times;</button></div>`;
			})
			.join('');
		const left = calChoices.filter((c) => !chosen.includes(c.id));
		add.innerHTML = `<option value="">+ Add a calendar</option>` + left.map((c) => `<option value="${escHtml(c.id)}">${escHtml(c.label)} (${escHtml(c.kind)})</option>`).join('');
		add.value = '';
		if (!calDd) {
			calDd = dropdown(add);
			add.addEventListener('change', () => {
				const sid = fs();
				if (!add.value || (sid !== 'room' && sid !== 'waiting')) return;
				const c = st.sign[sid] as { cals?: string[] };
				c.cals = [...(c.cals ?? []), add.value];
				drawSignCals(sid);
				schedule(false);
				changed();
			});
			list.addEventListener('click', (e) => {
				const b = (e.target as HTMLElement).closest<HTMLElement>('[data-rm]');
				const sid = fs();
				if (!b || (sid !== 'room' && sid !== 'waiting')) return;
				const c = st.sign[sid] as { cals?: string[] };
				c.cals = (c.cals ?? []).filter((x) => x !== b.dataset.rm);
				drawSignCals(sid);
				schedule(false);
				changed();
			});
		} else calDd.sync();
		const what = id === 'waiting' ? 'appointments' : 'bookings';
		hint.innerHTML = !calChoices.length
			? 'Add a Google calendar or a calendar link in <a href="#calendars" data-go="calendars">Calendars and timetables</a> first.'
			: chosen.length
				? `Only these are shown for ${what}. Your other screens still use the calendars in <a href="#calendars" data-go="calendars">Calendars and timetables</a>.`
				: `None chosen, so it uses the calendars in <a href="#calendars" data-go="calendars">Calendars and timetables</a>. Choose one here (like the clinic\u2019s booking calendar) to keep this sign to just that.`;
	}

	signFields.addEventListener('input', (e) => {
		const el = e.target as HTMLInputElement | HTMLTextAreaElement;
		const id = fs();
		if (!el.dataset.k || !isSignStyle(id)) return;
		(st.sign[id] as Record<string, string>)[el.dataset.k] = el.value;
		schedule(false);
		changed();
	});
	// Opening the builder. Choosing a layout counts as an unsaved change, and asking "Save your
	// changes?" on the way to the builder made no sense to people (they hadn't typed anything), so
	// these buttons just save what's chosen and go. From a sign layout, the builder opens with that
	// layout filled in (seed=1 picks it up from sessionStorage).
	async function openBuilder(e: Event, fromSign: boolean, design?: string) {
		e.preventDefault();
		e.stopPropagation();
		const id = fs();
		const seed = fromSign && isSignStyle(id);
		if (seed) {
			try {
				sessionStorage.setItem('builderSeed:' + deviceId, JSON.stringify({ label: labelOf(id), layout: signLayout(id, sanitizeSign(st.sign)) }));
			} catch {}
		}
		if (isDirty()) {
			await save();
			if (isDirty()) return; // save() has already said what went wrong
		}
		skipUnload = true;
		location.href = '/dashboard/builder?device=' + encodeURIComponent(deviceId) + (seed ? '&seed=1&design=new' : design ? '&design=' + design : isDesign(id) ? '&design=' + id.slice(7) : '');
	}
	signBuilder.addEventListener('click', (e) => openBuilder(e, true));
	designEdit.addEventListener('click', (e) => openBuilder(e, false));
	// the menu's Layout builder: opens the design on screen, or a new one (saving first, like the buttons above)
	$('nav-builder').addEventListener('click', (e) => openBuilder(e, false));
	$('design-share').addEventListener('click', async () => {
		if (!isDesign(fs())) return;
		const id = fs().slice(7);
		const d = designs?.find((x) => x.id === id);
		if (!d) return;
		const wifi = !!d.layout?.widgets?.some((w: any) => w.t === 'qr' && w.o?.mode === 'wifi' && (w.o.ssid || w.o.pass));
		const t = await shareDialog({ deviceId, designId: id, name: d.name, token: shares[id] ?? null, hasWifi: wifi, onError: (m) => flash(m, true) });
		if (t === undefined) return;
		if (t) shares[id] = t;
		else {
			delete shares[id];
			flash('Stopped sharing. The link no longer works.');
		}
	});

	// ---------------------------------------------------------------- schedule
	const DAY_ORDER = [1, 2, 3, 4, 5, 6, 0]; // Monday first
	const DAY_LETTER = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
	const DAY_NAME = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
	const escHtml = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
	// what each scheduled layout still needs before it can show anything useful
	function needsNote(id: string): string {
		if (id === 'frame' && !pics.frame.img) return 'Needs a photo: click it to add one.';
		if (id === 'countdown' && !(st.countdown.title.trim() && st.countdown.date)) return 'Needs a name and date: click it to add them.';
		if ((id === 'custom' || isDesign(id)) && !layoutOf(id)?.widgets?.length) return 'This design is empty.';
		if ((id === 'todo' || id === 'planner') && !tasksGranted) return 'Needs Google Tasks: click it to connect.';
		return '';
	}
	function schChanged(redrawThumbs = false) {
		syncControls();
		schedule(redrawThumbs);
		changed();
	}
	function focusStyle(id: string | null) {
		viewStyle = id && id !== st.style ? id : null;
		syncControls();
		schedule(false);
	}

	let slotDds: Dropdown[] = [];
	function renderSlots() {
		slotDds.forEach((d) => d.destroy());
		slotDds = [];
		// which slots win at least once in the week (a slot under a bigger one above never shows)
		const shows = new Set<Slot>();
		const wk = Date.UTC(2026, 0, 4) / 1000;
		for (let q = 0; q < 7 * 96; q++) {
			const a = activeSlot(st.sch.on ? st.sch : { ...st.sch, on: true }, wk + q * 900);
			if (a) shows.add(a);
		}
		const opts = (sel: string) => styles.map((x) => `<option value="${x.id}"${x.id === sel ? ' selected' : ''}>${escHtml(x.label)}</option>`).join('');
		schSlots.innerHTML = st.sch.slots
			.map((sl, i) => {
				const allDay = sl.from === sl.to;
				const days = DAY_ORDER.map((d) => `<button type="button" class="day${(sl.days >> d) & 1 ? ' on' : ''}" data-d="${d}" aria-pressed="${!!((sl.days >> d) & 1)}" title="${DAY_NAME[d]}">${DAY_LETTER[d]}</button>`).join('');
				const note = !shows.has(sl) ? 'Never shows: a time above it covers all of it.' : needsNote(sl.style);
				return `<div class="slot${viewStyle === sl.style ? ' focus' : ''}" data-i="${i}">
					<div class="sl-top"><select class="sl-style wide" aria-label="Layout">${opts(sl.style)}</select><button type="button" class="sl-del" aria-label="Remove">&times;</button></div>
					<div class="sl-days" role="group" aria-label="Days">${days}</div>
					<div class="sl-time">${allDay ? '<span class="muted small">All day</span>' : `<input class="txt tm sl-from" type="time" value="${minutesToHHMM(sl.from)}" aria-label="From" /><span class="muted small">to</span><input class="txt tm sl-to" type="time" value="${minutesToHHMM(sl.to)}" aria-label="To" />`}
						<label class="mini-check"><input type="checkbox" class="sl-all"${allDay ? ' checked' : ''} /> All day</label></div>
					${note ? `<p class="sl-note">${escHtml(note)}</p>` : ''}
				</div>`;
			})
			.join('');
		// the same dropdown as the pre-order page (the real <select> stays, hidden, for .value and change)
		schSlots.querySelectorAll<HTMLSelectElement>('select.sl-style').forEach((sel) => slotDds.push(dropdown(sel)));
	}

	function slotAt(el: Element): { i: number; sl: Slot } | null {
		const row = el.closest<HTMLElement>('.slot');
		if (!row) return null;
		const i = parseInt(row.dataset.i!, 10);
		return { i, sl: st.sch.slots[i] };
	}

	function buildScheduleControls() {
		schPresets.innerHTML =
			'<p class="muted small">Quick start:</p>' +
			SCHEDULE_PRESETS.map((p) => `<button type="button" class="preset" data-p="${p.id}"><b>${escHtml(p.label)}</b><span>${escHtml(p.note)}</span></button>`).join('');
		schPresets.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLElement>('.preset');
			if (!b) return;
			const p = SCHEDULE_PRESETS.find((x) => x.id === b.dataset.p)!;
			st.sch = { ...st.sch, on: true, slots: [...st.sch.slots, ...p.slots(st.style)].slice(0, MAX_SLOTS) };
			focusStyle(st.sch.slots[st.sch.slots.length - 1].style);
			schChanged();
		});
		schOn.addEventListener('change', () => {
			st.sch = { ...st.sch, on: schOn.checked };
			if (!schOn.checked) viewStyle = null;
			schChanged();
		});
		schAdd.addEventListener('click', () => {
			// a layout not used yet, at a time that doesn't clash with the first slot's evening default
			const taken = new Set([st.style, ...st.sch.slots.map((x) => x.style)]);
			const other = styles.find((x) => !taken.has(x.id) && !x.builder && !x.frame)?.id ?? 'month';
			const first = !st.sch.slots.length;
			st.sch = { ...st.sch, slots: [...st.sch.slots, first ? { style: other, days: ALL_DAYS, from: 18 * 60, to: 7 * 60 } : { style: other, days: WEEKDAYS, from: 7 * 60, to: 9 * 60 }] };
			focusStyle(other);
			schChanged();
		});
		schSlots.addEventListener('click', (e) => {
			const t = e.target as HTMLElement;
			const hit = slotAt(t);
			if (!hit) return;
			if (t.closest('.sl-del')) {
				st.sch = { ...st.sch, slots: st.sch.slots.filter((_, j) => j !== hit.i) };
				if (!st.sch.slots.some((x) => x.style === viewStyle)) viewStyle = null;
				schChanged();
				return;
			}
			const day = t.closest<HTMLElement>('.day');
			if (day) {
				const d = parseInt(day.dataset.d!, 10);
				const days = hit.sl.days ^ (1 << d);
				if (!days) return; // keep at least one day
				hit.sl.days = days;
				schChanged();
				return;
			}
			if (!t.closest('input, select, label, .dd, .dd-menu')) focusStyle(hit.sl.style);
		});
		schSlots.addEventListener('change', (e) => {
			const t = e.target as HTMLInputElement | HTMLSelectElement;
			const hit = slotAt(t);
			if (!hit) return;
			if (t.classList.contains('sl-style')) {
				hit.sl.style = t.value;
				focusStyle(t.value);
			} else if (t.classList.contains('sl-all')) {
				if ((t as HTMLInputElement).checked) hit.sl.from = hit.sl.to = 0;
				else {
					hit.sl.from = 18 * 60;
					hit.sl.to = 7 * 60;
				}
			} else if (t.classList.contains('sl-from') || t.classList.contains('sl-to')) {
				const m = hhmmToMinutes(t.value);
				if (m === null) return;
				if (t.classList.contains('sl-from')) hit.sl.from = m;
				else hit.sl.to = m;
				if (hit.sl.from === hit.sl.to) hit.sl.to = (hit.sl.to + 60) % 1440; // equal would mean all day
			}
			schChanged();
		});
		btnModeEl.addEventListener('change', (e) => {
			st.sch = { ...st.sch, button: (e.target as HTMLInputElement).value === 'next' ? 'next' : 'refresh' };
			schChanged();
		});
		cycleChips.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLElement>('.chip');
			if (!b) return;
			const id = b.dataset.s!;
			const cur = st.sch.cycle.length ? st.sch.cycle : cycleList(st.sch, st.style).slice(1);
			const next = cur.includes(id) ? cur.filter((x) => x !== id) : [...cur, id];
			st.sch = { ...st.sch, cycle: next };
			focusStyle(cur.includes(id) ? null : id);
			schChanged();
		});
		$('view-back').addEventListener('click', () => focusStyle(null));
	}

	// Seven bars, Monday to Sunday, coloured by which layout is on.
	const SHADES = ['var(--accent)', '#d98c5f', '#69b98a', '#b48ad6', '#d6c35f', '#d66f8f', '#5fc3c9'];
	function renderWeek() {
		const shown = [st.style, ...st.sch.slots.map((x) => x.style)].filter((v, i, a) => a.indexOf(v) === i);
		const colour = (id: string) => (id === st.style ? 'var(--border)' : SHADES[(shown.indexOf(id) - 1) % SHADES.length]);
		const base = Date.UTC(2026, 0, 4) / 1000; // a Sunday
		const rows = DAY_ORDER.map((d) => {
			const segs: { id: string; n: number }[] = [];
			for (let q = 0; q < 96; q++) {
				const id = activeStyle(st.sch, st.style, base + d * 86400 + q * 900);
				if (segs.length && segs[segs.length - 1].id === id) segs[segs.length - 1].n++;
				else segs.push({ id, n: 1 });
			}
			const bar = segs.map((g) => `<i style="flex:${g.n};background:${colour(g.id)}" title="${escHtml(labelOf(g.id))}"></i>`).join('');
			return `<div class="wk-row"><span class="wk-d">${DAY_NAME[d].slice(0, 3)}</span><div class="wk-bar">${bar}</div></div>`;
		}).join('');
		schWeek.innerHTML = rows + '<div class="wk-row wk-axis"><span></span><div><span>0:00</span><span>6:00</span><span>12:00</span><span>18:00</span><span>24:00</span></div></div>';
		schKey.innerHTML = shown.map((id) => `<span><i style="background:${colour(id)}"></i>${escHtml(labelOf(id))}${id === st.style ? ' (main)' : ''}</span>`).join('');
	}

	function syncSchedule() {
		schOn.checked = st.sch.on;
		schBody.hidden = !st.sch.on;
		schPresets.hidden = st.sch.slots.length > 0;
		schAdd.hidden = st.sch.slots.length >= MAX_SLOTS;
		schBanner.hidden = screensReady;
		const typing = document.activeElement instanceof HTMLInputElement && document.activeElement.type === 'time' && schSlots.contains(document.activeElement);
		if (typing) {
			// don't rebuild under the user's cursor; just refresh the focus outline and notes
			schSlots.querySelectorAll<HTMLElement>('.slot').forEach((r, i) => r.classList.toggle('focus', st.sch.slots[i]?.style === viewStyle));
		} else renderSlots();
		schRest.textContent = st.sch.slots.length ? `The rest of the time: ${labelOf(st.style)}, your main layout. If two times overlap, the higher one wins.` : '';
		renderWeek();
		btnModeEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === st.sch.button));
		cycleBox.hidden = st.sch.button !== 'next';
		const inCycle = cycleList(st.sch, st.style);
		cycleChips.innerHTML = styles
			.filter((x) => x.id !== st.style)
			.map((x) => `<button type="button" class="chip${inCycle.includes(x.id) ? ' on' : ''}" data-s="${x.id}" aria-pressed="${inCycle.includes(x.id)}">${escHtml(x.label)}</button>`)
			.join('');
		btnHint.textContent =
			st.sch.button === 'next'
				? inCycle.length > 1
					? `Each press shows the next one: ${inCycle.map(labelOf).join(' → ')}. ${st.sch.on && st.sch.slots.length ? 'It goes back to the schedule at the next change.' : 'It stays until you press again.'}`
					: 'Pick at least one more screen to flip to.'
				: 'Each press updates the screen straight away.';
		syncSums();
		syncScreenBox();
		// the pill over the preview
		viewPill.hidden = !viewStyle;
		if (viewStyle) {
			const sl = st.sch.slots.find((x) => x.style === viewStyle);
			viewText.textContent = `Previewing ${labelOf(viewStyle)}${sl ? ` · ${daysText(sl.days)}${sl.from === sl.to ? '' : ` ${minutesToHHMM(sl.from)}–${minutesToHHMM(sl.to)}`}` : ' · on the button'}`;
		}
	}

	// ---------------------------------------------------------------- the Screen box and the row summaries
	function syncScreenBox() {
		const id = fs();
		$('screen-label').textContent = viewStyle ? 'From your schedule' : 'Screen';
		$('cur-name').textContent = labelOf(id);
		const note = needsNote(id);
		const info = styles.find((x) => x.id === id);
		$('cur-note').textContent = note || (info?.note ?? '');
		$('cur-note').classList.toggle('warn', !!note);
	}
	let msgSum = '';
	const setText = (id: string, t: string) => {
		const el = document.getElementById(id);
		if (el) el.textContent = t;
	};
	function syncSums() {
		const fam = families.find((f) => f.id === st.font)?.label ?? 'Layout font';
		setText('sum-look', `${fam} · ${st.dark ? 'Dark' : 'Light'}`);
		const n = st.sch.on ? st.sch.slots.length : 0;
		const parts: string[] = [];
		parts.push(n ? `${n} time${n === 1 ? '' : 's'} set` : 'Always this screen');
		if (st.sch.button === 'next') parts.push('button cycles');
		setText('sum-when', parts.join(' · '));
		setText('sum-msgs', msgSum);
		setText('sum-lang', `${st.lang === 'ja' ? '日本語' : 'English'} · °${st.unit.toUpperCase()} · ${st.clock}-hour`);
	}
	async function loadMsgSum() {
		try {
			const r = await fetch('/api/dashboard/messages?deviceId=' + encodeURIComponent(deviceId));
			if (!r.ok) return;
			const j = await r.json();
			const k = Array.isArray(j.messages) ? j.messages.length : 0;
			const off = -new Date().getTimezoneOffset() * 60;
			liveMsgs = (Array.isArray(j.messages) ? j.messages : []).map((m: any) => ({ author: String(m.author ?? ''), body: String(m.body ?? ''), atLocal: (m.createdAt ?? 0) + off }));
			schedule();
			msgSum = k ? `${k} on the calendar` : 'None yet';
			setText('nav-msgs', k ? String(k) : '');
			setText('msgs-sum', k ? `${k} message${k === 1 ? '' : 's'} on the calendar now.` : 'None on the calendar right now. Send one, or share a link so family can.');
			syncSums();
		} catch {}
	}

	// ---------------------------------------------------------------- battery
	function syncBattery() {
		const live = usedStyles().some((id) => (id === 'custom' || isDesign(id)) && layoutNeeds(layoutOf(id)).live);
		const full = estimate({ style: st.style, refreshSec: st.refreshSec, schedule: st.sch, live, msgCheck });
		const parts: string[] = [];
		if (vbat !== null) parts.push(`<b>Battery ${batteryPercent(vbat)}%</b>`);
		parts.push(`With these settings a full charge lasts <b>${lifeText(full)}</b>`);
		const m = measured(battAnchor?.mv ?? null, battAnchor?.at ?? null, vbat !== null ? Math.round(vbat * 1000) : null, battAt);
		if (m) {
			// the measured rate covers everything since the charge: old settings, button presses, testing
			const fast = m.full < full * 0.5;
			parts.push(`Going by how it's actually drained since its last charge: ${lifeText(m.left)} left${fast ? ' (faster than these settings, so earlier settings or lots of button presses used more)' : ''}`);
		}
		battLine.innerHTML = parts.join(' · ');
	}

	// ---------------------------------------------------------------- saving
	function flash(text: string, err = false) {
		saveMsg.textContent = text;
		saveMsg.classList.toggle('is-error', err);
		saveMsg.classList.remove('is-dirty');
	}
	function isDirty() {
		return JSON.stringify(st) !== base || pics.corner.changed || pics.frame.changed;
	}
	function changed() {
		const dirty = isDirty();
		saveBtn.disabled = !dirty;
		revertBtn.disabled = !dirty;
		if (dirty) {
			flash('Unsaved changes');
			saveMsg.classList.add('is-dirty');
		} else if (saveMsg.classList.contains('is-dirty')) flash('');
	}

	async function save() {
		const used = usedStyles();
		const anyCorner = used.some((id) => styles.find((x) => x.id === id)?.corner);
		if (st.cornerMode === 'image' && anyCorner && !pics.corner.img) {
			flash('Choose a picture first, or switch back to the mini calendar.', true);
			return;
		}
		if (used.includes('frame') && !pics.frame.img) {
			flash(st.style === 'frame' ? 'Choose a photo first, or pick another layout.' : 'Your schedule shows Photo frame: add its photo in the Picture tab first.', true);
			return;
		}
		saveBtn.disabled = true;
		flash('Saving…');
		const body: any = { deviceId, style: st.style, font: st.font, dark: st.dark, lang: st.lang, wordLang: st.wordLang, refreshSec: st.refreshSec, countdown: st.countdown };
		const baseState = JSON.parse(base);
		if (JSON.stringify(st.sch) !== JSON.stringify(baseState.sch)) body.schedule = st.sch;
		if (JSON.stringify(st.sign) !== JSON.stringify(baseState.sign)) body.sign = st.sign;
		if (JSON.stringify(st.reminders) !== JSON.stringify(baseState.reminders)) body.reminders = st.reminders.filter((r) => r.text.trim());
		if (JSON.stringify(st.deco) !== JSON.stringify(baseState.deco)) body.frameDeco = st.deco;
		if (JSON.stringify(st.habits) !== JSON.stringify(baseState.habits)) body.habits = st.habits.filter((h) => h.name.trim());
		if (st.clock !== baseState.clock) body.clock = st.clock;
		if (st.unit !== baseState.unit) body.unit = st.unit; // only when changed, so a server without schema-screens.sql still saves the rest
		if (anyCorner || st.cornerMode === 'image') {
			body.corner = { mode: st.cornerMode };
			if (st.cornerMode === 'image' && pics.corner.img && pics.corner.bytes && (pics.corner.changed || baseState.cornerMode !== 'image')) {
				body.corner.bits = bytesToB64(pics.corner.bytes);
				body.corner.src = st.src;
				body.corner.cfg = st.cfg;
			}
		}
		if (pics.frame.changed && pics.frame.img && pics.frame.bytes) {
			body.frame = { bits: bytesToB64(pics.frame.bytes), src: st.fsrc, cfg: st.fcfg };
		}
		try {
			const res = await fetch('/api/dashboard/display', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});
			const data = await res.json().catch(() => ({}));
			if (!res.ok || !data.ok) throw new Error(data.error || 'Could not save.');
			base = JSON.stringify(st);
			pics.corner.changed = false;
			pics.frame.changed = false;
			flash('Saved. Press the button on your calendar to see it now.');
			saveBtn.disabled = true;
			revertBtn.disabled = true;
		} catch (err: any) {
			flash(err?.message || 'Could not save.', true);
			saveBtn.disabled = false;
		}
	}

	async function revert() {
		st = JSON.parse(base);
		viewStyle = null;
		st.cfg = cleanSettings(st.cfg);
		st.fcfg = cleanSettings(st.fcfg);
		pics.corner.changed = false;
		pics.frame.changed = false;
		pics.corner.img = null;
		pics.frame.img = null;
		if (st.src) {
			try {
				await loadSource(st.src, 'corner');
			} catch {}
		}
		if (st.fsrc) {
			try {
				await loadSource(st.fsrc, 'frame');
			} catch {}
		}
		recompute('corner');
		recompute('frame');
		syncControls();
		schedule();
		changed();
		flash('Reverted.');
	}
	saveBtn.addEventListener('click', save);
	revertBtn.addEventListener('click', revert);
	window.addEventListener('beforeunload', (e) => {
		if (isDirty() && !skipUnload) {
			e.preventDefault();
			e.returnValue = '';
		}
	});

	// ---------------------------------------------------------------- leaving with unsaved changes
	const guard = $('guard');
	let leaveTo: string | null = null;
	document.addEventListener(
		'click',
		(e) => {
			const a = (e.target as HTMLElement).closest('a[href]') as HTMLAnchorElement | null;
			if (!a || !isDirty() || a.dataset.builder || a.target === '_blank' || a.href.startsWith('javascript:') || a.href.includes('#')) return;
			e.preventDefault();
			e.stopPropagation();
			leaveTo = a.href;
			guard.hidden = false;
			$('g-save').focus();
		},
		true
	);
	const go = () => {
		skipUnload = true;
		location.href = leaveTo || '/dashboard';
	};
	let skipUnload = false;
	$('g-stay').addEventListener('click', () => (guard.hidden = true));
	$('g-discard').addEventListener('click', go);
	$('g-save').addEventListener('click', async () => {
		await save();
		if (!isDirty()) go();
		else guard.hidden = true;
	});
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !guard.hidden) guard.hidden = true;
	});

	// browser zoom / window size changes the pixel size the preview should be drawn at
	let lastKey = '';
	window.addEventListener('resize', () => {
		const key = window.devicePixelRatio + ':' + (screen.parentElement as HTMLElement).clientWidth;
		if (key !== lastKey) {
			lastKey = key;
			schedule(false);
		}
	});

	// ---------------------------------------------------------------- sections (the menu on the left)
	const PANES = ['screen', 'look', 'lang', 'calendars', 'classes', 'weather', 'habits', 'reminders', 'countdown', 'messages', 'schedule', 'away', 'device'];
	function showPane(id: string, push = true) {
		if (!PANES.includes(id)) id = 'screen';
		document.querySelectorAll<HTMLElement>('.pane').forEach((p) => (p.hidden = p.dataset.pane !== id));
		document.querySelectorAll<HTMLElement>('#snav [data-pane]').forEach((b) => b.classList.toggle('on', b.dataset.pane === id));
		if (push && location.hash !== '#' + id) history.replaceState(null, '', '#' + id);
		if (id === 'screen' || id === 'look') schedule();
		if (id === 'classes' && sideDevice) mountClasses($('sp-classes'), sideDevice, toast);
		if (innerWidth < 900) $('panes').scrollIntoView({ block: 'start', behavior: 'smooth' });
	}
	$('snav').addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest<HTMLElement>('[data-pane]');
		if (b) showPane(b.dataset.pane!);
	});
	// buttons inside sections that jump to another one ("Add a timetable")
	$('panes').addEventListener('click', (e) => {
		const g = (e.target as HTMLElement).closest<HTMLElement>('[data-go]');
		if (g) showPane(g.dataset.go!);
		const u = (e.target as HTMLElement).closest<HTMLElement>('[data-use]');
		if (u) {
			pick(u.dataset.use!);
			showPane('screen');
			toast(`${labelOf(u.dataset.use!)} chosen. Save to put it on the calendar.`);
		}
	});
	addEventListener('hashchange', () => showPane(location.hash.slice(1), false));

	// a short message at the bottom of the window, for the sections that save straight away
	const toastEl = document.createElement('div');
	toastEl.className = 'sp-toast';
	toastEl.setAttribute('aria-live', 'polite');
	document.body.appendChild(toastEl);
	let toastT: any;
	function toast(msg: string, bad = false) {
		toastEl.textContent = msg;
		toastEl.classList.toggle('bad', bad);
		toastEl.classList.toggle('on', !!msg);
		clearTimeout(toastT);
		toastT = setTimeout(() => toastEl.classList.remove('on'), bad ? 6000 : 3500);
	}

	// "Shows on: ..." under Habits, Reminders, Countdown and Messages, with a button to use that screen
	function syncWhere(remNow: boolean, habNow: boolean) {
		const w = (id: string, on: boolean, screens: string | string[], widget: string) => {
			const el = document.getElementById(id);
			if (!el) return;
			const list = Array.isArray(screens) ? screens : [screens];
			const names = list.map((x) => `<b>${escHtml(labelOf(x))}</b>`).join(' or ');
			const uses = list.map((x) => `<button type="button" class="link" data-use="${x}">Use the ${escHtml(labelOf(x))} screen</button>`).join(' ');
			el.innerHTML = on
				? `On the screen now. Also works as a <b>${widget}</b> widget in your own designs.`
				: `Shows on the ${names} screen, or a <b>${widget}</b> widget in your own design. ${uses}`;
		};
		w('where-habits', habNow, 'habits', 'Habits');
		w('where-reminders', remNow, 'reminders', 'Reminders');
		w('where-countdown', fs() === 'countdown' || !!layoutOf(fs())?.widgets?.some((x: any) => x.t === 'countdown'), 'countdown', 'Countdown');
		w('where-messages', fs() === 'messages' || fs() === 'notes' || !!layoutOf(fs())?.widgets?.some((x: any) => x.t === 'messages'), ['messages', 'notes'], 'Messages');
	}

	// the sections that save straight away (src/lib/settingsPanes.ts)
	let sideDevice: any = null;
	async function mountSidePanes(devices: any[]) {
		const d = devices.find((x) => x.id === deviceId);
		if (!d) return;
		sideDevice = d;
		let cals: any[] | null = null;
		try {
			const r = await fetch('/api/dashboard/calendars');
			cals = r.ok ? (await r.json()).calendars ?? null : null;
		} catch {}
		mountCalendars($('sp-cals'), d, cals, toast);
		mountFeeds($('sp-feeds'), d, toast, {
			onAdded: () => classesPrompt(d, toast, () => {}),
			onNames: () => showPane('classes'),
		});
		mountWeather($('sp-weather'), d, toast);
		mountAway($('sp-away'), d, toast);
		mountDevice($('sp-device'), d, toast, (name) => ($('dev-title').textContent = name || 'E-Ink Calendar'));
		if (location.hash.slice(1) === 'classes') mountClasses($('sp-classes'), d, toast);
	}

	// ---------------------------------------------------------------- start
	async function start() {
		buildControls();
		buildScheduleControls();
		try {
			if (!deviceId) {
				const list = await (await fetch('/api/dashboard/devices')).json();
				deviceId = list.devices?.[0]?.id || '';
				if (!deviceId) {
					$('dev-title').textContent = 'No devices yet';
					return;
				}
			}
			const [info, list] = await Promise.all([
				fetch('/api/dashboard/display?deviceId=' + encodeURIComponent(deviceId)).then((r) => r.json()),
				fetch('/api/dashboard/devices').then((r) => r.json()).catch(() => ({ devices: [] })),
			]);
			if (info.error) {
				$('dev-title').textContent = info.error;
				return;
			}
			const idx = (list.devices || []).findIndex((d: any) => d.id === deviceId);
			$('dev-title').textContent = info.name || (idx > 0 ? `E-Ink Calendar ${idx + 1}` : 'E-Ink Calendar');
			hasWeather = !!info.hasWeather;
			loc = typeof info.lat === 'number' && typeof info.lon === 'number' ? { lat: info.lat, lon: info.lon } : null;
			tasksGranted = !!info.tasksGranted;
			customLayout = info.custom ?? null;
			designs = info.designs ?? null;
			shares = info.shares ?? {};
			loadMsgSum();
			$<HTMLAnchorElement>('msgs-open2').href = '/dashboard/messages?device=' + encodeURIComponent(deviceId);
			mountSidePanes(list.devices || []);
			rebuildStyles();
			buildPicker();
			vbat = info.batteryMv ? info.batteryMv / 1000 : null;
			if (!info.migrated) {
				banner.hidden = false;
				banner.textContent = 'Fonts and pictures need a one-off database update on the server (schema-display.sql) before they can be saved.';
			}
			st = {
				style: info.style,
				font: info.font,
				dark: !!info.dark,
				lang: info.lang === 'ja' ? 'ja' : 'en',
				wordLang: info.wordLang === 'ja' || info.wordLang === 'en' ? info.wordLang : '',
				unit: info.unit === 'f' ? 'f' : 'c',
				clock: info.clock === '12' ? '12' : '24',
				refreshSec: info.refreshSec || 86400,
				cornerMode: info.cornerMode,
				cfg: cleanSettings(info.cornerCfg),
				src: info.cornerSrc,
				fcfg: cleanSettings(info.frameCfg),
				fsrc: info.frameSrc,
				countdown: info.countdown ?? { title: '', date: '' },
				sch: info.schedule ?? { ...EMPTY_SCHEDULE },
				sign: sanitizeSign(info.sign),
				reminders: sanitizeReminders(info.reminders),
				habits: sanitizeHabits(info.habits),
				deco: sanitizeDeco(info.frameDeco),
			};
			screensReady = info.screensReady !== false;
			battAnchor = info.batteryAnchor ?? null;
			battAt = info.batteryAt ?? null;
			msgCheck = info.msgCheck ?? 0;
			if (st.src) {
				try {
					await loadSource(st.src, 'corner');
				} catch {
					pics.corner.img = null;
				}
			}
			if (st.fsrc) {
				try {
					await loadSource(st.fsrc, 'frame');
				} catch {
					pics.frame.img = null;
				}
			}
			recompute('corner');
			recompute('frame');
			base = JSON.stringify(st);
			syncControls();
			showPane(location.hash.slice(1) || 'screen', false);
			scrollTo(0, 0); // the #section in the address isn't a place on the page
			schedule();
		} catch (err) {
			console.error(err);
			$('dev-title').textContent = "Couldn't load this device";
		}
	}
	start();
</script>

<style is:global>

	/* the screen box: what's on the calendar, and what that screen needs */
	.cust .box { background: var(--bg-raised); border: 1px solid var(--border); border-radius: 16px; padding: 1.2em; }
	.cust .box + .box { margin-top: 1em; }
	.cust .cur { display: grid; grid-template-columns: 112px minmax(0, 1fr) auto; gap: 1em; align-items: center; }
	.cust #cur-thumb { width: 112px; height: auto; aspect-ratio: 4 / 3; border-radius: 6px; background: #dfdbd0; display: block; }
	.cust .cur-name { font-weight: 800; font-size: 1.15em; color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.cust .cur-note { font-size: 0.85em; color: var(--muted); line-height: 1.35; margin-top: 0.15em; }
	.cust .cur-note.warn { color: #d9a441; }
	.cust .details { margin-top: 1.2em; padding-top: 1.2em; border-top: 1px solid var(--border); display: grid; gap: 1.4em; }
	.cust .details.empty { display: none; }
	.cust .details > [hidden] { display: none; }
	.cust .details .btn.small { display: inline-block; margin-top: 0.6em; }

	/* the rows: always the same order, each says what it's set to */
	.cust .rows { padding: 0.3em 1.2em; }
	.cust .row { display: block; border-bottom: 1px solid var(--border); }
	.cust .row:last-child { border-bottom: none; }
	.cust .row > summary, .cust .row-link { display: grid; grid-template-columns: 1.6em auto minmax(0, 1fr) auto; align-items: center; gap: 0.7em; padding: 1em 0; list-style: none; color: var(--fg); text-decoration: none; }
	.cust .row > summary::-webkit-details-marker { display: none; }
	.cust .row > summary::after { content: '›'; color: var(--muted); font-size: 1.3em; line-height: 1; transition: transform 0.2s; }
	.cust .row[open] > summary::after { transform: rotate(90deg); }
	.cust .row .ico { color: var(--muted); text-align: center; font-weight: 700; }
	.cust .row .rt { font-weight: 700; }
	.cust .row .sum { color: var(--muted); font-size: 0.88em; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.cust .row-link .go { color: var(--muted); font-size: 1.3em; line-height: 1; }
	.cust .row > summary:hover .rt, .cust .row-link:hover .rt { color: var(--accent); }
	.cust .row-b { padding: 0.2em 0 1.4em; }

	/* Change screen: a drawer on the right, so the preview stays in view */
	.picker-back.cust { position: fixed; inset: 0; left: 0; width: auto; transform: none; margin: 0; padding: 0; z-index: 9500; background: rgba(0, 0, 0, 0.35); }
	.picker-back[hidden], .picker-back.cust[hidden] { display: none; }
	body.picker-open { overflow: hidden; }
	.picker-back.cust { display: grid; place-items: center; padding: 2em; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
	.cust .picker { position: relative; width: min(1120px, 100%); max-height: min(860px, 100%); display: flex; flex-direction: column; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 22px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5); overflow: hidden; animation: pickerIn 0.22s ease-out; }
	@keyframes pickerIn { from { transform: translateY(14px) scale(0.98); opacity: 0; } }
	.cust .picker .layouts { grid-template-columns: repeat(5, 1fr); }
	.cust .picker .cats { border-bottom: none; padding-bottom: 0.4em; }
	@media (max-width: 1100px) { .cust .picker .layouts { grid-template-columns: repeat(4, 1fr); } }
	@media (max-width: 900px) { .cust .picker .layouts { grid-template-columns: repeat(3, 1fr); } }
	.cust .picker-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 1em; padding: 1.3em 1.4em 0.8em; }
	.cust .picker-t { font-size: 1.3em; font-weight: 800; color: var(--fg); margin-bottom: 0.2em; }
	.cust .cats { display: flex; gap: 0.4em; flex-wrap: wrap; padding: 0 1.4em 1em; border-bottom: 1px solid var(--border); }
	.cust .cat { background: var(--bg); border: 1px solid var(--border); color: var(--muted); font: inherit; font-weight: 700; font-size: 0.85em; padding: 0.45em 1em; border-radius: 999px; transition: background 0.2s, color 0.2s, border-color 0.2s; }
	.cust .cat:hover { color: var(--fg); border-color: var(--muted); }
	.cust .cat.on { background: var(--fg); color: var(--bg); border-color: var(--fg); }
	.cust .picker-scroll { flex: 1; overflow-y: auto; padding: 1.2em 1.4em 2em; }
	.cust .lay[hidden], .cust #mine-head[hidden], .cust #design-cards[hidden] { display: none; }
	.cust .sign-cals { margin: 0.6em 0 1.4em; }
	.cust .desk { margin: 0.6em 0 1.6em; }
	.cust .desk-link { display: flex; gap: 0.5em; align-items: center; }
	.cust .desk-link .txt { flex: 1; min-width: 0; font-size: 0.9em; }
	.cust .desk-acts { display: flex; gap: 0.5em; flex-wrap: wrap; margin-top: 1.2em; }
