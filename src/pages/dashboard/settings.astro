---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import CitySearchStyles from '../../components/CitySearchStyles.astro';
import { getSessionUserId } from '../../lib/session';
import { CALENDAR_STYLES } from '../../data/calendarStyles';
import { FAMILIES, FAMILY_LABELS } from '../../lib/eink/fonts';
import { DITHERS } from '../../lib/eink/image';
import { REFRESH_CHOICES } from '../../data/calendarStyles';

const db = Astro.locals.runtime?.env?.DB;
const userId = db ? await getSessionUserId(Astro.request, db) : null;
if (!userId) return Astro.redirect('/signin?return=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));

const deviceId = Astro.url.searchParams.get('device') ?? '';
const styles = CALENDAR_STYLES.map((s) => ({ id: s.id, label: s.label, note: s.note, corner: !!s.corner, frame: !!s.frame, builder: !!s.builder }));
const families = FAMILIES.map((id) => ({ id, label: FAMILY_LABELS[id] }));
---

<Layout title="Settings — designedbykoda" description="Settings for your E-Ink Calendar." previews>
	<div
		class="cust"
		data-device={deviceId}
		data-styles={JSON.stringify(styles)}
		data-families={JSON.stringify(families)}
		data-dithers={JSON.stringify(DITHERS)}
		data-refreshes={JSON.stringify(REFRESH_CHOICES)}
	>
		<div class="topbar">
			<div class="tb-left">
				<a class="back" id="back" href="/dashboard">← My devices</a>
				<div class="cust-title" id="dev-title">Loading…</div>
			</div>
			<div class="tb-right">
				<span class="save-msg" id="save-msg" aria-live="polite"></span>
				<button type="button" class="btn ghost small" id="revert" disabled>Revert</button>
				<button type="button" class="btn small" id="save" disabled>Save changes</button>
			</div>
		</div>

		<p class="banner" id="banner" hidden></p>

		<div class="stage">
			<nav class="snav" id="snav" aria-label="Settings">
				<div class="sg">Screen</div>
				<button type="button" data-pane="screen"><span class="si"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.2"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1.2"/><rect x="1.5" y="9" width="5.5" height="5.5" rx="1.2"/><rect x="9" y="9" width="5.5" height="5.5" rx="1.2"/></svg></span>Choose a screen</button>
				<button type="button" data-pane="look"><span class="si">Aa</span>Look and font</button>
				<button type="button" data-pane="lang"><span class="si">文</span>Language and units</button>
				<button type="button" class="snav-out" id="nav-builder"><span class="si"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="2"/><rect x="4" y="4" width="4.5" height="3.5" rx="0.8"/><path d="M4 10.5h8M10.5 4.5h1.5"/></svg></span>Layout builder<span class="sarrow" aria-hidden="true">↗</span></button>
				<div class="sg">On the screen</div>
				<button type="button" data-pane="calendars"><span class="si"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="12" rx="2"/><path d="M1.5 6.5h13M5 1v3M11 1v3"/></svg></span>Calendars and timetables</button>
				<button type="button" data-pane="classes"><span class="si">✎</span>Class names<span class="snew">New</span></button>
				<button type="button" data-pane="weather"><span class="si">☀</span>Weather</button>
				<button type="button" data-pane="habits"><span class="si">✓</span>Habits<span class="snew">New</span></button>
				<button type="button" data-pane="reminders"><span class="si">↻</span>Reminders</button>
				<button type="button" data-pane="countdown"><span class="si"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 1.5h8M4 14.5h8M4.5 1.5c0 3.5 3.5 4.5 3.5 6.5s-3.5 3-3.5 6.5M11.5 1.5c0 3.5-3.5 4.5-3.5 6.5s3.5 3 3.5 6.5"/></svg></span>Countdown</button>
				<button type="button" data-pane="messages"><span class="si">✉</span>Messages<span class="scount" id="nav-msgs"></span></button>
				<div class="sg">When</div>
				<button type="button" data-pane="schedule"><span class="si">◷</span>Schedule and button</button>
				<button type="button" data-pane="away"><span class="si">☾</span>Away and quiet hours<span class="snew">New</span></button>
				<div class="sg">Device</div>
				<button type="button" data-pane="device"><span class="si">⚙</span>This calendar</button>
			</nav>
			<div class="panes" id="panes">
				<section class="pane" data-pane="screen" hidden>
					<h2 class="pane-t">Choose a screen</h2>
					<p class="pane-i">What your calendar shows. Nothing changes until you save.</p>
					<section class="box screen-box">
					<div class="label" id="screen-label">Screen</div>
					<div class="cur">
						<canvas id="cur-thumb" width="400" height="300" aria-hidden="true"></canvas>
						<div class="cur-t"><div class="cur-name" id="cur-name"></div><div class="cur-note" id="cur-note"></div></div>
					</div>
					<div class="details" id="details">
					<div id="opt-sign" hidden>
						<div id="sign-fields"></div>
						<div class="sign-cals" id="sign-cals" hidden>
							<div class="label sub">Calendars for this sign</div>
							<div class="sp-list" id="sign-cal-list"></div>
							<select id="sign-cal-add" aria-label="Add a calendar"></select>
							<p class="muted small sp-hint" id="sign-cal-hint"></p>
						</div>
						<div class="desk" id="desk" hidden>
							<div class="label sub">Status from your phone</div>
							<div id="desk-body"></div>
						</div>
						<a class="btn small ghost" id="sign-builder" href="#">Edit the layout in the builder</a>
						<p class="muted small hint">Opens it in the layout builder as a new design of your own, where you can move things around and add widgets.</p>
					</div>
					<div id="opt-msgs" hidden>
						<p class="muted small">Send messages, or share a link so others can send them from their phone.</p>
						<a class="btn small" id="msgs-open" href="#">Open Messages</a>
					</div>
					<div id="opt-todo" hidden>
						<p class="muted" id="todo-status"></p>
						<a class="btn small" id="todo-connect" href="/api/auth/google/start?tasks=1">Connect Google Tasks</a>
						<p class="muted small hint">Shows your default Google Tasks list. Tick tasks off in Google Tasks or Google Calendar.</p>
					</div>

						<div id="opt-design" hidden>
							<div class="design-acts">
								<a class="btn small" id="design-edit" href="#">Edit this design</a>
								<button type="button" class="btn small ghost" id="design-share" hidden>Share</button>
							</div>
							<p class="muted small hint" id="design-hint">Opens it in the layout builder.</p>
						</div>
					<div id="refresh-box" hidden>
						<div class="label sub">How often it updates</div>
						<div class="seg wrap" id="refreshes" role="radiogroup" aria-label="How often the screen updates"></div>
						<p class="muted small hint" id="refresh-hint"></p>
					</div>

						<div id="pic-box" hidden>

					<div class="seg" id="corner-seg" role="radiogroup" aria-label="Top right of the Agenda">
						<label><input type="radio" name="corner" value="calendar" checked /><span>Mini calendar</span></label>
						<label><input type="radio" name="corner" value="image" /><span>Picture</span></label>
					</div>
					<p class="muted small pic-intro" id="pic-intro">The Agenda's top right corner can show a picture instead of the mini calendar.</p>

					<div id="picture-tools" hidden>
						<div class="drop" id="drop" tabindex="0" role="button" aria-label="Upload a picture">
							<input type="file" id="file" accept="image/*" hidden />
							<span id="drop-text">Choose a picture, or drop one here</span>
						</div>

						<div id="editor" hidden>
							<div class="ed-grid">
								<div class="ed-left">
									<div class="ed-box"><canvas id="ed" aria-label="Picture editor. Drag to move the picture."></canvas></div>
									<p class="muted small" id="ed-note">Drag to move it, scroll to zoom. 184 × 140 black and white dots.</p>
								</div>
								<div class="ed-right">
									<div class="label sub">Dithering style</div>
									<div class="seg wrap" id="dithers" role="radiogroup" aria-label="Dithering style"></div>

									

									<div class="ed-actions">
										<label class="check"><input type="checkbox" id="invert" /><span class="cbox" aria-hidden="true"></span><span>Invert</span></label>
										<div class="ed-btns">
											<button type="button" class="sp-pill" id="ed-reset">Reset</button>
											<button type="button" class="sp-pill" id="ed-replace">New picture</button>
										</div>
									</div>
								</div>
							</div>
							<div class="sliders">
										<label class="slider"><span>Zoom</span><input type="range" id="s-zoom" min="1" max="4" step="0.01" /><output id="o-zoom"></output></label>
										<label class="slider"><span>Exposure</span><input type="range" id="s-exposure" min="-2" max="2" step="0.05" /><output id="o-exposure"></output></label>
										<label class="slider"><span>Brightness</span><input type="range" id="s-brightness" min="-100" max="100" step="1" /><output id="o-brightness"></output></label>
										<label class="slider"><span>Contrast</span><input type="range" id="s-contrast" min="-100" max="100" step="1" /><output id="o-contrast"></output></label>
										<label class="slider"><span>Cut-off</span><input type="range" id="s-threshold" min="0" max="255" step="1" /><output id="o-threshold"></output></label>
									</div>
									<p class="muted small hint">Cut-off: right for more black, left for more white.</p>
						</div>
					</div>

						</div>
						<div id="deco-box" hidden>
							<div class="label sub">Festive border</div>
							<div class="seg" id="deco-when" role="radiogroup" aria-label="Festive border">
								<label><input type="radio" name="deco" value="off" /><span>Off</span></label>
								<label><input type="radio" name="deco" value="december" /><span>In December</span></label>
								<label><input type="radio" name="deco" value="always" /><span>Always</span></label>
							</div>
							<label class="deco-text" id="deco-text-row"><span class="label sub">Greeting along the bottom</span><input class="txt" id="deco-text" type="text" placeholder="Leave empty for none" autocomplete="off" /></label>
							<p class="muted small sp-hint" id="deco-hint"></p>
						</div>
					</div>
					</section>
					<div class="picker-inline" id="picker">
				<div class="cats" id="cats" role="tablist" aria-label="Show">
					<button type="button" class="cat on" data-f="all">All</button>
					<button type="button" class="cat" data-f="cal">Calendar</button>
					<button type="button" class="cat" data-f="sign">Signs</button>
					<button type="button" class="cat" data-f="glance">At a glance</button>
					<button type="button" class="cat" data-f="mine">Your designs</button>
				</div>
						<div class="picker-scroll">
							<div class="layouts" id="layouts" role="radiogroup" aria-label="Screen"></div>
					<div class="gname" id="mine-head">Your designs</div>
					<div class="layouts" id="design-cards"></div>
						</div>
					</div>

				</section>
				<section class="pane" data-pane="look" hidden>
					<h2 class="pane-t">Look and font</h2>
					<p class="pane-i">The font, and light or dark.</p>
					<section class="box">
							<div class="label sub">Font</div>
							<div class="fonts" id="fonts" role="radiogroup" aria-label="Font"></div>
							<div style="margin-top:1.2em">

					<label class="switch">
						<input type="checkbox" id="dark" />
						<span class="track" aria-hidden="true"></span>
						<span class="switch-text">Dark mode <small>white on black</small></span>
					</label>

							</div>
					</section>

				</section>
				<section class="pane" data-pane="lang" hidden>
					<h2 class="pane-t">Language and units</h2>
					<p class="pane-i">The screen's language, temperature and clock.</p>
					<section class="box">
					<div class="label sub">Language</div>
					<div class="seg" id="lang" role="radiogroup" aria-label="Language">
						<label><input type="radio" name="lang" value="en" /><span>English</span></label>
						<label><input type="radio" name="lang" value="ja" /><span>日本語</span></label>
					</div>
					<p class="muted small hint">Changes the screen's labels. Event names stay as they are.</p>
					<div class="label sub" style="margin-top:1.6em">Word of the day</div>
					<div class="seg" id="wordlang" role="radiogroup" aria-label="Word of the day language">
						<label><input type="radio" name="wordlang" value="ja" /><span>Japanese words</span></label>
						<label><input type="radio" name="wordlang" value="en" /><span>English words</span></label>
					</div>
					<p class="muted small hint">Which language the Word of the day teaches. Japanese words come with how to read them and their meaning in English; English words come with a short meaning, in Japanese if the screen is in Japanese.</p>
					<div class="label sub" style="margin-top:1.6em">Temperature</div>
					<div class="seg" id="unit" role="radiogroup" aria-label="Temperature unit">
						<label><input type="radio" name="unit" value="c" /><span>°C Celsius</span></label>
						<label><input type="radio" name="unit" value="f" /><span>°F Fahrenheit</span></label>
					</div>
					<div class="label sub" style="margin-top:1.6em">Clock</div>
					<div class="seg" id="clock" role="radiogroup" aria-label="Clock">
						<label><input type="radio" name="clock" value="24" /><span>24-hour (14:00)</span></label>
						<label><input type="radio" name="clock" value="12" /><span>12-hour (2:00pm)</span></label>
					</div>

					</section>

				</section>
				<section class="pane" data-pane="calendars" hidden>
					<h2 class="pane-t">Calendars and timetables</h2>
					<p class="pane-i">Everything your screens can show. Switch a calendar off to hide it without removing it, and on again when you want it back. Saves straight away.</p>
					<div class="label">Google Calendar</div>
					<div id="sp-cals"><p class="muted small">Loading…</p></div>
					<div class="label" style="margin-top:1.8em">School timetables and other calendars</div>
					<div id="sp-feeds"></div>
					<p class="muted small cal-note">Every screen shows the calendars that are on. Meeting room and Waiting room can keep to their own instead, even ones switched off here: choose them with the sign in <a href="#screen" data-go="screen">Choose a screen</a>.</p>

				</section>
				<section class="pane" data-pane="classes" hidden>
					<h2 class="pane-t">Class names</h2>
					<p class="pane-i">Your timetable calls classes by codes. Give them proper names, and say what to bring. Saves when you press Save class names.</p>
					<div id="sp-classes"></div>

				</section>
				<section class="pane" data-pane="weather" hidden>
					<h2 class="pane-t">Weather</h2>
					<p class="pane-i">Where the weather comes from. Saves straight away.</p>
					<div id="sp-weather"></div>

				</section>
				<section class="pane" data-pane="habits" hidden>
					<h2 class="pane-t">Habits</h2>
					<p class="pane-i">Things to do every day. Tick them off here; the screen shows your streaks.</p>
					<section class="box">
					<div id="opt-hab">
						<div class="label sub">Habits</div>
						<div id="hab-list"></div>
						<button type="button" class="btn small ghost" id="hab-add">+ Add a habit</button>
						<p class="muted small hint">Tick off the days you did it, then save. Your calendar shows the new streak at midnight, or straight away if you press its button.</p>
					</div>
					</section>
					<p class="where" id="where-habits"></p>

				</section>
				<section class="pane" data-pane="reminders" hidden>
					<h2 class="pane-t">Reminders</h2>
					<p class="pane-i">Bin day and other things that repeat.</p>
					<section class="box">
					<div id="opt-rem">
						<div class="label sub">Reminders</div>
						<div id="rem-list"></div>
						<button type="button" class="btn small ghost" id="rem-add">+ Add a reminder</button>
						<p class="muted small hint">Shown on the Reminders screen, and in the Reminders widget in your own designs. They don't go in your Google Calendar.</p>
					</div>
					</section>
					<p class="where" id="where-reminders"></p>

				</section>
				<section class="pane" data-pane="countdown" hidden>
					<h2 class="pane-t">Countdown</h2>
					<p class="pane-i">Days until something you're looking forward to.</p>
					<section class="box">
					<div id="opt-countdown">
						<div class="label sub">What are you counting down to?</div>
						<input class="txt" id="cd-title" type="text" maxlength="40" placeholder="Japan trip" autocomplete="off" />
						<div class="label sub" style="margin-top:1.3em">On this date</div>
						<input class="txt" id="cd-date" type="date" />
						<p class="muted small hint">Counts down each morning, and says "Today!" on the day.</p>
					</div>
					</section>
					<p class="where" id="where-countdown"></p>

				</section>
				<section class="pane" data-pane="messages" hidden>
					<h2 class="pane-t">Messages</h2>
					<p class="pane-i">Notes for the screen, from you or anyone you share a link with.</p>
					<section class="box"><p class="muted" id="msgs-sum">None on the screen right now.</p><a class="btn small" id="msgs-open2" href="#">Open Messages</a></section>
					<p class="where" id="where-messages"></p>

				</section>
				<section class="pane" data-pane="schedule" hidden>
					<h2 class="pane-t">Schedule and button</h2>
					<p class="pane-i">Show other screens at set times, and choose what the button does.</p>
					<section class="box">
					<label class="switch">
						<input type="checkbox" id="sch-on" />
						<span class="track" aria-hidden="true"></span>
						<span class="switch-text">Show other screens at set times</span>
					</label>
					<div id="sch-body" hidden>
						<div class="sch-presets" id="sch-presets"></div>
						<div id="sch-slots"></div>
						<button type="button" class="btn ghost small" id="sch-add">+ Add a time</button>
						<p class="muted small hint" id="sch-rest"></p>
						<div class="label sub" style="margin-top:1.4em">Your week</div>
						<div class="week" id="sch-week"></div>
						<div class="week-key" id="sch-key"></div>
					</div>

					<div class="label sub" style="margin-top:1.8em">The button on the calendar</div>
					<div class="seg" id="btn-mode" role="radiogroup" aria-label="What the button does">
						<label><input type="radio" name="btnmode" value="refresh" /><span>Refreshes</span></label>
						<label><input type="radio" name="btnmode" value="next" /><span>Flips to the next screen</span></label>
					</div>
					<div id="cycle-box" hidden>
						<p class="muted small hint">Screens it flips through, after your main layout:</p>
						<div class="chips" id="cycle-chips"></div>
					</div>
					<p class="muted small hint" id="btn-hint"></p>
					<p class="banner small" id="sch-banner" hidden>Schedules need a one-off database update on the server (schema-screens.sql) before they can be saved.</p>

					</section>

				</section>
				<section class="pane" data-pane="away" hidden>
					<h2 class="pane-t">Away and quiet hours</h2>
					<p class="pane-i">Saves straight away.</p>
					<div id="sp-away"></div>

				</section>
				<section class="pane" data-pane="device" hidden>
					<h2 class="pane-t">This calendar</h2>
					<p class="pane-i">Its name, firmware and pairing. Saves straight away.</p>
					<div id="sp-device"></div>

				</section>
			</div>
			<div class="left" id="left">
				<div class="view-pill" id="view-pill" hidden>
					<span id="view-text"></span>
					<button type="button" class="link" id="view-back">Show the main layout</button>
				</div>
				<div class="screen-wrap" id="screen-wrap">
					<canvas id="screen" width="557" height="477" aria-label="Preview of your calendar screen"></canvas>
				</div>
				<div class="batt-line" id="batt-line" aria-live="polite"></div>
			</div>

		</div>

		<div class="guard" id="guard" hidden>
			<div class="guard-box" role="alertdialog" aria-labelledby="guard-title">
				<div class="guard-title" id="guard-title">Save your changes?</div>
				<p class="muted">You changed how this calendar looks, but haven't saved yet.</p>
				<div class="guard-btns">
					<button type="button" class="btn small" id="g-save">Save and leave</button>
					<button type="button" class="btn small ghost" id="g-discard">Leave without saving</button>
					<button type="button" class="link" id="g-stay">Keep editing</button>
				</div>
			</div>
		</div>
	</div>
	<CitySearchStyles />
</Layout>

<script>
	import { renderPreview, paint, paintScreen, loadFonts } from '../../lib/eink/previewKit';
	import { defaultFontFor } from '../../lib/eink/layouts';
	import { Draw } from '../../lib/eink/draw';
	import { TEMPLATES, sanitizeLayout, isSignStyle, sanitizeSign, signLayout, SIGN_DEFAULTS, type SignCfg } from '../../lib/eink/builder/model';
	import { renderDrawList } from '../../lib/eink/preview';
	import { sampleFrameBytes } from '../../lib/eink/sampleFrame';
	import { ask } from '../../lib/dialog';
	import { DECO_DEFAULT, DECO_TEXT_MAX, sanitizeDeco, type FrameDeco } from '../../lib/eink/festive';
	import { EMPTY_SCHEDULE, SCHEDULE_PRESETS, ALL_DAYS, WEEKDAYS, MAX_SLOTS, activeSlot, activeStyle, cycleList, daysText, minutesToHHMM, hhmmToMinutes, type Schedule, type Slot } from '../../lib/eink/schedule';
	import { estimate, measured, lifeText } from '../../lib/eink/batteryLife';
	import { batteryPercent } from '../../lib/eink/battery';
	import { layoutNeeds } from '../../lib/eink/builder/model';
	import { dropdown, type Dropdown } from '../../lib/dropdown';
	import { mountCalendars, mountFeeds, mountClasses, classesPrompt, mountWeather, mountAway, mountDevice } from '../../lib/settingsPanes';
	import { shareDialog } from '../../lib/shareDialog';
	import { MAX_HABITS, MAX_HABIT_NAME, sampleHabits, sanitizeHabits, streak as habitStreak, type Habit } from '../../lib/eink/habits';
	import { MAX_REMINDERS, MAX_REMINDER_TEXT, repeatText, sampleReminders, sanitizeReminders, type Reminder } from '../../lib/eink/reminders';
	import {
		CORNER,
		FRAME,
		DEFAULT_IMAGE_SETTINGS,
		cleanSettings,
		ditherGray,
		packBits,
		bytesToB64,
		type ImageSettings,
	} from '../../lib/eink/image';

	const root = document.querySelector('.cust') as HTMLElement;
