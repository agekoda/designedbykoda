---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getSessionUserId } from '../../lib/session';
import { CALENDAR_STYLES } from '../../data/calendarStyles';
import { FAMILIES, FAMILY_LABELS } from '../../lib/eink/fonts';
import { DITHERS } from '../../lib/eink/image';
import { REFRESH_CHOICES } from '../../data/calendarStyles';

const db = Astro.locals.runtime?.env?.DB;
const userId = db ? await getSessionUserId(Astro.request, db) : null;
if (!userId) return Astro.redirect('/setup');

const deviceId = Astro.url.searchParams.get('device') ?? '';
const styles = CALENDAR_STYLES.map((s) => ({ id: s.id, label: s.label, note: s.note, corner: !!s.corner, frame: !!s.frame, builder: !!s.builder }));
const families = FAMILIES.map((id) => ({ id, label: FAMILY_LABELS[id] }));
---

<Layout title="Customize display — designedbykoda" description="Change how your E-Ink Calendar looks.">
	<div
		class="cust"
		data-device={deviceId}
		data-styles={JSON.stringify(styles)}
		data-families={JSON.stringify(families)}
		data-dithers={JSON.stringify(DITHERS)}
		data-refreshes={JSON.stringify(REFRESH_CHOICES)}
	>
		<div class="topbar">
			<div class="tb-left">
				<a class="back" id="back" href="/dashboard">← My devices</a>
				<div class="cust-title" id="dev-title">Loading…</div>
			</div>
			<div class="tb-right">
				<span class="save-msg" id="save-msg" aria-live="polite"></span>
				<button type="button" class="btn ghost small" id="revert" disabled>Revert</button>
				<button type="button" class="btn small" id="save" disabled>Save changes</button>
			</div>
		</div>

		<p class="banner" id="banner" hidden></p>

		<div class="stage">
			<div class="left">
				<div class="screen-wrap" id="screen-wrap">
					<canvas id="screen" width="675" height="506" aria-label="Preview of your calendar screen"></canvas>
				</div>
			</div>

			<div class="right">
				<div class="tabs" role="tablist" aria-label="Display settings">
					<button type="button" role="tab" class="tab on" data-tab="layout">Layout</button>
					<button type="button" role="tab" class="tab" data-tab="font">Font</button>
					<button type="button" role="tab" class="tab" data-tab="display">Display</button>
					<button type="button" role="tab" class="tab" data-tab="picture" id="tab-picture-btn" hidden>Picture</button>
					<button type="button" role="tab" class="tab" data-tab="options" id="tab-options-btn" hidden>Options</button>
				</div>

				<section class="tabpanel" data-panel="layout">
					<div class="modes" id="modes" role="radiogroup" aria-label="How do you want to set up the screen?">
						<button type="button" class="mode" data-mode="preset" role="radio"><span class="mode-t">Ready-made layouts</span><span class="mode-n">Pick one and you are done</span></button>
						<button type="button" class="mode" data-mode="custom" role="radio"><span class="mode-t">Design your own</span><span class="mode-n">Drag, drop and resize widgets</span></button>
					</div>
					<div class="layouts" id="layouts" role="radiogroup" aria-label="Layout"></div>
					<div class="custom-box" id="custom-box" hidden>
						<p class="muted" id="custom-status"></p>
						<a class="btn" id="custom-open" href="#">Open the layout builder</a>
						<p class="muted small hint">Start from a template or a blank screen, then add dates, events, weather, the moon, quotes, countdowns, tasks and more. Move them anywhere and resize them. The preview on the left shows your design as it is now.</p>
					</div>
				</section>

				<section class="tabpanel" data-panel="font" hidden>
					<div class="fonts" id="fonts" role="radiogroup" aria-label="Font"></div>
				</section>

				<section class="tabpanel" data-panel="display" hidden>
					<label class="switch">
						<input type="checkbox" id="dark" />
						<span class="track" aria-hidden="true"></span>
						<span class="switch-text">Dark mode <small>white on black</small></span>
					</label>
					<div class="label sub" style="margin-top:1.6em">Language</div>
					<div class="seg" id="lang" role="radiogroup" aria-label="Language">
						<label><input type="radio" name="lang" value="en" /><span>English</span></label>
						<label><input type="radio" name="lang" value="ja" /><span>日本語</span></label>
					</div>
					<p class="muted small hint">Japanese writes the weekdays, months, headings and messages on the screen in Japanese. Event and task names stay as they are in your calendar, in plain English letters. Text you type yourself (a countdown name, the layout builder's text boxes) can be Japanese.</p>
					<div id="refresh-box" hidden>
						<div class="label sub" style="margin-top:1.6em">How often it updates</div>
						<div class="seg wrap" id="refreshes" role="radiogroup" aria-label="How often the Timeline updates"></div>
						<p class="muted small hint" id="refresh-hint"></p>
					</div>
					<p class="muted small hint">Dark mode swaps the colours: white text on a black screen. The pairing and reconnect screens always stay black on white.</p>
				</section>

				<section class="tabpanel" data-panel="options" hidden>
					<div id="opt-countdown" hidden>
						<div class="label sub">What are you counting down to?</div>
						<input class="txt" id="cd-title" type="text" maxlength="40" placeholder="Japan trip" autocomplete="off" />
						<div class="label sub" style="margin-top:1.3em">On this date</div>
						<input class="txt" id="cd-date" type="date" />
						<p class="muted small hint">Shows how many days are left. The number goes down each morning, and it says "Today!" on the day.</p>
					</div>
					<div id="opt-todo" hidden>
						<p class="muted" id="todo-status"></p>
						<a class="btn small" id="todo-connect" href="/api/auth/google/start?tasks=1">Connect Google Tasks</a>
						<p class="muted small hint">Shows your default Google Tasks list: open tasks first (soonest due first), then anything you ticked off in the last day. Tick tasks off in Google Tasks or in the side panel of Google Calendar. The calendar updates each morning.</p>
					</div>
				</section>

				<section class="tabpanel" data-panel="picture" hidden>
					<div class="seg" id="corner-seg" role="radiogroup" aria-label="Top right of the Agenda">
						<label><input type="radio" name="corner" value="calendar" checked /><span>Mini calendar</span></label>
						<label><input type="radio" name="corner" value="image" /><span>Picture</span></label>
					</div>
					<p class="muted small pic-intro" id="pic-intro">The Agenda's top right corner can show a picture instead of the mini calendar.</p>

					<div id="picture-tools" hidden>
						<div class="drop" id="drop" tabindex="0" role="button" aria-label="Upload a picture">
							<input type="file" id="file" accept="image/*" hidden />
							<span id="drop-text">Choose a picture, or drop one here</span>
						</div>

						<div id="editor" hidden>
							<div class="ed-grid">
								<div class="ed-left">
									<div class="ed-box"><canvas id="ed" aria-label="Picture editor. Drag to move the picture."></canvas></div>
									<p class="muted small" id="ed-note">Drag to move it, scroll to zoom. 184 × 140 black and white dots.</p>
								</div>
								<div class="ed-right">
									<div class="label sub">Dithering style</div>
									<div class="seg wrap" id="dithers" role="radiogroup" aria-label="Dithering style"></div>

									

									<div class="ed-actions">
										<label class="check"><input type="checkbox" id="invert" /><span class="box" aria-hidden="true"></span><span>Invert</span></label>
										<button type="button" class="link" id="ed-reset">Reset</button>
										<button type="button" class="link" id="ed-replace">New picture</button>
									</div>
								</div>
							</div>
							<div class="sliders">
										<label class="slider"><span>Zoom</span><input type="range" id="s-zoom" min="1" max="4" step="0.01" /><output id="o-zoom"></output></label>
										<label class="slider"><span>Exposure</span><input type="range" id="s-exposure" min="-2" max="2" step="0.05" /><output id="o-exposure"></output></label>
										<label class="slider"><span>Brightness</span><input type="range" id="s-brightness" min="-100" max="100" step="1" /><output id="o-brightness"></output></label>
										<label class="slider"><span>Contrast</span><input type="range" id="s-contrast" min="-100" max="100" step="1" /><output id="o-contrast"></output></label>
										<label class="slider"><span>Cut-off</span><input type="range" id="s-threshold" min="0" max="255" step="1" /><output id="o-threshold"></output></label>
									</div>
									<p class="muted small hint">Cut-off decides how bright a spot has to be to print as white: right for more black, left for more white.</p>
						</div>
					</div>
				</section>
			</div>
		</div>

		<div class="guard" id="guard" hidden>
			<div class="guard-box" role="alertdialog" aria-labelledby="guard-title">
				<div class="guard-title" id="guard-title">Save your changes?</div>
				<p class="muted">You changed how this calendar looks, but haven't saved yet.</p>
				<div class="guard-btns">
					<button type="button" class="btn small" id="g-save">Save and leave</button>
					<button type="button" class="btn small ghost" id="g-discard">Leave without saving</button>
					<button type="button" class="link" id="g-stay">Keep editing</button>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script>
	import { renderPreview, paint, paintScreen, loadFonts } from '../../lib/eink/previewKit';
	import { defaultFontFor } from '../../lib/eink/layouts';
	import { Draw } from '../../lib/eink/draw';
	import { TEMPLATES, sanitizeLayout } from '../../lib/eink/builder/model';
	import { renderDrawList } from '../../lib/eink/preview';
	import { sampleFrameBytes } from '../../lib/eink/sampleFrame';
	import {
		CORNER,
		FRAME,
		DEFAULT_IMAGE_SETTINGS,
		cleanSettings,
		ditherGray,
		packBits,
		bytesToB64,
		type ImageSettings,
	} from '../../lib/eink/image';

	const root = document.querySelector('.cust') as HTMLElement;
	const styles: { id: string; label: string; note: string; corner: boolean; frame: boolean; builder: boolean }[] = JSON.parse(root.dataset.styles!);
	const families: { id: string; label: string }[] = JSON.parse(root.dataset.families!);
	const dithers: { id: string; label: string; note: string }[] = JSON.parse(root.dataset.dithers!);
	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

	const screen = $<HTMLCanvasElement>('screen');
	const layoutsEl = $('layouts');
	const fontsEl = $('fonts');
	const darkBox = $<HTMLInputElement>('dark');
	const langEl = $('lang');
	const tabPicBtn = $('tab-picture-btn');
	const tabOptBtn = $('tab-options-btn');
	const cornerSeg = $('corner-seg');
	const picIntro = $('pic-intro');
	const edNote = $('ed-note');
	const optCountdown = $('opt-countdown');
	const optTodo = $('opt-todo');
	const customBox = $('custom-box');
	const modesEl = $('modes');
	const customStatus = $('custom-status');
	const customOpen = $('custom-open') as HTMLAnchorElement;
	const cdTitle = $<HTMLInputElement>('cd-title');
	const cdDate = $<HTMLInputElement>('cd-date');
	const todoStatus = $('todo-status');
	const todoConnect = $<HTMLAnchorElement>('todo-connect');
	const pictureTools = $('picture-tools');
	const drop = $('drop');
	const fileInput = $<HTMLInputElement>('file');
	const dropText = $('drop-text');
	const editor = $('editor');
	const edCanvas = $<HTMLCanvasElement>('ed');
	const ditherEl = $('dithers');
	const refreshEl = $('refreshes');
	const refreshBox = $('refresh-box');
	const refreshHint = $('refresh-hint');
	const refreshes: { sec: number; label: string }[] = JSON.parse(root.dataset.refreshes!);
	const REFRESH_HINTS: Record<number, string> = {
		86400: 'Updates once a day, at midnight. Best battery life. The timeline stays as it was; press the button on the calendar to refresh sooner.',
		43200: 'Twice a day, while the day is happening. Good battery life.',
		14400: 'Every 4 hours, only while the day is happening. The "now" bar moves along the timeline. Medium battery life.',
		7200: 'Every 2 hours, only while the day is happening. The "now" bar moves along the timeline. Shorter battery life.',
		3600: 'Every hour, only while the day is happening, and it sleeps overnight. The shortest battery life: weeks rather than months.',
	};
	const saveBtn = $<HTMLButtonElement>('save');
	const revertBtn = $<HTMLButtonElement>('revert');
	const saveMsg = $('save-msg');
	const banner = $('banner');

	// ---------------------------------------------------------------- state
	interface State {
		style: string;
		font: string | null; // null = the layout's own font
		dark: boolean;
		lang: 'en' | 'ja';
		refreshSec: number;
		cornerMode: 'calendar' | 'image';
		cfg: ImageSettings; // the Agenda's picture settings
		src: string | null; // the Agenda's photo (small JPEG data URL)
		fcfg: ImageSettings; // the Photo frame's picture settings
		fsrc: string | null; // the Photo frame's photo
		countdown: { title: string; date: string };
	}
	// The picture editor works on one of two pictures: the Agenda's corner picture, or the Photo frame's full-screen one.
	type PicKey = 'corner' | 'frame';
	interface Pic {
		img: HTMLImageElement | null;
		bytes: Uint8Array | null;
		dots: Uint8Array | null;
		changed: boolean; // differs from what the server has
	}
	const pics: Record<PicKey, Pic> = {
		corner: { img: null, bytes: null, dots: null, changed: false },
		frame: { img: null, bytes: null, dots: null, changed: false },
	};
	let deviceId = root.dataset.device || '';
	let hasWeather = false;
	let loc: { lat: number; lon: number } | null = null;
	let tasksGranted = false;
	let customLayout: any = null;
	let lastPreset = 'agenda';
	let vbat: number | null = null;
	let st: State = {
		style: 'agenda',
		font: null,
		dark: false,
		lang: 'en',
		refreshSec: 86400,
		cornerMode: 'calendar',
		cfg: { ...DEFAULT_IMAGE_SETTINGS },
		src: null,
		fcfg: { ...DEFAULT_IMAGE_SETTINGS },
		fsrc: null,
		countdown: { title: '', date: '' },
	};
	let base = JSON.stringify(st); // what is saved on the server

	const effFont = () => st.font ?? defaultFontFor(st.style);
	const supportsCorner = () => !!styles.find((s) => s.id === st.style)?.corner;
	const isFrame = () => !!styles.find((s) => s.id === st.style)?.frame;
	const pkey = (): PicKey => (isFrame() ? 'frame' : 'corner');
	const P = () => pics[pkey()];
	const dimsOf = (k: PicKey) => (k === 'frame' ? FRAME : CORNER);
	const cfgOf = (k: PicKey) => (k === 'frame' ? st.fcfg : st.cfg);
	const cfgNow = () => cfgOf(pkey());
	const setCfgNow = (c: ImageSettings) => {
		if (isFrame()) st.fcfg = c;
		else st.cfg = c;
	};
	const setSrcNow = (v: string) => {
		if (isFrame()) st.fsrc = v;
		else st.src = v;
	};
	const sampleDate = () => new Date(Date.now() + 25 * 86400000).toISOString().slice(0, 10);

	// Everything beyond the plain calendar a layout needs, for the big preview and for the layout cards.
	function extras(styleId: string, thumb: boolean) {
		const s = styles.find((x) => x.id === styleId);
		const cd = st.countdown.title.trim() && st.countdown.date ? st.countdown : thumb ? { title: 'Japan trip', date: sampleDate() } : null;
		return {
			cornerImage: s?.corner && st.cornerMode === 'image' ? pics.corner.bytes : null,
			frameImage: s?.frame ? (pics.frame.bytes ?? (thumb ? sampleFrameBytes() : null)) : null,
			loc,
			countdown: styleId === 'countdown' ? cd : null,
			custom: styleId === 'custom' ? (thumb && !customLayout?.widgets?.length ? sanitizeLayout(TEMPLATES.find((x) => x.id === 'sky')!.build()) : customLayout) : null,
			tasksState: (thumb || tasksGranted ? 'ok' : 'needs_permission') as 'ok' | 'needs_permission',
		};
	}

	// ---------------------------------------------------------------- picture pipeline
	function cropGray(img: HTMLImageElement, s: ImageSettings, dims: { w: number; h: number }): Float32Array {
		const { w, h } = dims;
		const cover = Math.max(w / img.naturalWidth, h / img.naturalHeight);
		const scale = cover * s.zoom;
		const dw = img.naturalWidth * scale;
		const dh = img.naturalHeight * scale;
		// keep the picture covering the box, and remember the limit so dragging stops at the edge
		const maxX = Math.max(0, (dw - w) / 2);
		const maxY = Math.max(0, (dh - h) / 2);
		s.panX = Math.max(-maxX, Math.min(maxX, s.panX));
		s.panY = Math.max(-maxY, Math.min(maxY, s.panY));
		const c = document.createElement('canvas');
		c.width = w;
		c.height = h;
		const ctx = c.getContext('2d', { willReadFrequently: true })!;
		ctx.fillStyle = '#fff';
		ctx.fillRect(0, 0, w, h);
		ctx.imageSmoothingEnabled = true;
		ctx.imageSmoothingQuality = 'high';
		ctx.drawImage(img, (w - dw) / 2 + s.panX, (h - dh) / 2 + s.panY, dw, dh);
		const d = ctx.getImageData(0, 0, w, h).data;
		const g = new Float32Array(w * h);
		for (let i = 0; i < g.length; i++) g[i] = d[i * 4] * 0.299 + d[i * 4 + 1] * 0.587 + d[i * 4 + 2] * 0.114;
		return g;
	}

	function recompute(k: PicKey) {
		const p = pics[k];
		if (!p.img) {
			p.bytes = null;
			p.dots = null;
			return;
		}
		const { w, h } = dimsOf(k);
		const g = cropGray(p.img, cfgOf(k), dimsOf(k));
		p.dots = ditherGray(g, w, h, cfgOf(k));
		p.bytes = packBits(p.dots, w, h);
		if (k === pkey()) paintEditor();
	}
	const recomputePicture = () => recompute(pkey());

	// the editor canvas: black dots on paper
	function paintEditor() {
		const p = P();
		const { w, h } = dimsOf(pkey());
		edCanvas.style.width = isFrame() ? '380px' : '368px';
		edCanvas.style.aspectRatio = `${w} / ${h}`;
		if (!p.dots) return;
		const px = new Uint8Array(p.dots.length);
		for (let i = 0; i < px.length; i++) px[i] = p.dots[i] ? 0 : 1;
		paint(edCanvas, px, isFrame() ? 1 : 2, w, h);
	}

	function loadSource(dataUrl: string, k: PicKey): Promise<void> {
		return new Promise((resolve, reject) => {
			const img = new Image();
			img.onload = () => {
				pics[k].img = img;
				resolve();
			};
			img.onerror = () => reject(new Error('load'));
			img.src = dataUrl;
		});
	}

	// Shrinks a chosen photo to something small enough to store (a JPEG under ~250 KB).
	async function prepareSource(file: File): Promise<string> {
		const url = URL.createObjectURL(file);
		try {
			const img = new Image();
			await new Promise<void>((res, rej) => {
				img.onload = () => res();
				img.onerror = () => rej(new Error('decode'));
				img.src = url;
			});
			let max = 900;
			for (let attempt = 0; attempt < 5; attempt++) {
				const k = Math.min(1, max / Math.max(img.naturalWidth, img.naturalHeight));
				const c = document.createElement('canvas');
				c.width = Math.max(1, Math.round(img.naturalWidth * k));
				c.height = Math.max(1, Math.round(img.naturalHeight * k));
				const ctx = c.getContext('2d')!;
				ctx.fillStyle = '#fff';
				ctx.fillRect(0, 0, c.width, c.height);
				ctx.imageSmoothingQuality = 'high';
				ctx.drawImage(img, 0, 0, c.width, c.height);
				const out = c.toDataURL('image/jpeg', 0.86 - attempt * 0.08);
				if (out.length < 250_000) return out;
				max = Math.round(max * 0.8);
			}
			throw new Error('big');
		} finally {
			URL.revokeObjectURL(url);
		}
	}

	// ---------------------------------------------------------------- drawing the previews
	let pending = false;
	let thumbsDirty = true;
	function schedule(thumbs = true) {
		if (thumbs) thumbsDirty = true;
		if (pending) return;
		pending = true;
		requestAnimationFrame(async () => {
			pending = false;
			await redraw();
		});
	}

	async function redraw() {
		const common = { font: effFont(), dark: st.dark, lang: st.lang, hasWeather, vbat: vbat ?? 4.12, refreshSec: st.refreshSec };
		try {
			const r = await renderPreview({ ...common, style: st.style, ...extras(st.style, false) });
			const dpr = window.devicePixelRatio || 1;
			// whole-number panel pixels (each dot = k x k real screen pixels) so the dithering stays crisp
			const avail = (screen.parentElement as HTMLElement).clientWidth * dpr;
			const k = Math.max(1, Math.floor(avail / 675));
			paintScreen(screen, r.px, { mode: 'device', scale: k });
			screen.style.width = screen.width / dpr + 'px';
			if (thumbsDirty) {
				thumbsDirty = false;
				for (const s of styles) {
					const cv = layoutsEl.querySelector<HTMLCanvasElement>(`canvas[data-sid="${s.id}"]`);
					if (!cv) continue;
					const t = await renderPreview({ ...common, style: s.id, ...extras(s.id, true) });
					paintScreen(cv, t.px, { mode: 'screen', scale: 1 });
				}
				const fonts = await loadFonts();
				for (const f of families) {
					const cv = fontsEl.querySelector<HTMLCanvasElement>(`canvas[data-fid="${f.id}"]`);
					if (!cv) continue;
					const d = new Draw(f.id as any, st.dark);
					d.text(10, 26, 'mb', 'Thursday 29');
					d.text(10, 50, 's', 'Team standup');
					const rr = renderDrawList(d.toString(), fonts);
					// the sample only needs the top-left 200x60 corner of the 400x300 screen
					const px = new Uint8Array(200 * 60);
					for (let y = 0; y < 60; y++) for (let x = 0; x < 200; x++) px[y * 200 + x] = rr.px[y * 400 + x];
					paint(cv, px, 2, 200, 60);
				}
			}
		} catch {
			banner.hidden = false;
			banner.textContent = 'Could not load the preview fonts. Try refreshing the page.';
		}
	}

	// ---------------------------------------------------------------- tabs
	let activeTab = 'layout';
	function showTab(name: string) {
		activeTab = name;
		document.querySelectorAll<HTMLElement>('.tab').forEach((t) => t.classList.toggle('on', t.dataset.tab === name));
		document.querySelectorAll<HTMLElement>('.tabpanel').forEach((p) => (p.hidden = p.dataset.panel !== name));
	}
	document.querySelectorAll<HTMLElement>('.tab').forEach((t) => t.addEventListener('click', () => showTab(t.dataset.tab!)));

	// ---------------------------------------------------------------- controls
	function buildControls() {
		layoutsEl.innerHTML = styles
			.filter((s) => !s.builder)
			.map(
				(s) => `<label class="lay"><input type="radio" name="layout" value="${s.id}" /><span class="lay-card"><canvas data-sid="${s.id}" width="400" height="300"></canvas><span class="lay-name">${s.label}</span><span class="lay-note">${s.note}</span></span></label>`
			)
			.join('');
		fontsEl.innerHTML = families
			.map(
				(f) => `<label class="fnt"><input type="radio" name="font" value="${f.id}" /><span class="fnt-card"><canvas data-fid="${f.id}" width="400" height="120"></canvas><span class="fnt-name">${f.label}</span></span></label>`
			)
			.join('');
		refreshEl.innerHTML = refreshes
			.map((x) => `<label><input type="radio" name="refresh" value="${x.sec}" /><span>${x.label}</span></label>`)
			.join('');
		refreshEl.addEventListener('change', (e) => {
			st.refreshSec = parseInt((e.target as HTMLInputElement).value, 10);
			syncControls();
			schedule();
			changed();
		});
		ditherEl.innerHTML = dithers
			.map((d) => `<label title="${d.note}"><input type="radio" name="dither" value="${d.id}" /><span>${d.label}</span></label>`)
			.join('');

		modesEl.addEventListener('click', (e) => {
			const m = (e.target as HTMLElement).closest<HTMLElement>('.mode');
			if (!m) return;
			const to = m.dataset.mode === 'custom' ? 'custom' : lastPreset === 'custom' ? 'agenda' : lastPreset;
			if (to === st.style) return;
			st.style = to;
			syncControls();
			schedule();
			changed();
		});
		layoutsEl.addEventListener('change', (e) => {
			st.style = (e.target as HTMLInputElement).value;
			syncControls();
			schedule();
			changed();
		});
		fontsEl.addEventListener('change', (e) => {
			st.font = (e.target as HTMLInputElement).value;
			syncControls();
			schedule();
			changed();
		});
		cdTitle.addEventListener('input', () => {
			st.countdown.title = cdTitle.value;
			schedule();
			changed();
		});
		cdDate.addEventListener('input', () => {
			st.countdown.date = cdDate.value;
			schedule();
			changed();
		});
		langEl.addEventListener('change', (e) => {
			st.lang = (e.target as HTMLInputElement).value === 'ja' ? 'ja' : 'en';
			schedule();
			changed();
		});
		darkBox.addEventListener('change', () => {
			st.dark = darkBox.checked;
			schedule();
			changed();
		});
		document.querySelectorAll<HTMLInputElement>('input[name="corner"]').forEach((r) =>
			r.addEventListener('change', () => {
				st.cornerMode = r.value as 'calendar' | 'image';
				syncControls();
				schedule();
				changed();
			})
		);
		ditherEl.addEventListener('change', (e) => {
			cfgNow().dither = (e.target as HTMLInputElement).value as any;
			pictureEdited();
		});
		const sliders: [string, keyof ImageSettings][] = [
			['zoom', 'zoom'],
			['exposure', 'exposure'],
			['brightness', 'brightness'],
			['contrast', 'contrast'],
			['threshold', 'threshold'],
		];
		for (const [id, key] of sliders) {
			$<HTMLInputElement>('s-' + id).addEventListener('input', (e) => {
				(cfgNow() as any)[key] = parseFloat((e.target as HTMLInputElement).value);
				pictureEdited();
			});
		}
		$<HTMLInputElement>('invert').addEventListener('change', (e) => {
			cfgNow().invert = (e.target as HTMLInputElement).checked;
			pictureEdited();
		});
		$('ed-reset').addEventListener('click', () => {
			setCfgNow({ ...DEFAULT_IMAGE_SETTINGS });
			syncControls();
			pictureEdited();
		});
		const choose = () => fileInput.click();
		$('ed-replace').addEventListener('click', choose);
		drop.addEventListener('click', choose);
		drop.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				choose();
			}
		});
		['dragenter', 'dragover'].forEach((ev) =>
			drop.addEventListener(ev, (e) => {
				e.preventDefault();
				drop.classList.add('over');
			})
		);
		['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove('over')));
		drop.addEventListener('drop', (e) => {
			e.preventDefault();
			const f = (e as DragEvent).dataTransfer?.files?.[0];
			if (f) takeFile(f);
		});
		fileInput.addEventListener('change', () => {
			const f = fileInput.files?.[0];
			if (f) takeFile(f);
			fileInput.value = '';
		});

		// drag to move the picture inside its box
		let drag: { x: number; y: number; px: number; py: number } | null = null;
		edCanvas.addEventListener('pointerdown', (e) => {
			if (!P().img) return;
			edCanvas.setPointerCapture(e.pointerId);
			drag = { x: e.clientX, y: e.clientY, px: cfgNow().panX, py: cfgNow().panY };
		});
		edCanvas.addEventListener('pointermove', (e) => {
			if (!drag) return;
			const k = dimsOf(pkey()).w / edCanvas.getBoundingClientRect().width; // screen px -> dots
			cfgNow().panX = drag.px + (e.clientX - drag.x) * k;
			cfgNow().panY = drag.py + (e.clientY - drag.y) * k;
			pictureEdited();
		});
		const end = () => (drag = null);
		edCanvas.addEventListener('pointerup', end);
		edCanvas.addEventListener('pointercancel', end);
		edCanvas.addEventListener(
			'wheel',
			(e) => {
				if (!P().img) return;
				e.preventDefault();
				cfgNow().zoom = Math.max(1, Math.min(4, cfgNow().zoom * (e.deltaY < 0 ? 1.06 : 1 / 1.06)));
				syncControls();
				pictureEdited();
			},
			{ passive: false }
		);
	}

	async function takeFile(f: File) {
		if (!f.type.startsWith('image/')) {
			flash('That is not an image.', true);
			return;
		}
		try {
			const src = await prepareSource(f);
			await loadSource(src, pkey());
			setSrcNow(src);
			setCfgNow({ ...DEFAULT_IMAGE_SETTINGS, dither: cfgNow().dither });
			if (!isFrame()) st.cornerMode = 'image';
			syncControls();
			pictureEdited();
		} catch {
			flash("Couldn't read that picture. Try a JPEG or PNG.", true);
		}
	}

	function pictureEdited() {
		P().changed = true;
		syncSliders();
		recomputePicture();
		schedule(false);
		// only the Agenda's (or the Photo frame's) thumbnail changes when the picture does
		const sid = isFrame() ? 'frame' : 'agenda';
		const cv = layoutsEl.querySelector<HTMLCanvasElement>(`canvas[data-sid="${sid}"]`);
		if (cv)
			renderPreview({ style: sid, font: effFont(), dark: st.dark, lang: st.lang, hasWeather, vbat: vbat ?? 4.12, ...extras(sid, true) }).then((r) => paintScreen(cv, r.px, { mode: 'screen', scale: 1 }));
		changed();
	}

	function syncSliders() {
		const c = cfgNow();
		const set = (id: string, v: number, text: string) => {
			$<HTMLInputElement>('s-' + id).value = String(v);
			$('o-' + id).textContent = text;
		};
		set('zoom', c.zoom, c.zoom.toFixed(2) + '×');
		set('exposure', c.exposure, (c.exposure > 0 ? '+' : '') + c.exposure.toFixed(2));
		set('brightness', c.brightness, String(Math.round(c.brightness)));
		set('contrast', c.contrast, String(Math.round(c.contrast)));
		set('threshold', c.threshold, String(Math.round(c.threshold)));
		$<HTMLInputElement>('invert').checked = c.invert;
	}

	function syncControls() {
		layoutsEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === st.style));
		fontsEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === effFont()));
		darkBox.checked = st.dark;
		langEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === st.lang));
		refreshBox.hidden = st.style !== 'timeline';
		refreshEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = parseInt(i.value, 10) === st.refreshSec));
		refreshHint.textContent = REFRESH_HINTS[st.refreshSec] ?? '';

		// Picture tab: the Agenda's corner picture, or the Photo frame's whole-screen one
		tabPicBtn.hidden = !(supportsCorner() || isFrame());
		if (tabPicBtn.hidden && activeTab === 'picture') showTab('layout');
		cornerSeg.hidden = isFrame();
		picIntro.hidden = isFrame();
		document.querySelectorAll<HTMLInputElement>('input[name="corner"]').forEach((r) => (r.checked = r.value === st.cornerMode));
		pictureTools.hidden = !(isFrame() || st.cornerMode === 'image');
		editor.hidden = !P().img;
		drop.hidden = !!P().img;
		dropText.textContent = isFrame() ? 'Choose a photo for the whole screen, or drop one here' : 'Choose a picture, or drop one here';
		edNote.textContent = isFrame() ? 'Drag to move it, scroll to zoom. 400 × 300 black and white dots.' : 'Drag to move it, scroll to zoom. 184 × 140 black and white dots.';
		ditherEl.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = i.value === cfgNow().dither));
		syncSliders();
		paintEditor();

		// Options tab: the Countdown's name and date, or connecting Google Tasks
		const opt = st.style === 'countdown' ? 'countdown' : (st.style === 'todo' || st.style === 'planner') ? 'todo' : null;
		tabOptBtn.hidden = !opt;
		tabOptBtn.textContent = opt === 'countdown' ? 'Countdown' : opt === 'todo' ? 'Tasks' : 'Options';
		if (!opt && activeTab === 'options') showTab('layout');
		optCountdown.hidden = opt !== 'countdown';
		optTodo.hidden = opt !== 'todo';
		const isCustom = st.style === 'custom';
		customBox.hidden = !isCustom;
		layoutsEl.hidden = isCustom;
		modesEl.querySelectorAll<HTMLElement>('.mode').forEach((m) => {
			const on = (m.dataset.mode === 'custom') === isCustom;
			m.classList.toggle('on', on);
			m.setAttribute('aria-checked', String(on));
		});
		if (!isCustom) lastPreset = st.style;
		const nW = customLayout?.widgets?.length ?? 0;
		customStatus.textContent = nW ? `Your design has ${nW} widget${nW === 1 ? '' : 's'}.` : 'You haven\u2019t designed a screen yet.';
		customOpen.textContent = nW ? 'Edit your design' : 'Start designing';
		customOpen.href = '/dashboard/builder?device=' + encodeURIComponent(deviceId);
		if (cdTitle.value !== st.countdown.title) cdTitle.value = st.countdown.title;
		if (cdDate.value !== st.countdown.date) cdDate.value = st.countdown.date;
		todoStatus.textContent = tasksGranted ? 'Google Tasks is connected.' : 'To show your tasks, allow this calendar to read your Google Tasks.';
		todoConnect.textContent = tasksGranted ? 'Reconnect Google Tasks' : 'Connect Google Tasks';
		todoConnect.href = '/api/auth/google/start?tasks=1&return=' + encodeURIComponent('/dashboard/display?device=' + deviceId);
	}

	// ---------------------------------------------------------------- saving
	function flash(text: string, err = false) {
		saveMsg.textContent = text;
		saveMsg.classList.toggle('is-error', err);
		saveMsg.classList.remove('is-dirty');
	}
	function isDirty() {
		return JSON.stringify(st) !== base || pics.corner.changed || pics.frame.changed;
	}
	function changed() {
		const dirty = isDirty();
		saveBtn.disabled = !dirty;
		revertBtn.disabled = !dirty;
		if (dirty) {
			flash('Unsaved changes');
			saveMsg.classList.add('is-dirty');
		}
	}

	async function save() {
		if (st.cornerMode === 'image' && supportsCorner() && !pics.corner.img) {
			flash('Choose a picture first, or switch back to the mini calendar.', true);
			return;
		}
		if (isFrame() && !pics.frame.img) {
			flash('Choose a photo first, or pick another layout.', true);
			return;
		}
		saveBtn.disabled = true;
		flash('Saving…');
		const body: any = { deviceId, style: st.style, font: st.font, dark: st.dark, lang: st.lang, refreshSec: st.refreshSec, countdown: st.countdown };
		const baseState = JSON.parse(base);
		if (supportsCorner() || st.cornerMode === 'image') {
			body.corner = { mode: st.cornerMode };
			if (st.cornerMode === 'image' && pics.corner.img && pics.corner.bytes && (pics.corner.changed || baseState.cornerMode !== 'image')) {
				body.corner.bits = bytesToB64(pics.corner.bytes);
				body.corner.src = st.src;
				body.corner.cfg = st.cfg;
			}
		}
		if (pics.frame.changed && pics.frame.img && pics.frame.bytes) {
			body.frame = { bits: bytesToB64(pics.frame.bytes), src: st.fsrc, cfg: st.fcfg };
		}
		try {
			const res = await fetch('/api/dashboard/display', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});
			const data = await res.json().catch(() => ({}));
			if (!res.ok || !data.ok) throw new Error(data.error || 'Could not save.');
			base = JSON.stringify(st);
			pics.corner.changed = false;
			pics.frame.changed = false;
			flash('Saved. Press the button on your calendar to see it now.');
			saveBtn.disabled = true;
			revertBtn.disabled = true;
		} catch (err: any) {
			flash(err?.message || 'Could not save.', true);
			saveBtn.disabled = false;
		}
	}

	async function revert() {
		st = JSON.parse(base);
		st.cfg = cleanSettings(st.cfg);
		st.fcfg = cleanSettings(st.fcfg);
		pics.corner.changed = false;
		pics.frame.changed = false;
		pics.corner.img = null;
		pics.frame.img = null;
		if (st.src) {
			try {
				await loadSource(st.src, 'corner');
			} catch {}
		}
		if (st.fsrc) {
			try {
				await loadSource(st.fsrc, 'frame');
			} catch {}
		}
		recompute('corner');
		recompute('frame');
		syncControls();
		schedule();
		changed();
		flash('Reverted.');
	}
	saveBtn.addEventListener('click', save);
	revertBtn.addEventListener('click', revert);
	window.addEventListener('beforeunload', (e) => {
		if (isDirty() && !skipUnload) {
			e.preventDefault();
			e.returnValue = '';
		}
	});

	// ---------------------------------------------------------------- leaving with unsaved changes
	const guard = $('guard');
	let leaveTo: string | null = null;
	document.addEventListener(
		'click',
		(e) => {
			const a = (e.target as HTMLElement).closest('a[href]') as HTMLAnchorElement | null;
			if (!a || !isDirty() || a.target === '_blank' || a.href.startsWith('javascript:') || a.href.includes('#')) return;
			e.preventDefault();
			e.stopPropagation();
			leaveTo = a.href;
			guard.hidden = false;
			$('g-save').focus();
		},
		true
	);
	const go = () => {
		skipUnload = true;
		location.href = leaveTo || '/dashboard';
	};
	let skipUnload = false;
	$('g-stay').addEventListener('click', () => (guard.hidden = true));
	$('g-discard').addEventListener('click', go);
	$('g-save').addEventListener('click', async () => {
		await save();
		if (!isDirty()) go();
		else guard.hidden = true;
	});
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !guard.hidden) guard.hidden = true;
	});

	// browser zoom / window size changes the pixel size the preview should be drawn at
	let lastKey = '';
	window.addEventListener('resize', () => {
		const key = window.devicePixelRatio + ':' + (screen.parentElement as HTMLElement).clientWidth;
		if (key !== lastKey) {
			lastKey = key;
			schedule(false);
		}
	});

	// ---------------------------------------------------------------- start
	async function start() {
		buildControls();
		try {
			if (!deviceId) {
				const list = await (await fetch('/api/dashboard/devices')).json();
				deviceId = list.devices?.[0]?.id || '';
				if (!deviceId) {
					$('dev-title').textContent = 'No devices yet';
					return;
				}
			}
			const [info, list] = await Promise.all([
				fetch('/api/dashboard/display?deviceId=' + encodeURIComponent(deviceId)).then((r) => r.json()),
				fetch('/api/dashboard/devices').then((r) => r.json()).catch(() => ({ devices: [] })),
			]);
			if (info.error) {
				$('dev-title').textContent = info.error;
				return;
			}
			const idx = (list.devices || []).findIndex((d: any) => d.id === deviceId);
			$('dev-title').textContent = info.name || (idx > 0 ? `E-Ink Calendar ${idx + 1}` : 'E-Ink Calendar');
			hasWeather = !!info.hasWeather;
			loc = typeof info.lat === 'number' && typeof info.lon === 'number' ? { lat: info.lat, lon: info.lon } : null;
			tasksGranted = !!info.tasksGranted;
			customLayout = info.custom ?? null;
			vbat = info.batteryMv ? info.batteryMv / 1000 : null;
			if (!info.migrated) {
				banner.hidden = false;
				banner.textContent = 'Fonts and pictures need a one-off database update on the server (schema-display.sql) before they can be saved.';
			}
			st = {
				style: info.style,
				font: info.font,
				dark: !!info.dark,
				lang: info.lang === 'ja' ? 'ja' : 'en',
				refreshSec: info.refreshSec || 86400,
				cornerMode: info.cornerMode,
				cfg: cleanSettings(info.cornerCfg),
				src: info.cornerSrc,
				fcfg: cleanSettings(info.frameCfg),
				fsrc: info.frameSrc,
				countdown: info.countdown ?? { title: '', date: '' },
			};
			if (st.src) {
				try {
					await loadSource(st.src, 'corner');
				} catch {
					pics.corner.img = null;
				}
			}
			if (st.fsrc) {
				try {
					await loadSource(st.fsrc, 'frame');
				} catch {
					pics.frame.img = null;
				}
			}
			recompute('corner');
			recompute('frame');
			base = JSON.stringify(st);
			syncControls();
			schedule();
		} catch {
			$('dev-title').textContent = "Couldn't load this device";
		}
	}
	start();
</script>

<style is:global>
	.cust { position: relative; left: 50%; width: min(1400px, 100vw - 3em); transform: translateX(-50%); margin-top: -1.8em; padding: 0.6em 0 3em; }
