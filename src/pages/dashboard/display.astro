	.cust .lay-name, .cust .fnt-name { font-size: 0.85em; font-weight: 700; color: var(--fg); text-align: center; }
	.cust .lay-note { font-size: 0.74em; color: var(--muted); text-align: center; line-height: 1.3; margin-top: -0.3em; padding: 0 0.2em 0.2em; }
	.cust label:hover > .lay-card, .cust label:hover > .fnt-card { border-color: var(--muted); }
