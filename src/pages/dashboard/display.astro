	.cust .tabs { display: flex; gap: 0.3em; padding: 4px; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 999px; width: fit-content; max-width: 100%; margin-bottom: 1.2em; overflow-x: auto; }
