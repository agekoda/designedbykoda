	.cust input[type='radio'], .cust .switch input, .cust .check input { position: absolute; opacity: 0; pointer-events: none; }

	/* layout + font cards: big enough to read */
	.cust .modes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6em; margin-bottom: 1.1em; }
	.cust .mode { display: grid; gap: 0.2em; text-align: left; padding: 0.8em 1em; background: var(--bg); border: 2px solid var(--border); border-radius: 14px; color: var(--fg); font: inherit; transition: border-color 0.2s, background 0.2s; }
	.cust .mode:hover { border-color: var(--muted); }
	.cust .mode.on { border-color: var(--accent); background: rgba(var(--accent-rgb), 0.1); }
	.cust .mode-t { font-weight: 800; }
	.cust .mode-n { font-size: 0.8em; color: var(--muted); }
	.cust .custom-box { padding: 0.4em 0.2em; }
	.cust .custom-box .btn { display: inline-block; margin: 0.3em 0 0.4em; }
