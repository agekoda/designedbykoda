	/* top bar: where you are, and the save button, always in view */
	.cust .topbar { position: sticky; top: 0.6em; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 1em; flex-wrap: wrap; padding: 0.7em 0.8em 0.7em 1.3em; margin-bottom: 1.4em; background: color-mix(in srgb, var(--bg-raised) 90%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid var(--border); border-radius: 18px; }
