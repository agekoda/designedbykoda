	.cust .lay-card, .cust .fnt-card { display: grid; gap: 0.5em; padding: 0.5em; border: 2px solid var(--border); border-radius: 12px; background: var(--bg); transition: border-color 0.2s, background 0.2s; cursor: pointer; }
	.cust .lay-card canvas, .cust .fnt-card canvas { width: 100%; height: auto; border-radius: 6px; background: #dfdbd0; display: block; }
	.cust .lay-card canvas { aspect-ratio: 4 / 3; }
