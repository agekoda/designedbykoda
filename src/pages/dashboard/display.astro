	.cust .save-msg { font-size: 0.88em; color: var(--muted); }
	.cust .save-msg.is-dirty { color: #d9a441; }
	.cust .save-msg.is-error { color: #e08a8a; }

	/* the stage: the preview never changes size, whatever the layout */
	.cust .stage { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 2em; align-items: start; }
