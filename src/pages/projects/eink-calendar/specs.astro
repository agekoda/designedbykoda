---
// Spec sheet for the E-Ink Calendar, in numbered sections like a datasheet. Everything is in the
// SECTIONS list below, so changing a spec is a one-line edit. "Download PDF" prints the page;
// the print styles turn it into a clean black-on-white document.
import Layout from '../../../layouts/Layout.astro';
import { EARLY_PRICES, STANDARD_PRICES, CURRENCIES } from '../../../data/preorderPricing';
import { CALENDAR_STYLES } from '../../../data/calendarStyles';

const VERSION = '1.0';
const UPDATED = '8 November 2026';
const SUPPORT = 'support@designedbykoda.com';

const money = (table: Record<string, number>) =>
	CURRENCIES.map((c) => `${c.code === 'AUD' ? 'A$' : c.code === 'CAD' ? 'CA$' : c.symbol}${table[c.code]}`).join(' · ');
const layouts = CALENDAR_STYLES.filter((s) => !s.builder).map((s) => s.label);

type Row = [string, string];
interface Section {
	id: string;
	title: string;
	intro?: string;
	rows?: Row[];
	groups?: { title: string; rows: Row[] }[];
}

const SECTIONS: Section[] = [
	{
		id: 'overview',
		title: 'Overview',
		intro:
			'A small, battery-powered e-paper screen that shows your Google Calendar, and plenty more. The server draws each screen and the calendar shows it, then sleeps. It uses no power to keep the picture, so it runs for months on a charge. You change everything from a web dashboard: the layout, what it shows at different times of day, or a design of your own.',
	},
	{
		id: 'display',
		title: 'Display',
		rows: [
			['Screen size', '4.2 inches (diagonal)'],
			['Resolution', '400 × 300 pixels, landscape'],
			['Colours', 'Black and white'],
			['Type', 'E-paper (WeAct Studio 4.2" panel)'],
			['Backlight', 'None. Reflective, like paper, so it reads best in normal room light or daylight'],
			['Picture with power off', 'Stays on screen'],
			['Refresh', 'Full refresh once a day to keep the screen clean; the panel also supports partial refresh'],
			['Dark mode', 'White on black, switchable from the dashboard'],
		],
	},
	{
		id: 'physical',
		title: 'Physical',
		rows: [
			['Dimensions', '95.8 mm wide × 93.8 mm high × 19 mm deep'],
			['Weight', '114 g (measured on an earlier unit without the kickstand)'],
			['Enclosure', '3D-printed resin'],
			['Colour', 'Black (white coming soon)'],
			['Stand', 'Built-in kickstand, leans back at 29.5°. Snaps into the back when you don’t need it'],
			['Wall mounting', 'Keyhole for a screw, or a flat back for adhesive strips (not included)'],
			['Controls', 'One button: refresh now, or flip to the next screen'],
			['Lights', 'Charging (red) and charged (green)'],
		],
	},
	{
		id: 'power',
		title: 'Power',
		rows: [
			['Battery', '450 mAh rechargeable lithium-polymer, built in'],
			['Charging', 'USB-C, 5 V, about 250 mA. Works with any USB charger or computer port'],
			['Charge time', 'About 2½ hours from empty (estimated)'],
			['Battery life', 'Months per charge with daily updates. Hourly updates and schedules use more; the dashboard shows an estimate for your settings'],
			['Between updates', 'Deep sleep. The screen keeps its picture with no power'],
			['Protection', 'Resettable fuse on the USB input; charge and discharge managed on board'],
			['Power switch', 'None needed. It sleeps on its own'],
		],
	},
	{
		id: 'hardware',
		title: 'Hardware',
		groups: [
			{
				title: 'Processor and memory',
				rows: [
					['Chip', 'Espressif ESP32-C3, 32-bit RISC-V, up to 160 MHz'],
					['Memory', '400 KB RAM, 4 MB flash'],
					['Power supply', 'Low-power 3.3 V regulator'],
				],
			},
			{
				title: 'Wireless',
				rows: [
					['Wi-Fi', '802.11 b/g/n, 2.4 GHz only (5 GHz networks are not supported)'],
					['Security', 'WPA / WPA2 Personal (home networks with a password)'],
					['Antenna', '2.4 GHz antenna on a U.FL connector'],
				],
			},
			{
				title: 'Other',
				rows: [
					['Buttons', '1'],
					['Sensors', 'Battery level'],
					['Board', 'Custom PCB, designed in Australia'],
				],
			},
		],
	},
	{
		id: 'software',
		title: 'Software and service',
		groups: [
			{
				title: 'What it shows',
				rows: [
					['Calendars', 'Google Calendar, read-only. Pick any of your calendars, including shared and family ones'],
					['Tasks', 'Google Tasks, read-only (optional)'],
					['Weather', 'Today’s high and low, forecast and conditions for a city you choose, in °C or °F'],
					['Ready-made layouts', `${layouts.length}: ${layouts.join(', ')}`],
					['Your own design', 'Layout builder: drag, drop and resize widgets such as dates, events, weather, moon, quotes, countdowns, to-do lists, QR codes and free/busy'],
					['Templates', 'Including meeting room sign, guest welcome board (Wi-Fi QR code) and desk name plate'],
					['Languages', 'English, Japanese'],
				],
			},
			{
				title: 'When it updates',
				rows: [
					['Every day', 'At midnight'],
					['On demand', 'Press the button'],
					['Schedules', 'Show different layouts at set times and days'],
					['More often', 'The Timeline layout can update up to hourly'],
				],
			},
			{
				title: 'Dashboard',
				rows: [
					['Where', 'designedbykoda.com/dashboard, in any web browser. No app to install'],
					['Sign-in', 'Google account'],
					['Live preview', 'Shows exactly what the screen will look like before you save'],
					['Firmware', 'New layouts and features arrive from the server, with no firmware update needed. Firmware itself is updated over USB'],
				],
			},
		],
	},
	{
		id: 'privacy',
		title: 'Privacy and security',
		rows: [
			['Google access', 'Read-only. It can never change or delete your events'],
			['Your events', 'Read when the screen updates, to draw it, and not stored'],
			['Sign-in tokens', 'Encrypted at rest'],
			['Connection', 'HTTPS for everything'],
			['The device', 'Has its own secret key; your Google password is never on it'],
			['Policy', 'designedbykoda.com/privacy'],
		],
	},
	{
		id: 'environment',
		title: 'Environment',
		rows: [
			['Use', 'Indoors'],
			['Heat', 'Keep out of direct sun and hot cars. The resin case softens at about 65 °C'],
			['Charging temperature', 'Room temperature (0 to 40 °C)'],
		],
	},
	{
		id: 'box',
		title: 'In the box',
		rows: [
			['Calendar', 'With the kickstand fitted'],
			['Quick start card', 'Setup in a few minutes, with a QR code to the full guide online'],
			['Not included', 'USB-C cable, wall screw, adhesive strips'],
		],
	},
	{
		id: 'support',
		title: 'Warranty and support',
		rows: [
			['Warranty', '12 months. This is in addition to your rights under the Australian Consumer Law'],
			['Support', SUPPORT],
			['Setup guide', 'designedbykoda.com/setup'],
			['Service status', 'designedbykoda.com/status'],
		],
	},
	{
		id: 'ordering',
		title: 'Ordering',
		rows: [
			['Early-bird price', money(EARLY_PRICES)],
			['Standard price', money(STANDARD_PRICES)],
			['Preorders open', '30 November 2026'],
			['Shipping', 'Aiming to ship every preorder by the end of February 2027'],
			['Ships from', 'Australia. A fixed shipping price per country, shown at checkout (US prices include estimated import duty)'],
			['Made', 'Designed and finished by hand in Australia. Circuit boards made and assembled in China'],
			['First batch', '50 units'],
		],
	},
];
const num = (i: number) => String(i).padStart(2, '0');
---

<Layout title="E-Ink Calendar spec sheet — designedbykoda" description="Full specifications for the designedbykoda E-Ink Calendar: display, size, battery, hardware, software and ordering.">
	<article class="spec">
		<nav class="crumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a> / <a href="/projects/eink-calendar/">E-Ink Calendar</a> / Spec sheet</nav>

		<header class="spec-head">
			<div>
				<p class="kicker">Spec sheet</p>
				<h1>E-Ink Calendar</h1>
				<p class="sub">4.2-inch Wi-Fi e-paper calendar and display · designedbykoda</p>
			</div>
			<div class="head-actions">
				<button type="button" class="sbtn" id="print">Download PDF</button>
				<a class="sbtn ghost" href="/projects/eink-calendar/">Back to the project</a>
			</div>
		</header>

		<!-- Front and side views, to scale (1 mm = 2 units). -->
		<figure class="drawing" aria-label="Front and side drawing with dimensions">
			<svg viewBox="0 0 520 270" role="img">
				<title>95.8 mm wide, 93.8 mm high, 19 mm deep, kickstand at 29.5 degrees</title>
				<g class="ln">
					<!-- front -->
					<rect x="40" y="30" width="192" height="188" rx="10" />
					<rect x="60" y="56" width="152" height="114" rx="2" class="scr" />
					<text x="136" y="118" class="lbl">4.2" screen</text>
					<circle cx="136" cy="196" r="7" />
					<!-- width -->
					<path d="M40 236 V248 M232 236 V248 M40 244 H232" class="dim" />
					<text x="136" y="262" class="lbl">95.8 mm</text>
					<!-- height -->
					<path d="M24 30 H12 M24 218 H12 M16 30 V218" class="dim" />
					<text x="8" y="124" class="lbl v" transform="rotate(-90 8 124)">93.8 mm</text>
					<text x="136" y="18" class="cap">Front</text>
					<!-- side -->
					<rect x="330" y="30" width="38" height="188" rx="6" />
					<path d="M368 64 L478 218" class="stand" />
					<path d="M300 218 H500" class="ground" />
					<path d="M330 236 V248 M368 236 V248 M330 244 H368" class="dim" />
					<text x="349" y="262" class="lbl">19 mm</text>
					<path d="M368 120 A 60 60 0 0 0 400 110" class="dim" />
					<text x="408" y="112" class="lbl l">29.5°</text>
					<text x="410" y="18" class="cap">Side, kickstand out</text>
				</g>
			</svg>
		</figure>

		{
			SECTIONS.map((s, i) => (
				<section class="sec" id={s.id}>
					<h2>
						<span class="n">{num(i)}</span>
						{s.title}
					</h2>
					{s.intro && <p class="intro">{s.intro}</p>}
					{s.rows && (
						<dl>
							{s.rows.map(([k, v]) => (
								<div class="row">
									<dt>{k}</dt>
									<dd>{v}</dd>
								</div>
							))}
						</dl>
					)}
					{s.groups?.map((g) => (
						<div class="grp">
							<h3>{g.title}</h3>
							<dl>
								{g.rows.map(([k, v]) => (
									<div class="row">
										<dt>{k}</dt>
										<dd>{v}</dd>
									</div>
								))}
							</dl>
						</div>
					))}
				</section>
			))
		}

		<footer class="spec-foot">
			<span>designedbykoda · {SUPPORT}</span>
			<span>Version {VERSION} · {UPDATED}. Specifications may change before shipping.</span>
		</footer>
	</article>
</Layout>

<script>
	document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
	.spec { max-width: 860px; margin: 0 auto; }
	.crumbs { font-size: 0.85em; color: var(--muted); margin-bottom: 1.6em; }
	.crumbs a { color: var(--muted); }
	.spec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5em; flex-wrap: wrap; padding-bottom: 1.4em; border-bottom: 2px solid var(--fg); }
	.kicker { margin: 0; font-size: 0.75em; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
	.spec-head h1 { margin: 0.1em 0 0.15em; font-size: clamp(2em, 5vw, 3em); line-height: 1.05; }
	.sub { margin: 0; color: var(--muted); }
	.head-actions { display: flex; gap: 0.6em; flex-wrap: wrap; }
	.sbtn { display: inline-flex; align-items: center; padding: 0.6em 1.2em; border-radius: 999px; border: 1px solid var(--fg); background: var(--fg); color: var(--bg); font: inherit; font-size: 0.9em; font-weight: 700; text-decoration: none; cursor: pointer; }
	.sbtn.ghost { background: none; color: var(--fg); border-color: var(--border); }
	.sbtn:hover { opacity: 0.85; }

	.drawing { margin: 2em 0 1em; padding: 1.2em; border: 1px solid var(--border); border-radius: 16px; background: var(--bg-raised); }
	.drawing svg { display: block; width: 100%; max-width: 620px; margin: 0 auto; }
	.ln rect, .ln circle, .ln path { fill: none; stroke: var(--fg); stroke-width: 1.6; }
	.ln .scr { stroke-dasharray: 4 3; stroke-width: 1.2; }
	.ln .dim { stroke: var(--muted); stroke-width: 1; }
	.ln .stand { stroke-width: 3; stroke-linecap: round; }
	.ln .ground { stroke: var(--muted-dim); stroke-dasharray: 2 4; }
	.lbl { fill: var(--muted); font-size: 12px; text-anchor: middle; font-family: inherit; }
	.lbl.l { text-anchor: start; }
	.cap { fill: var(--fg); font-size: 12px; font-weight: 700; text-anchor: middle; letter-spacing: 0.08em; text-transform: uppercase; }

	.sec { padding: 1.8em 0 0.6em; border-bottom: 1px solid var(--border); }
	.sec h2, .grp h3 { break-after: avoid; }
	.row, .drawing, .intro { break-inside: avoid; }
	.sec h2 { display: flex; align-items: baseline; gap: 0.7em; margin: 0 0 0.8em; font-size: 1.35em; }
	.n { font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-size: 0.7em; color: var(--accent); font-weight: 700; }
	.intro { margin: 0 0 1.2em; line-height: 1.6; color: var(--fg); }
	.grp h3 { margin: 1.1em 0 0.3em; font-size: 0.78em; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
	dl { margin: 0 0 1em; }
	.row { display: grid; grid-template-columns: minmax(150px, 0.38fr) 1fr; gap: 1em; padding: 0.6em 0; border-top: 1px solid var(--border); }
	.row:first-child { border-top: none; }
	dt { color: var(--muted); font-size: 0.92em; }
	dd { margin: 0; line-height: 1.5; }
	.spec-foot { display: flex; justify-content: space-between; gap: 1em; flex-wrap: wrap; padding: 1.4em 0 0; font-size: 0.8em; color: var(--muted); }
	@media (max-width: 560px) {
		.row { grid-template-columns: 1fr; gap: 0.15em; }
	}

	/* "Download PDF": a plain black-on-white document */
	@media print {
		:global(body > header), :global(body > footer), :global(header:not(.spec-head)), :global(footer:not(.spec-foot)), :global(.bg-fx), :global(.x-skip), :global(button:not(#print)), :global([class*='fab']) { display: none !important; }
		:global(*) { box-shadow: none !important; }
		:global(.reveal), :global(.x-reveal) { opacity: 1 !important; transform: none !important; }
		:global([class^='x-pal']) { display: none !important; }
		:global(html), :global(body) { background: #fff !important; color: #000 !important; color-scheme: light !important; }
		.spec { max-width: none; color: #000; --fg: #000; --muted: #444; --muted-dim: #888; --border: #ccc; --accent: #000; --bg-raised: #fff; }
		.crumbs, .head-actions { display: none; }
		.spec-head { border-color: #000; }
		.drawing { border-color: #ccc; }
		.sec { padding-top: 1.1em; }
		@page { margin: 14mm; }
	}
</style>
