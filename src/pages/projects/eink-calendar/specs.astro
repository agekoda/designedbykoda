---
// Spec sheet for the E-Ink Calendar, in numbered sections like a datasheet. Everything is in the
// SECTIONS list below, so changing a spec is a one-line edit. "Download PDF" prints the page;
// the print styles turn it into a clean black-on-white document.
import Layout from '../../../layouts/Layout.astro';
import { EARLY_PRICES, STANDARD_PRICES, CURRENCIES } from '../../../data/preorderPricing';
import { CALENDAR_STYLES } from '../../../data/calendarStyles';

const VERSION = '1.0';
const UPDATED = '8 November 2026';
const SUPPORT = 'support@designedbykoda.com';

const money = (table: Record<string, number>) =>
	CURRENCIES.map((c) => `${c.code === 'AUD' ? 'A$' : c.code === 'CAD' ? 'CA$' : c.symbol}${table[c.code]}`).join(' · ');
const layouts = CALENDAR_STYLES.filter((s) => !s.builder).map((s) => s.label);

type Row = [string, string];
interface Section {
	id: string;
	title: string;
	intro?: string;
	rows?: Row[];
	groups?: { title: string; rows: Row[] }[];
}

const SECTIONS: Section[] = [
	{
		id: 'overview',
		title: 'Overview',
		intro: 'A battery-powered e-paper display that shows your Google Calendar, and more. Pick a layout, design your own, or set it to change through the day, all from a web dashboard.',
	},
	{
		id: 'display',
		title: 'Display',
		rows: [
			['Screen size', '4.2 inches (diagonal)'],
			['Resolution', '400 × 300 pixels'],
			['Pixel density', '119 PPI'],
			['Display type', 'ePaper (EPD)'],
			['Colours', 'Black and white'],
			['Partial refresh', 'Yes'],
		],
	},
	{
		id: 'physical',
		title: 'Physical',
		rows: [
			['Dimensions (W × H × D)', '95.8 × 93.8 × 19 mm'],
			['Weight', '114 g'],
			['Enclosure', 'Resin'],
			['Colour', 'Black (White coming soon)'],
			['Orientation', 'Landscape'],
			['Mounting', 'Kickstand (29.5°), keyhole, adhesive strips'],
			['Controls', '1 button'],
			['Status LEDs', 'Charging, charged'],
		],
	},
	{
		id: 'power',
		title: 'Power',
		rows: [
			['Battery', 'Rechargeable Li-Po, 450 mAh'],
			['Battery life', 'Months (daily updates)'],
			['Charging port', 'USB-C'],
			['Charging time', '~2.5 hours'],
			['Refresh', 'Daily, on button press, or scheduled'],
		],
	},
	{
		id: 'hardware',
		title: 'Hardware',
		groups: [
			{
				title: 'Processor and memory',
				rows: [
					['Processor', 'ESP32-C3'],
					['RAM', '400 KB'],
					['Flash', '4 MB'],
				],
			},
			{
				title: 'Wireless',
				rows: [
					['Wi-Fi', '802.11 b/g/n'],
					['Frequency', '2.4 GHz'],
					['Security', 'WPA, WPA2'],
				],
			},
		],
	},
	{
		id: 'software',
		title: 'Software',
		rows: [
			['Calendar', 'Google Calendar (read-only)'],
			['Tasks', 'Google Tasks (optional)'],
			['Layouts', `${layouts.length} built-in, plus your own design`],
			['Schedules', 'By time and day'],
			['Weather', '°C or °F'],
			['Languages', 'English, Japanese'],
			['Dashboard', 'Web, no app needed'],
			['OTA updates', 'Not needed (screens are drawn on the server)'],
		],
	},
	{
		id: 'security',
		title: 'Security',
		rows: [
			['Communication', 'One-way (device-initiated only)'],
			['Calendar access', 'Read-only'],
			['Event storage', 'None'],
			['Encryption', 'TLS (HTTPS)'],
		],
	},
	{
		id: 'environment',
		title: 'Environmental',
		rows: [
			['Use', 'Indoors'],
			['Max temperature', '65 °C'],
		],
	},
	{
		id: 'box',
		title: 'Package contents',
		rows: [
			['E-Ink Calendar (kickstand fitted)', '1'],
			['Quick start guide', '1'],
			['USB-C cable', 'Not included'],
		],
	},
	{
		id: 'support',
		title: 'Warranty and support',
		rows: [
			['Warranty', '1 year'],
			['Support', SUPPORT],
			['Setup guide', 'designedbykoda.com/setup'],
		],
	},
	{
		id: 'ordering',
		title: 'Ordering',
		rows: [
			['Early-bird price', money(EARLY_PRICES)],
			['Standard price', money(STANDARD_PRICES)],
			['Preorders open', '30 November 2026'],
			['Shipping', 'By end of February 2027'],
			['Ships from', 'Australia'],
			['First batch', '50 units'],
		],
	},
];
const num = (i: number) => String(i).padStart(2, '0');
---

<Layout title="E-Ink Calendar spec sheet — designedbykoda" description="Full specifications for the designedbykoda E-Ink Calendar: display, size, battery, hardware, software and ordering.">
	<article class="spec">
		<nav class="crumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a> / <a href="/projects/eink-calendar/">E-Ink Calendar</a> / Spec sheet</nav>

		<header class="spec-head">
			<div>
				<p class="kicker">Spec sheet</p>
				<h1>E-Ink Calendar</h1>
				<p class="sub">4.2-inch Wi-Fi e-paper calendar and display · designedbykoda</p>
			</div>
			<div class="head-actions">
				<button type="button" class="sbtn" id="print">Download PDF</button>
				<a class="sbtn ghost" href="/projects/eink-calendar/">Back to the project</a>
			</div>
		</header>

		<!-- Drawing goes here once the front / side SVG from the 3D model is ready. -->

		{
			SECTIONS.map((s, i) => (
				<section class="sec" id={s.id}>
					<h2>
						<span class="n">{num(i)}</span>
						{s.title}
					</h2>
					{s.intro && <p class="intro">{s.intro}</p>}
					{s.rows && (
						<dl>
							{s.rows.map(([k, v]) => (
								<div class="row">
									<dt>{k}</dt>
									<dd>{v}</dd>
								</div>
							))}
						</dl>
					)}
					{s.groups?.map((g) => (
						<div class="grp">
							<h3>{g.title}</h3>
							<dl>
								{g.rows.map(([k, v]) => (
									<div class="row">
										<dt>{k}</dt>
										<dd>{v}</dd>
									</div>
								))}
							</dl>
						</div>
					))}
				</section>
			))
		}

		<footer class="spec-foot">
			<span>designedbykoda · {SUPPORT}</span>
			<span>Version {VERSION} · {UPDATED}. Specifications may change before shipping.</span>
		</footer>
	</article>
</Layout>

<script>
	document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
	.spec { max-width: 860px; margin: 0 auto; }
	.crumbs { font-size: 0.85em; color: var(--muted); margin-bottom: 1.6em; }
	.crumbs a { color: var(--muted); }
	.spec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5em; flex-wrap: wrap; padding-bottom: 1.4em; border-bottom: 2px solid var(--fg); }
	.kicker { margin: 0; font-size: 0.75em; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
	.spec-head h1 { margin: 0.1em 0 0.15em; font-size: clamp(2em, 5vw, 3em); line-height: 1.05; }
	.sub { margin: 0; color: var(--muted); }
	.head-actions { display: flex; gap: 0.6em; flex-wrap: wrap; }
	.sbtn { display: inline-flex; align-items: center; padding: 0.6em 1.2em; border-radius: 999px; border: 1px solid var(--fg); background: var(--fg); color: var(--bg); font: inherit; font-size: 0.9em; font-weight: 700; text-decoration: none; cursor: pointer; }
	.sbtn.ghost { background: none; color: var(--fg); border-color: var(--border); }
	.sbtn:hover { opacity: 0.85; }

	.drawing { margin: 2em 0 1em; padding: 1.2em; border: 1px solid var(--border); border-radius: 16px; background: var(--bg-raised); }
	.drawing svg { display: block; width: 100%; max-width: 620px; margin: 0 auto; }
	.ln rect, .ln circle, .ln path { fill: none; stroke: var(--fg); stroke-width: 1.6; }
	.ln .scr { stroke-dasharray: 4 3; stroke-width: 1.2; }
	.ln .dim { stroke: var(--muted); stroke-width: 1; }
	.ln .stand { stroke-width: 3; stroke-linecap: round; }
	.ln .ground { stroke: var(--muted-dim); stroke-dasharray: 2 4; }
	.lbl { fill: var(--muted); font-size: 12px; text-anchor: middle; font-family: inherit; }
	.lbl.l { text-anchor: start; }
	.cap { fill: var(--fg); font-size: 12px; font-weight: 700; text-anchor: middle; letter-spacing: 0.08em; text-transform: uppercase; }

	.sec { padding: 1.8em 0 0.6em; border-bottom: 1px solid var(--border); }
	.sec h2, .grp h3 { break-after: avoid; }
	.row, .drawing, .intro { break-inside: avoid; }
	.sec h2 { display: flex; align-items: baseline; gap: 0.7em; margin: 0 0 0.8em; font-size: 1.35em; }
	.n { font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-size: 0.7em; color: var(--accent); font-weight: 700; }
	.intro { margin: 0 0 1.2em; line-height: 1.6; color: var(--fg); }
	.grp h3 { margin: 1.1em 0 0.3em; font-size: 0.78em; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
	dl { margin: 0 0 1em; }
	.row { display: grid; grid-template-columns: 210px 1fr; gap: 1em; padding: 0.6em 0; border-top: 1px solid var(--border); }
	.row:first-child { border-top: none; }
	dt { color: var(--muted); font-size: 0.92em; }
	dd { margin: 0; line-height: 1.5; }
	.spec-foot { display: flex; justify-content: space-between; gap: 1em; flex-wrap: wrap; padding: 1.4em 0 0; font-size: 0.8em; color: var(--muted); }
	@media (max-width: 560px) {
		.row { grid-template-columns: 1fr; gap: 0.15em; }
	}

	/* "Download PDF": a plain black-on-white document */
	@media print {
		:global(body > header), :global(body > footer), :global(header:not(.spec-head)), :global(footer:not(.spec-foot)), :global(.bg-fx), :global(.x-skip), :global(button:not(#print)), :global([class*='fab']) { display: none !important; }
		:global(*) { box-shadow: none !important; }
		:global(.reveal), :global(.x-reveal) { opacity: 1 !important; transform: none !important; }
		:global([class^='x-pal']) { display: none !important; }
		:global(html), :global(body) { background: #fff !important; color: #000 !important; color-scheme: light !important; }
		.spec { max-width: none; color: #000; --fg: #000; --muted: #444; --muted-dim: #888; --border: #ccc; --accent: #000; --bg-raised: #fff; }
		.crumbs, .head-actions { display: none; }
		.spec-head { border-color: #000; }
		.drawing { border-color: #ccc; }
		.sec { padding-top: 1.1em; }
		@page { margin: 14mm; }
	}
</style>
