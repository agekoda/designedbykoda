---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const {
	title,
	tagline,
	description,
	category,
	status,
	heroImage,
	model,
	cameraOrbit,
	rotationSpeed,
	modelCaption,
	model2,
	cameraOrbit2,
	rotationSpeed2,
	model2Caption,
	gallery,
	galleryRatio,
} = project.data;
const { Content } = await render(project);
---

<ProjectLayout
	title={title}
	tagline={tagline}
	description={description}
	category={category}
	status={status}
	heroImage={heroImage}
	model={model}
	cameraOrbit={cameraOrbit}
	rotationSpeed={rotationSpeed}
	modelCaption={modelCaption}
	model2={model2}
	cameraOrbit2={cameraOrbit2}
	rotationSpeed2={rotationSpeed2}
	model2Caption={model2Caption}
	gallery={gallery}
	galleryRatio={galleryRatio}
>
	<Content />
</ProjectLayout>