---
// Renders an interactive 3D model (rotate-only orbit, momentum on release)
// if `src` is set and the .glb actually loads. Otherwise falls back to a
// "3D model coming soon" placeholder — same convention as ProjectImage, so
// you can wire up model paths in frontmatter ahead of having the file.
//
// Uses Google's <model-viewer>, self-hosted at /scripts/model-viewer.min.js
// (not loaded from a CDN, so it doesn't depend on a third party at runtime).

interface Props {
	src?: string;
	alt?: string;
	poster?: string;
}

const { src, alt = '3D model', poster } = Astro.props;
const id = `model-${Math.random().toString(36).slice(2, 9)}`;
---

{
	src && (
		<div class="model-slot" id={id}>
			<model-viewer
				src={src}
				alt={alt}
				poster={poster}
				camera-controls
				disable-zoom
				disable-pan
				disable-tap
				interaction-prompt="none"
				interpolation-decay="45"
				shadow-intensity="1"
				exposure="1"
				environment-image="neutral"
			>
				<div slot="progress-bar" />
			</model-viewer>
			<div class="placeholder">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
					<path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
					<path d="M3 7l9 5 9-5" />
					<path d="M12 12v10" />
				</svg>
				<span>3D model coming soon</span>
			</div>
			<script src="/scripts/model-viewer.min.js" type="module"></script>
			<script define:vars={{ id }}>
				const wrap = document.getElementById(id);
				if (wrap) {
					const mv = wrap.querySelector('model-viewer');
					if (mv) {
						// If the .glb 404s or otherwise fails to load, hide the viewer
						// and show the placeholder instead — same fallback pattern as
						// photos.
						mv.addEventListener('error', () => {
							mv.style.display = 'none';
							const ph = wrap.querySelector('.placeholder');
							if (ph) ph.style.display = 'flex';
						});

						// model-viewer sets its own grab/grabbing cursor directly via
						// JS (inline style), which plain CSS can't reliably beat.
						// Force it back to "none" every time it tries to change, so
						// our custom cursor dot shows instead — but only when the
						// custom cursor is actually active (real mouse, no
						// reduced-motion), otherwise leave its default alone.
						const hideCursor = () => {
							if (
								document.documentElement.classList.contains('has-custom-cursor') &&
								mv.style.cursor !== 'none'
							) {
								mv.style.setProperty('cursor', 'none', 'important');
							}
						};
						hideCursor();
						new MutationObserver(hideCursor).observe(mv, {
							attributes: true,
							attributeFilter: ['style'],
						});
						mv.addEventListener('pointerdown', hideCursor);
						mv.addEventListener('pointermove', hideCursor);
						mv.addEventListener('pointerup', hideCursor);
					}
				}
			</script>
		</div>
	)
}
{
	!src && (
		<div class="model-slot">
			<div class="placeholder" style="display:flex;">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
					<path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
					<path d="M3 7l9 5 9-5" />
					<path d="M12 12v10" />
				</svg>
				<span>3D model coming soon</span>
			</div>
		</div>
	)
}

<style>
	.model-slot {
		position: relative;
		width: 100%;
		max-width: 600px;
		margin: 0 auto;
		aspect-ratio: 1 / 1;
		border-radius: 10px;
		overflow: hidden;
		background: var(--bg-raised);
		border: 1px dashed var(--border);
	}
	.model-slot model-viewer {
		width: 100%;
		height: 100%;
		--poster-color: transparent;
	}
	:global(html.has-custom-cursor) .model-slot model-viewer {
		cursor: none !important;
	}
	.model-slot .placeholder {
		display: none;
		position: absolute;
		inset: 0;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4em;
		color: var(--muted-dim);
		font-size: 0.85em;
		text-align: center;
		padding: 1em;
	}
	.model-slot .placeholder svg {
		width: 28px;
		height: 28px;
		opacity: 0.6;
	}
</style>