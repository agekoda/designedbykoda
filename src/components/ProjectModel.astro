---
// Renders an interactive 3D model (rotate-only orbit, momentum on release)
// if `src` is set and the .glb actually loads. Otherwise falls back to a
// "3D model coming soon" placeholder — same convention as ProjectImage, so
// you can wire up model paths in frontmatter ahead of having the file.
//
// Uses Google's <model-viewer>, self-hosted at /scripts/model-viewer.min.js
// (not loaded from a CDN, so it doesn't depend on a third party at runtime).

interface Props {
	src?: string;
	alt?: string;
	poster?: string;
	cameraOrbit?: string;
	rotationSpeed?: string;
	freeOrbit?: boolean; // turn all the way over the top and underneath, not just around the sides
	kickstand?: boolean; // show a button that turns the case round and plays the model's KickstandOpen animation (freeOrbit only)
}

const {
	src,
	alt = '3D model',
	poster,
	cameraOrbit = '0deg 55deg auto',
	rotationSpeed = '-8deg/s',
	freeOrbit = false,
	kickstand = false,
} = Astro.props;
const id = `model-${Math.random().toString(36).slice(2, 9)}`;
---

{
	src && (
		<div class="model-slot" id={id}>
			<model-viewer
				src={src}
				alt={alt}
				poster={poster}
				{...(freeOrbit ? {} : { 'camera-controls': '', 'auto-rotate': '' })}
				data-free-orbit={freeOrbit ? '' : undefined}
				disable-zoom
				disable-pan
				disable-tap
				interaction-prompt="none"
				interpolation-decay="35"
				shadow-intensity={freeOrbit ? '0' : '1'}
				exposure="1"
				environment-image="neutral"
				auto-rotate-delay="0"
				rotation-per-second={rotationSpeed}
				camera-orbit={cameraOrbit}
			>
				<div slot="progress-bar" />
			</model-viewer>
			{kickstand && freeOrbit && <button type="button" class="kick-btn" aria-pressed="false">Open kickstand</button>}
			<div class="placeholder">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
					<path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
					<path d="M3 7l9 5 9-5" />
					<path d="M12 12v10" />
				</svg>
				<span>3D model coming soon</span>
			</div>
			<script src="/scripts/model-viewer.min.js" type="module"></script>
			{freeOrbit && (
				<script define:vars={{ id }}>
					// Free turning: the camera stays put and the case itself rotates, trackball style, so it
					// can go right over the top and underneath without stopping (an orbiting camera can't
					// pass straight above or below). It spins slowly until someone grabs it.
					const box = document.getElementById(id);
					const mv = box && box.querySelector('model-viewer');
					if (mv) {
						mv.style.touchAction = 'none';
						let q = [0, 0, 0, 1]; // x, y, z, w, set below once the helpers exist
						const mul = (a, b) => [
							a[3] * b[0] + a[0] * b[3] + a[1] * b[2] - a[2] * b[1],
							a[3] * b[1] - a[0] * b[2] + a[1] * b[3] + a[2] * b[0],
							a[3] * b[2] + a[0] * b[1] - a[1] * b[0] + a[2] * b[3],
							a[3] * b[3] - a[0] * b[0] - a[1] * b[1] - a[2] * b[2],
						];
						const axis = (x, y, z, ang) => { const s = Math.sin(ang / 2); return [x * s, y * s, z * s, Math.cos(ang / 2)]; };
						// Set the rotation straight on the 3D scene. Changing model-viewer's "orientation"
						// attribute every frame trips a bug in its AR code, after which it stops redrawing.
						const sceneOf = () => {
							const k = Object.getOwnPropertySymbols(mv).find((s) => s.description === 'scene');
							return k ? mv[k] : null;
						};
						const apply = () => {
							const sc = sceneOf();
							if (!sc || !sc.models || !sc.models.length) return;
							for (const m of sc.models) m.quaternion.set(q[0], q[1], q[2], q[3]);
							if (sc.updateShadow) sc.updateShadow();
							if (sc.queueRender) sc.queueRender();
						};
						// turn about the screen's up axis (left/right drag) and its right axis (up/down drag)
						const turn = (dx, dy) => {
							const k = 0.009;
							q = mul(axis(0, 1, 0, dx * k), q);
							q = mul(axis(1, 0, 0, dy * k), q);
							const n = Math.hypot(...q); q = q.map((v) => v / n);
							apply();
						};
						// The case's model lies flat (screen up), so stand it up to face the camera first.
						q = axis(1, 0, 0, -Math.PI / 2);
						let spinning = true, last = 0;
						const spin = (t) => {
							if (!spinning) return;
							if (last) turn(-(t - last) * 0.025, 0);
							last = t;
							requestAnimationFrame(spin);
						};
						requestAnimationFrame(spin);
						mv.addEventListener('load', apply);
						let drag = null;
						mv.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, y: e.clientY, id: e.pointerId }; mv.setPointerCapture(e.pointerId); });
						mv.addEventListener('pointermove', (e) => {
							if (!drag || e.pointerId !== drag.id) return;
							const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
							if (spinning && Math.hypot(dx, dy) > 3) spinning = false;
							drag.x = e.clientX; drag.y = e.clientY;
							if (!spinning) turn(dx, dy);
						});
						const end = (e) => { if (drag && e.pointerId === drag.id) drag = null; };
						mv.addEventListener('pointerup', end);
						mv.addEventListener('pointercancel', end);

						// Kickstand button: turn the case round to a three-quarter back view (so the stand is
						// actually in sight), then play the model's KickstandOpen animation. Again plays it backwards.
						const kb = box.querySelector('.kick-btn');
						if (kb) {
							const slerp = (a, b, t) => {
								let d = a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3];
								if (d < 0) { b = b.map((v) => -v); d = -d; }
								if (d > 0.9995) { const r = a.map((v, i) => v + (b[i] - v) * t); const n = Math.hypot(...r); return r.map((v) => v / n); }
								const th = Math.acos(d), s0 = Math.sin((1 - t) * th) / Math.sin(th), s1 = Math.sin(t * th) / Math.sin(th);
								return a.map((v, i) => v * s0 + b[i] * s1);
							};
							const ease = (x) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
							const BACK = mul(axis(1, 0, 0, 0.18), mul(axis(0, 1, 0, -1.15), axis(1, 0, 0, -Math.PI / 2)));
							let open = false, busy = false;
							// Drive the clip by hand while paused: when model-viewer finishes a one-shot play() it
							// drops back to the rest pose, and a time equal to the duration wraps round to 0.
							// Choose the clip up front: model-viewer applies a new animationName a frame later and
							// resets the time to 0 when it does, which would undo the first few frames of the swing.
							const pick = () => { if (typeof mv.pause !== 'function') return; mv.animationName = 'KickstandOpen'; mv.pause(); };
							mv.addEventListener('load', pick); pick();
							const swing = () => {
								mv.pause();
								const D = Math.max(0, mv.duration - 0.001), a = open ? D : 0, b = open ? 0 : D, t0 = performance.now();
								const tick = (t) => {
									const k = Math.min(1, (t - t0) / (D * 1000 || 1));
									mv.currentTime = a + (b - a) * k;
									if (k < 1) requestAnimationFrame(tick);
								};
								requestAnimationFrame(tick);
								open = !open;
								kb.textContent = open ? 'Fold kickstand' : 'Open kickstand';
								kb.setAttribute('aria-pressed', String(open));
								setTimeout(() => { busy = false; }, 750);
							};
							kb.addEventListener('click', () => {
								if (busy) return;
								busy = true; spinning = false;
								if (open) { swing(); return; }
								const from = q.slice(), t0 = performance.now(), dur = 700;
								const step = (t) => {
									const k = Math.min(1, (t - t0) / dur);
									q = slerp(from, BACK, ease(k)); apply();
									if (k < 1) requestAnimationFrame(step); else swing();
								};
								requestAnimationFrame(step);
							});
						}
					}
				</script>
			)}
			<script define:vars={{ id, src, cameraOrbit }}>
				const wrap = document.getElementById(id);
				if (wrap) {
					const mv = wrap.querySelector('model-viewer');
					if (mv) {
						// If the .glb 404s or otherwise fails to load, hide the viewer
						// and show the placeholder instead — same fallback pattern as
						// photos.
						mv.addEventListener('error', () => {
							mv.style.display = 'none';
							const ph = wrap.querySelector('.placeholder');
							if (ph) ph.style.display = 'flex';
						});

						// Auto-rotate slowly on load, but stop for good the first time
						// the person actually grabs and drags it — model-viewer's
						// default behaviour is to pause then resume after 3s, which
						// isn't what we want, so we remove the attribute entirely on
						// the first user-driven camera change.
						mv.addEventListener('camera-change', (e) => {
							if (e.detail && e.detail.source === 'user-interaction') {
								mv.removeAttribute('auto-rotate');
							}
						});

						// Click (not drag-to-rotate) opens the model fullscreen in
						// the same lightbox images use. Distinguished by movement +
						// time since pointerdown: a real click stays roughly in
						// place and is quick; an orbit-drag moves further and/or
						// takes longer. This only *observes* the same pointer
						// events model-viewer's own orbit controls use — it
						// doesn't block or interfere with rotating the model.
						let downPos = null;
						let downTime = 0;
						mv.addEventListener('pointerdown', (e) => {
							downPos = { x: e.clientX, y: e.clientY };
							downTime = Date.now();
						});
						mv.addEventListener('pointerup', (e) => {
							if (!downPos) return;
							const dx = e.clientX - downPos.x;
							const dy = e.clientY - downPos.y;
							const dist = Math.sqrt(dx * dx + dy * dy);
							const elapsed = Date.now() - downTime;
							downPos = null;
							if (dist < 6 && elapsed < 400 && window.openModelLightbox) {
								window.openModelLightbox(src, cameraOrbit);
							}
						});

						// model-viewer sets its own grab/grabbing cursor, and it may
						// do so on an element inside its shadow root (e.g. the
						// canvas), not just the host — which a plain CSS rule or an
						// observer on the host alone can't always catch. Brute-force
						// fix: while the pointer is over it, force cursor:none on the
						// host and anything inside its shadow root, every frame, for
						// as long as the custom cursor system is active.
						let rafId = null;
						function forceCursorNone() {
							if (document.documentElement.classList.contains('has-custom-cursor')) {
								mv.style.setProperty('cursor', 'none', 'important');
								const root = mv.shadowRoot;
								if (root) {
									root.querySelectorAll('*').forEach((el) => {
										if (el.style && el.style.cursor && el.style.cursor !== 'none') {
											el.style.setProperty('cursor', 'none', 'important');
										}
									});
								}
							}
							rafId = requestAnimationFrame(forceCursorNone);
						}
						mv.addEventListener('pointerenter', () => {
							if (rafId === null) forceCursorNone();
						});
						mv.addEventListener('pointerleave', () => {
							if (rafId !== null) {
								cancelAnimationFrame(rafId);
								rafId = null;
							}
						});
					}
				}
			</script>
		</div>
	)
}
{
	!src && (
		<div class="model-slot">
			<div class="placeholder" style="display:flex;">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
					<path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
					<path d="M3 7l9 5 9-5" />
					<path d="M12 12v10" />
				</svg>
				<span>3D model coming soon</span>
			</div>
		</div>
	)
}

<style>
	.model-slot {
		position: relative;
		width: 100%;
		max-width: 600px;
		margin: 0 auto;
		aspect-ratio: 1 / 1;
		border-radius: 10px;
		overflow: hidden;
		background: transparent;
		border: 1px solid transparent;
	}
	.model-slot model-viewer {
		width: 100%;
		height: 100%;
		--poster-color: transparent;
	}
	:global(html.has-custom-cursor) .model-slot model-viewer {
		cursor: none !important;
	}
	.model-slot .placeholder {
		display: none;
		position: absolute;
		inset: 0;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4em;
		color: var(--muted-dim);
		font-size: 0.85em;
		text-align: center;
		padding: 1em;
	}
	.kick-btn {
		position: absolute;
		right: 0.9em;
		bottom: 0.9em;
		border: 1px solid currentColor;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.85em;
		padding: 0.5em 1.1em;
		border-radius: 999px;
		cursor: pointer;
	}
	.kick-btn:hover { background: rgba(0, 0, 0, 0.06); }
	:global(html.has-custom-cursor) .kick-btn { cursor: none; }
	.model-slot .placeholder svg {
		width: 28px;
		height: 28px;
		opacity: 0.6;
	}
</style>